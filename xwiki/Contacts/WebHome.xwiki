{{velocity}}
## ============================================================
## CONTACTS XWIKI — page uniquement
## ============================================================
## Extensions à attacher :
##   StyleSheet Extension : Contacts - Base
##   StyleSheet Extension : Contacts - Cards
##   StyleSheet Extension : Contacts - Manager
##   JavaScript Extension : Contacts - View
##   JavaScript Extension : Contacts - Manager
## ============================================================

#set ($showcomments = false)
#set ($showannotations = false)
#set ($showattachments = false)
#set ($showhistory = false)
#set ($showinformation = false)
#set ($displayDocExtra = false)

## ------------------------------------------------------------
## CONFIGURATION
## XWikiAllGroup est toujours masqué.
## INVITE est masqué si le membre possède un autre groupe ;
## s'il est son seul groupe utile, INVITE reste affiché.
## ------------------------------------------------------------
#set ($formationPageRef = 'Formation.WebHome')
#set ($rolePageRef = 'Roles.WebHome')
#set ($followupPageRef = 'Suivis.WebHome')

## ------------------------------------------------------------
## MEMBRES DU WIKI
## Source de vérité : les groupes du wiki, pas l'utilisateur courant.
## - récupère tous les documents contenant XWiki.XWikiGroups ;
## - récupère tous les membres de chaque groupe ;
## - résout aussi les sous-groupes ;
## - ne conserve que les vraies pages XWiki.XWikiUsers ;
## - déduplique les personnes.
## ------------------------------------------------------------
#set ($allGroupRefs = $services.query.xwql('from doc.object("XWiki.XWikiGroups") as membership order by doc.fullName').addFilter('unique').execute())
#set ($visibleUserRefs = [])
#set ($currentUserRef = $services.model.serialize($xcontext.userReference, 'default'))

#foreach ($groupRef in $allGroupRefs)
  #set ($groupMembers = $services.user.group.getMembers($groupRef))
  #foreach ($memberReference in $groupMembers)
    #set ($memberDoc = $xwiki.getDocument($memberReference))
    #if ($memberDoc.getObject('XWiki.XWikiUsers'))
      #set ($memberRef = $services.model.serialize($memberDoc.documentReference, 'default'))
      #if ($memberRef != $currentUserRef && !$visibleUserRefs.contains($memberRef))
        #set ($discard = $visibleUserRefs.add($memberRef))
      #end
    #end
  #end
#end

## ------------------------------------------------------------
## STOCKAGE DES CONTACTS
## Une page cachée par utilisateur dans Contacts.Data.
## ------------------------------------------------------------
#set ($currentUserKey = $xcontext.user.replace(':', '_').replace('.', '_'))
#set ($contactsDataRef = "Contacts.Data.${currentUserKey}")
#set ($contactsDataDoc = $xwiki.getDocument($contactsDataRef))
#set ($savedContacts = [])
#set ($saveStatus = '')
#set ($saveMessage = '')

#if (!$isGuest)
  #set ($rawContacts = "$!contactsDataDoc.content")
  #if ($rawContacts.trim() != '')
    #foreach ($rawLine in $rawContacts.split('\n'))
      #set ($candidate = $rawLine.trim())
      #if ($candidate != '' && $visibleUserRefs.contains($candidate) && !$savedContacts.contains($candidate))
        #set ($discard = $savedContacts.add($candidate))
      #end
    #end
  #end

  #if ("$!request.getMethod()" == 'POST' && "$!request.getParameter('contactsAction')" == 'save-contacts')
    #if (!$services.csrf.isTokenValid("$!request.getParameter('form_token')"))
      #set ($saveStatus = 'error')
      #set ($saveMessage = 'Votre session a expiré. Rechargez la page puis réessayez.')
    #else
      #set ($finalContacts = [])
      #set ($requestedContacts = $request.getParameterValues('contact'))

      #if ($requestedContacts)
        #foreach ($candidate in $requestedContacts)
          #if ($visibleUserRefs.contains($candidate) && !$finalContacts.contains($candidate))
            #set ($discard = $finalContacts.add($candidate))
          #end
        #end
      #end

      #set ($contactContent = '')
      #foreach ($candidate in $finalContacts)
        #set ($contactContent = "${contactContent}${candidate}\n")
      #end

      #set ($discard = $contactsDataDoc.setTitle("Contacts de ${xcontext.user}"))
      #set ($discard = $contactsDataDoc.setHidden(true))
      #set ($discard = $contactsDataDoc.setContent($contactContent))
      #set ($discard = $contactsDataDoc.save('Mise à jour de la liste de contacts'))

      #set ($savedContacts = $finalContacts)
      #set ($saveStatus = 'success')
      #set ($saveMessage = 'Votre liste de contacts a été mise à jour.')
    #end
  #end
#end

## ------------------------------------------------------------
## HELPERS D'AFFICHAGE
## ------------------------------------------------------------
#macro (ctUserName $userRef)
  #set ($userDoc = $xwiki.getDocument($userRef))
  #set ($userObject = $userDoc.getObject('XWiki.XWikiUsers'))
  #set ($firstName = '')
  #set ($lastName = '')
  #if ($userObject)
    #set ($firstName = "$!userObject.get('first_name')".trim())
    #set ($lastName = "$!userObject.get('last_name')".trim())
  #end
  #set ($fullName = "${firstName} ${lastName}".trim())
  #if ($fullName == '')
    #set ($fullName = $userDoc.name)
  #end
  $escapetool.xml($fullName)
#end

#macro (ctGroupChips $userRef)
  ## Tous les groupes du membre, sur tous les wikis, dédupliqués.
  ## XWikiAllGroup : jamais affiché.
  ## INVITE : affiché uniquement s'il n'existe aucun autre groupe utile.
  #set ($allGroups = $services.user.group.getGroupsFromAllWikis($userRef))
  #set ($displayGroups = [])
  #set ($hasInvite = false)

  #foreach ($groupRef in $allGroups)
    #set ($groupName = "$!groupRef.name")
    #if ($groupName == 'INVITE')
      #set ($hasInvite = true)
    #elseif ($groupName != '' && $groupName != 'XWikiAllGroup' && !$displayGroups.contains($groupName))
      #set ($discard = $displayGroups.add($groupName))
    #end
  #end

  #if ($displayGroups.isEmpty() && $hasInvite)
    <span class="ct-group-chip ct-group-chip--neutral">INVITE</span>
  #elseif ($displayGroups.isEmpty())
    <span class="ct-group-chip ct-group-chip--neutral">Sans groupe</span>
  #else
    #foreach ($groupName in $displayGroups)
      <span class="ct-group-chip">$escapetool.xml($groupName)</span>
    #end
  #end
#end

#if ($isGuest)
{{html clean="false"}}
<div class="contacts-page">
  <div class="ct-shell">
    <section class="ct-guest-panel">
      <span class="ct-eyebrow">Contacts</span>
      <h1>Connectez-vous pour accéder à vos contacts</h1>
      <p>La liste de contacts est personnelle et nécessite un compte XWiki authentifié.</p>
      <a class="ct-primary-button" href="$escapetool.xml($xwiki.getURL('XWiki.XWikiLogin', 'login'))">Se connecter</a>
    </section>
  </div>
</div>
{{/html}}
#else
{{html clean="false"}}
<div class="contacts-page"
     data-save-status="$escapetool.xml($!saveStatus)"
     data-save-message="$escapetool.xml($!saveMessage)">
  <div class="ct-shell">
    <header class="ct-header">
      <div>
        <span class="ct-eyebrow">Votre réseau interne</span>
        <h1 class="ct-title">Mes contacts</h1>
        <p class="ct-subtitle">Retrouvez les personnes avec lesquelles vous travaillez et accédez rapidement à leurs informations, formations, rôles et suivis.</p>
      </div>
    </header>

    <div class="ct-tabs" role="tablist" aria-label="Contacts">
      <button class="ct-tab is-active" type="button" role="tab" aria-selected="true" aria-controls="ct-panel-contacts" data-contacts-tab="contacts">Mes contacts</button>
      <button class="ct-tab" type="button" role="tab" aria-selected="false" aria-controls="ct-panel-manage" data-contacts-tab="manage">Gérer mes contacts</button>
    </div>

    <!-- ONGLET 1 — MES CONTACTS -->
    <section id="ct-panel-contacts" class="ct-tab-panel" role="tabpanel" data-contacts-panel="contacts">
      <div class="ct-toolbar">
        <label class="ct-search">
          <span class="ct-search-icon" aria-hidden="true">⌕</span>
          <span class="sr-only">Rechercher un contact</span>
          <input type="search" placeholder="Rechercher un contact…" autocomplete="off" data-contact-search />
        </label>

        <div class="ct-layout-switch" aria-label="Disposition des contacts">
          <button type="button" class="ct-layout-button is-active" data-contact-layout="horizontal" aria-pressed="true" title="Vue horizontale"><span aria-hidden="true">☰</span><span>Liste</span></button>
          <button type="button" class="ct-layout-button" data-contact-layout="vertical" aria-pressed="false" title="Vue verticale"><span aria-hidden="true">▦</span><span>Cartes</span></button>
        </div>
      </div>

      <div class="ct-contact-collection is-horizontal" data-contact-collection>
        #if ($savedContacts.isEmpty())
          <div class="ct-empty-contact-state" data-contact-empty>
            <div class="ct-empty-icon" aria-hidden="true">◎</div>
            <h2>Votre liste est vide</h2>
            <p>Ajoutez vos premiers contacts depuis l’onglet « Gérer mes contacts ».</p>
            <button type="button" class="ct-primary-button" data-open-manager>Ajouter des contacts</button>
          </div>
        #else
          #foreach ($contactRef in $savedContacts)
            #set ($encodedContact = $escapetool.url($contactRef))
            #set ($profileUrl = $xwiki.getURL($contactRef, 'view'))
            #set ($formationUrl = $xwiki.getURL($formationPageRef, 'view', "contact=${encodedContact}"))
            #set ($roleUrl = $xwiki.getURL($rolePageRef, 'view', "contact=${encodedContact}"))
            #set ($followupUrl = $xwiki.getURL($followupPageRef, 'view', "contact=${encodedContact}"))
            <article class="ct-contact-card" data-contact-card data-search-text="#ctUserName($contactRef) $escapetool.xml($contactRef)">
              <div class="ct-avatar ct-avatar--large">#resizedUserAvatar($contactRef, 120)</div>
              <div class="ct-contact-main">
                <span class="ct-contact-ref">$escapetool.xml($contactRef)</span>
                <h2 class="ct-contact-name">#ctUserName($contactRef)</h2>
                <div class="ct-groups">#ctGroupChips($contactRef)</div>
              </div>
              <div class="ct-contact-actions">
                <a class="ct-action-button" href="$escapetool.xml($profileUrl)"><span aria-hidden="true">i</span> Informations</a>
                <a class="ct-action-button" href="$escapetool.xml($formationUrl)"><span aria-hidden="true">▤</span> Formation</a>
                <a class="ct-action-button" href="$escapetool.xml($roleUrl)"><span aria-hidden="true">◇</span> Rôle</a>
                <a class="ct-action-button" href="$escapetool.xml($followupUrl)"><span aria-hidden="true">✓</span> Suivis</a>
              </div>
            </article>
          #end
        #end
      </div>

      <div class="ct-no-search-result" hidden data-no-contact-result>Aucun contact ne correspond à votre recherche.</div>
    </section>

    <!-- ONGLET 2 — GESTION DES CONTACTS -->
    <section id="ct-panel-manage" class="ct-tab-panel" role="tabpanel" hidden data-contacts-panel="manage">
      <form method="post" action="" data-contact-manager-form>
        <input type="hidden" name="contactsAction" value="save-contacts" />
        <input type="hidden" name="form_token" value="$escapetool.xml($services.csrf.getToken())" />
        <div data-final-contacts-inputs></div>

        <div class="ct-manager-head">
          <div>
            <span class="ct-manager-kicker">Modification temporaire</span>
            <h2>Organiser mes contacts</h2>
            <p>Les changements restent locaux tant que vous n’avez pas cliqué sur « Valider ».</p>
          </div>
          <label class="ct-search ct-search--manager">
            <span class="ct-search-icon" aria-hidden="true">⌕</span>
            <span class="sr-only">Rechercher un membre</span>
            <input type="search" placeholder="Rechercher dans les listes…" autocomplete="off" data-manager-search />
          </label>
        </div>

        <div class="ct-manager-grid">
          <section class="ct-manager-panel ct-manager-panel--members">
            <header class="ct-manager-panel-head"><h3>Liste des membres</h3></header>
            <p class="ct-manager-help">Tous les membres du wiki qui ne font pas partie de vos contacts.</p>
            <div class="ct-manager-list" data-contact-zone="available">
              #foreach ($memberRef in $visibleUserRefs)
                #if (!$savedContacts.contains($memberRef))
                  <article class="ct-member-card" data-member-card data-contact-ref="$escapetool.xml($memberRef)" data-initial-contact="false" data-search-text="#ctUserName($memberRef) $escapetool.xml($memberRef)">
                    <div class="ct-avatar ct-avatar--small">#resizedUserAvatar($memberRef, 56)</div>
                    <div class="ct-member-copy"><strong>#ctUserName($memberRef)</strong><div class="ct-groups ct-groups--small">#ctGroupChips($memberRef)</div></div>
                    <button type="button" class="ct-member-action" data-move-contact></button>
                  </article>
                #end
              #end
              <div class="ct-zone-empty" data-zone-empty>Aucun membre dans cette liste.</div>
            </div>
          </section>

          <section class="ct-manager-panel ct-manager-panel--current">
            <header class="ct-manager-panel-head"><h3>Liste de vos contacts</h3></header>
            <p class="ct-manager-help">Les contacts actuellement enregistrés dans votre compte.</p>
            <div class="ct-manager-list" data-contact-zone="current">
              #foreach ($memberRef in $savedContacts)
                <article class="ct-member-card" data-member-card data-contact-ref="$escapetool.xml($memberRef)" data-initial-contact="true" data-search-text="#ctUserName($memberRef) $escapetool.xml($memberRef)">
                  <div class="ct-avatar ct-avatar--small">#resizedUserAvatar($memberRef, 56)</div>
                  <div class="ct-member-copy"><strong>#ctUserName($memberRef)</strong><div class="ct-groups ct-groups--small">#ctGroupChips($memberRef)</div></div>
                  <button type="button" class="ct-member-action" data-move-contact></button>
                </article>
              #end
              <div class="ct-zone-empty" data-zone-empty>Aucun contact enregistré.</div>
            </div>
          </section>

          <section class="ct-manager-panel ct-manager-panel--pending ct-manager-panel--add">
            <header class="ct-manager-panel-head"><h3>Contacts que vous allez ajouter</h3></header>
            <p class="ct-manager-help">Ces personnes seront ajoutées uniquement après validation.</p>
            <div class="ct-manager-list" data-contact-zone="pending-add"><div class="ct-zone-empty" data-zone-empty>Aucun ajout en attente.</div></div>
          </section>

          <section class="ct-manager-panel ct-manager-panel--pending ct-manager-panel--remove">
            <header class="ct-manager-panel-head"><h3>Contacts que vous allez supprimer</h3></header>
            <p class="ct-manager-help">Vous pouvez restaurer un contact avant de valider.</p>
            <div class="ct-manager-list" data-contact-zone="pending-remove"><div class="ct-zone-empty" data-zone-empty>Aucune suppression en attente.</div></div>
          </section>
        </div>

        <div class="ct-manager-footer">
          <div class="ct-manager-actions">
            <button type="button" class="ct-secondary-button" data-cancel-contact-changes>Annuler</button>
            <button type="submit" class="ct-primary-button" data-save-contacts disabled>Valider</button>
          </div>
        </div>
      </form>
    </section>
  </div>
  <div class="ct-toast" role="status" aria-live="polite" data-contacts-toast></div>
</div>
{{/html}}
#end
{{/velocity}}
