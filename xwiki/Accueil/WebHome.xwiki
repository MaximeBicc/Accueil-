{{velocity}}
## ============================================================
## ACCUEIL XWIKI — page uniquement
## ============================================================
## Extensions à attacher à cette page :
##   StyleSheet Extension : Accueil - Base
##   StyleSheet Extension : Accueil - Modules
##   StyleSheet Extension : Accueil - Branding
##   StyleSheet Extension : Accueil - Panneaux & Contact
##   StyleSheet Extension : Accueil - Flux
##   JavaScript Extension : Accueil - Modules
##   JavaScript Extension : Accueil - Contact
##   JavaScript Extension : Accueil - Flux
##
## Règle : aucun CSS et aucun JavaScript métier dans WebHome.xwiki.
## ============================================================

#set ($showcomments = false)
#set ($showannotations = false)
#set ($showattachments = false)
#set ($showhistory = false)
#set ($showinformation = false)
#set ($displayDocExtra = false)

## ============================================================
## CONFIGURATION
## ============================================================
#set ($documentationRootSpace = 'Documentation')
#set ($formationRootSpace = 'Formation')
#set ($documentationRootPage = "${documentationRootSpace}.WebHome")
#set ($formationRootPage = "${formationRootSpace}.WebHome")
#set ($documentationSpaceLike = "${documentationRootSpace}.%")
#set ($formationSpaceLike = "${formationRootSpace}.%")

## Logo NAVAL GROUP.
## L'image doit être jointe à CETTE page sous ce nom exact.
#set ($navalLogoAttachmentName = 'naval-group-logo.png')
#set ($navalLogoAttachment = $doc.getAttachment($navalLogoAttachmentName))
#set ($navalLogoUrl = '')
#if ($navalLogoAttachment)
  #set ($navalLogoUrl = $doc.getAttachmentURL($navalLogoAttachmentName))
#end

## ============================================================
## DOCUMENTATION
## ============================================================
## Définition d'une documentation :
## - descendante de la racine Documentation ;
## - la racine elle-même est exclue ;
## - possède un XWiki Object avec une propriété String `type=document`.

#set ($documentationCount = 0)
#set ($documentationCountQuery = $services.query.hql("select count(distinct doc.fullName) from XWikiDocument doc, BaseObject obj, StringProperty typeProp where doc.fullName = obj.name and obj.id = typeProp.id.id and typeProp.id.name = :typePropertyName and typeProp.value = :documentTypeValue and ((doc.space = :rootSpace) or (doc.space like :rootSpaceLike)) and doc.fullName <> :rootPage and doc.language = ''"))
#set ($discard = $documentationCountQuery.bindValue('typePropertyName', 'type'))
#set ($discard = $documentationCountQuery.bindValue('documentTypeValue', 'document'))
#set ($discard = $documentationCountQuery.bindValue('rootSpace', $documentationRootSpace))
#set ($discard = $documentationCountQuery.bindValue('rootSpaceLike', $documentationSpaceLike))
#set ($discard = $documentationCountQuery.bindValue('rootPage', $documentationRootPage))
#set ($documentationCountResult = $documentationCountQuery.execute())
#foreach ($documentationCountValue in $documentationCountResult)
  #set ($documentationCount = $documentationCountValue)
#end

## Liste des pages réellement considérées comme documents.
#set ($documentationNameQuery = $services.query.hql("select distinct doc.fullName from XWikiDocument doc, BaseObject obj, StringProperty typeProp where doc.fullName = obj.name and obj.id = typeProp.id.id and typeProp.id.name = :typePropertyName and typeProp.value = :documentTypeValue and ((doc.space = :rootSpace) or (doc.space like :rootSpaceLike)) and doc.fullName <> :rootPage and doc.language = ''"))
#set ($discard = $documentationNameQuery.bindValue('typePropertyName', 'type'))
#set ($discard = $documentationNameQuery.bindValue('documentTypeValue', 'document'))
#set ($discard = $documentationNameQuery.bindValue('rootSpace', $documentationRootSpace))
#set ($discard = $documentationNameQuery.bindValue('rootSpaceLike', $documentationSpaceLike))
#set ($discard = $documentationNameQuery.bindValue('rootPage', $documentationRootPage))
#set ($documentationDocumentNames = $documentationNameQuery.execute())

## ============================================================
## FORMATION — LOGIQUE CONSERVÉE
## ============================================================
#set ($formationQuery = $services.query.xwql("where ((doc.space = :rootSpace) or (doc.space like :rootSpaceLike)) and doc.fullName <> :rootPage and doc.language = ''"))
#set ($discard = $formationQuery.bindValue('rootSpace', $formationRootSpace))
#set ($discard = $formationQuery.bindValue('rootSpaceLike', $formationSpaceLike))
#set ($discard = $formationQuery.bindValue('rootPage', $formationRootPage))
#set ($formationCount = $formationQuery.count())

## ============================================================
## À LA UNE — 5 DERNIERS DOCUMENTS CRÉÉS
## ============================================================
#set ($latestDocumentQuery = $services.query.hql("select doc.fullName from XWikiDocument doc, BaseObject obj, StringProperty typeProp where doc.fullName = obj.name and obj.id = typeProp.id.id and typeProp.id.name = :typePropertyName and typeProp.value = :documentTypeValue and ((doc.space = :rootSpace) or (doc.space like :rootSpaceLike)) and doc.fullName <> :rootPage and doc.language = '' group by doc.fullName, doc.creationDate order by doc.creationDate desc"))
#set ($discard = $latestDocumentQuery.bindValue('typePropertyName', 'type'))
#set ($discard = $latestDocumentQuery.bindValue('documentTypeValue', 'document'))
#set ($discard = $latestDocumentQuery.bindValue('rootSpace', $documentationRootSpace))
#set ($discard = $latestDocumentQuery.bindValue('rootSpaceLike', $documentationSpaceLike))
#set ($discard = $latestDocumentQuery.bindValue('rootPage', $documentationRootPage))
#set ($latestDocumentNames = $latestDocumentQuery.setLimit(5).execute())

## ============================================================
## STATISTIQUES DE CONSULTATION
## ============================================================
#set ($statsEnabled = false)
#if ($xwiki.statsService)
  #set ($statsEnabled = $xwiki.statsService.enabledForCurrentWiki)
#end

#set ($mostViewedStats = [])
#set ($recentActionNames = [])
#if ($statsEnabled)
  #set ($statsPeriod = $xwiki.criteriaService.periodFactory.createSinceDaysPeriod(30))
  #set ($statsScope = $xwiki.criteriaService.scopeFactory.ALL_PAGES)
  #set ($statsRange = $xwiki.criteriaService.rangeFactory.createHeadRange(250))
  #set ($mostViewedStats = $xwiki.statsService.getDocumentStatistics('view', $statsScope, $statsPeriod, $statsRange))
  #set ($recentActionNames = $xwiki.getRecentActions('view', 100))
#end

## ============================================================
## CONTACT ADMINISTRATEUR
## ============================================================
#set ($adminEmail = $xwiki.getXWikiPreference('admin_email'))
#set ($contactStatus = '')
#set ($contactMessage = '')

#if ("$!request.getMethod()" == 'POST' && "$!request.getParameter('homeAction')" == 'contact-admin')
  #if (!$services.csrf.isTokenValid("$!request.getParameter('form_token')"))
    #set ($contactStatus = 'error')
    #set ($contactMessage = 'Votre session a expiré. Rechargez la page puis réessayez.')
  #elseif ("$!adminEmail" == '')
    #set ($contactStatus = 'error')
    #set ($contactMessage = "Aucune adresse administrateur n'est configurée dans XWiki.")
  #else
    #set ($senderName = "$!request.getParameter('senderName')")
    #set ($senderEmail = "$!request.getParameter('senderEmail')")
    #set ($userMessage = "$!request.getParameter('message')")

    #if ("$senderName" == '' || "$userMessage" == '')
      #set ($contactStatus = 'error')
      #set ($contactMessage = 'Le nom et le message sont obligatoires.')
    #else
      #set ($mailSubject = "[Wiki] Message depuis la page d'accueil")
      #set ($mailBody = "Message envoyé depuis la page d'accueil du wiki.\n\nNom : ${senderName}\nEmail : ${senderEmail}\nUtilisateur XWiki : ${xcontext.user}\n\nMessage :\n${userMessage}")
      #set ($mail = $services.mail.sender.createMessage($adminEmail, $mailSubject))
      #set ($discard = $mail.addPart('text/plain; charset=UTF-8', $mailBody))
      #set ($mailResult = $services.mail.sender.send($mail))
      #set ($contactStatus = 'success')
      #set ($contactMessage = "Votre message a été transmis à l'administrateur.")
    #end
  #end
#end

{{html clean="false"}}
<div class="naval-home"
     data-contact-status="$escapetool.xml($!contactStatus)"
     data-contact-message="$escapetool.xml($!contactMessage)">

  <div class="nh-shell">
    <header class="nh-header">
      <span class="nh-eyebrow">Portail interne</span>
      <h1 class="nh-title">Bienvenue sur votre espace de connaissance</h1>
      <p class="nh-subtitle">Accédez rapidement aux modules du wiki, aux ressources essentielles et aux informations utiles depuis un point d’entrée unique.</p>
    </header>

    <div class="nh-module-source" aria-hidden="true">
      <div data-home-module data-label="Documentation" data-icon="D" data-title="Documentation" data-description="Retrouvez les procédures, les guides de référence et les connaissances partagées de votre organisation." data-url="$escapetool.xml($xwiki.getURL('Documentation.WebHome', 'view'))">
        <span data-module-point>Procédures et modes opératoires</span>
        <span data-module-point>Référentiels techniques</span>
        <span data-module-point>Guides et bonnes pratiques</span>
      </div>
      <div data-home-module data-label="Formation" data-icon="F" data-title="Formation" data-description="Centralisez les parcours de formation, supports pédagogiques et ressources destinées à la montée en compétence." data-url="$escapetool.xml($xwiki.getURL('Formation.WebHome', 'view'))">
        <span data-module-point>Parcours par métier</span>
        <span data-module-point>Supports de cours</span>
        <span data-module-point>Ressources et exercices</span>
      </div>
      <div data-home-module data-label="Projets" data-icon="P" data-title="Projets" data-description="Suivez les espaces projets, les décisions, les livrables et les informations nécessaires au travail collectif." data-url="$escapetool.xml($xwiki.getURL('Projets.WebHome', 'view'))">
        <span data-module-point>Espaces projets</span>
        <span data-module-point>Décisions et comptes-rendus</span>
        <span data-module-point>Suivi des livrables</span>
      </div>
      <div data-home-module data-label="Équipe" data-icon="E" data-title="Équipe" data-description="Retrouvez les informations d’équipe, les rôles, les contacts et les ressources communes." data-url="$escapetool.xml($xwiki.getURL('Equipe.WebHome', 'view'))">
        <span data-module-point>Annuaire interne</span>
        <span data-module-point>Rôles et responsabilités</span>
        <span data-module-point>Informations partagées</span>
      </div>
      <div data-home-module data-label="Outils" data-icon="O" data-title="Outils" data-description="Accédez aux outils et services utiles au quotidien depuis un catalogue centralisé." data-url="$escapetool.xml($xwiki.getURL('Outils.WebHome', 'view'))">
        <span data-module-point>Applications métier</span>
        <span data-module-point>Services internes</span>
        <span data-module-point>Liens et raccourcis</span>
      </div>
      <div data-home-module data-label="Support" data-icon="S" data-title="Support" data-description="Trouvez les réponses aux problèmes courants et les différents moyens de demander de l’aide." data-url="$escapetool.xml($xwiki.getURL('Support.WebHome', 'view'))">
        <span data-module-point>Questions fréquentes</span>
        <span data-module-point>Incidents connus</span>
        <span data-module-point>Canaux de support</span>
      </div>
    </div>

    <section class="nh-hero" aria-label="Modules du wiki">
      <div class="nh-orbit-stage">
        <div class="nh-orbit" data-module-orbit>
          <div class="nh-hub" aria-label="Naval Group">
            #if ("$navalLogoUrl" != '')
              <img class="nh-hub-logo-image" src="$escapetool.xml($navalLogoUrl)" alt="Naval Group" />
            #else
              <span class="nh-hub-logo-missing">Logo<br/>non trouvé</span>
            #end
          </div>
          <div data-module-nodes></div>
        </div>
      </div>

      <article class="nh-detail" aria-live="polite">
        <div class="nh-detail-content" data-module-detail>
          <span class="nh-detail-index" data-detail-index>Module 01</span>
          <h2 class="nh-detail-title" data-detail-title>Documentation</h2>
          <p class="nh-detail-description" data-detail-description>Retrouvez les procédures, guides et références du wiki.</p>
          <ul class="nh-detail-points" data-detail-points></ul>
          <a class="nh-detail-link" data-detail-link href="#">Ouvrir le module <span aria-hidden="true">→</span></a>
        </div>
      </article>
    </section>

    <section class="nh-cards" aria-label="Informations principales">
      <article class="nh-card nh-feed-card">
        <div class="nh-card-heading">
          <div class="nh-card-heading-main">
            <div class="nh-card-icon" aria-hidden="true">◎</div>
            <div>
              <h3>À la une</h3>
              <span class="nh-card-kicker">Les documents à suivre en priorité</span>
            </div>
          </div>
        </div>

        <div class="nh-feed-tabs" role="tablist" aria-label="À la une">
          <button class="nh-feed-tab is-active" type="button" role="tab" aria-selected="true" data-feed-tab="latest">Derniers créés</button>
          <button class="nh-feed-tab" type="button" role="tab" aria-selected="false" data-feed-tab="popular">Plus vus · 30 jours</button>
        </div>

        <div class="nh-feed-panel" data-feed-panel="latest" role="tabpanel">
          #if ($latestDocumentNames && !$latestDocumentNames.isEmpty())
            <ol class="nh-doc-list">
              #foreach ($latestDocumentName in $latestDocumentNames)
                #set ($latestDocument = $xwiki.getDocument($latestDocumentName).getTranslatedDocument())
                #set ($latestTitle = "$!latestDocument.plainTitle")
                #if ("$latestTitle" == '')
                  #set ($latestTitle = "$!latestDocument.name")
                #end
                <li class="nh-doc-item">
                  <a class="nh-doc-link" href="$escapetool.xml($latestDocument.getURL('view'))">
                    <span class="nh-doc-symbol" aria-hidden="true">D</span>
                    <span class="nh-doc-copy">
                      <span class="nh-doc-title">$escapetool.xml($latestTitle)</span>
                      <span class="nh-doc-meta">Créé le $escapetool.xml($datetool.format('dd/MM/yyyy', $latestDocument.creationDate))</span>
                    </span>
                    <span class="nh-doc-value">Nouveau</span>
                  </a>
                </li>
              #end
            </ol>
          #else
            <div class="nh-feed-empty">Aucun document n’a encore été créé dans ce dossier.</div>
          #end
        </div>

        <div class="nh-feed-panel" data-feed-panel="popular" role="tabpanel" hidden>
          #if (!$statsEnabled)
            <div class="nh-feed-disabled"><span><strong>Statistiques de consultation désactivées</strong>Activez les statistiques dans les préférences du sous-wiki pour afficher les documents les plus vus sur les 30 derniers jours.</span></div>
          #else
            #set ($popularShown = 0)
            <ol class="nh-doc-list">
              #foreach ($viewStat in $mostViewedStats)
                #if ($popularShown < 5 && $documentationDocumentNames.contains($viewStat.name))
                  #set ($popularDocument = $xwiki.getDocument($viewStat.name).getTranslatedDocument())
                  #set ($popularTitle = "$!popularDocument.plainTitle")
                  #if ("$popularTitle" == '')
                    #set ($popularTitle = "$!popularDocument.name")
                  #end
                  <li class="nh-doc-item">
                    <a class="nh-doc-link" href="$escapetool.xml($popularDocument.getURL('view'))">
                      <span class="nh-doc-symbol" aria-hidden="true">D</span>
                      <span class="nh-doc-copy">
                        <span class="nh-doc-title">$escapetool.xml($popularTitle)</span>
                        <span class="nh-doc-meta">Consultations sur les 30 derniers jours</span>
                      </span>
                      <span class="nh-doc-value">$escapetool.xml($viewStat.pageViews) vues</span>
                    </a>
                  </li>
                  #set ($popularShown = $popularShown + 1)
                #end
              #end
            </ol>
            #if ($popularShown == 0)
              <div class="nh-feed-empty">Aucune statistique de consultation disponible.</div>
            #end
          #end
        </div>
      </article>

      <article class="nh-card nh-recent-card">
        <div class="nh-card-heading">
          <div class="nh-card-heading-main">
            <div class="nh-card-icon" aria-hidden="true">↗</div>
            <div>
              <h3>Accès rapides</h3>
              <span class="nh-card-kicker">Vos 10 derniers documents ouverts</span>
            </div>
          </div>
        </div>

        #if (!$statsEnabled)
          <div class="nh-feed-disabled"><span><strong>Historique de consultation indisponible</strong>Activez les statistiques dans les préférences du sous-wiki.</span></div>
        #elseif ($isGuest)
          <div class="nh-feed-empty">Connectez-vous pour retrouver vos derniers documents ouverts.</div>
        #else
          #set ($recentShown = 0)
          #set ($recentSeen = [])
          <ol class="nh-doc-list">
            #foreach ($recentName in $recentActionNames)
              #if ($recentShown < 10 && !$recentSeen.contains("$recentName") && $documentationDocumentNames.contains("$recentName"))
                #set ($recentDocument = $xwiki.getDocument($recentName).getTranslatedDocument())
                #set ($recentTitle = "$!recentDocument.plainTitle")
                #if ("$recentTitle" == '')
                  #set ($recentTitle = "$!recentDocument.name")
                #end
                <li class="nh-doc-item">
                  <a class="nh-doc-link" href="$escapetool.xml($recentDocument.getURL('view'))">
                    <span class="nh-doc-symbol" aria-hidden="true">$math.add($recentShown, 1)</span>
                    <span class="nh-doc-copy">
                      <span class="nh-doc-title">$escapetool.xml($recentTitle)</span>
                      <span class="nh-doc-meta">$escapetool.xml($recentDocument.space)</span>
                    </span>
                  </a>
                </li>
                #set ($discard = $recentSeen.add("$recentName"))
                #set ($recentShown = $recentShown + 1)
              #end
            #end
          </ol>
          #if ($recentShown == 0)
            <div class="nh-feed-empty">Aucun document récemment ouvert pour le moment.</div>
          #end
        #end

        <span class="nh-stats-chip #if($statsEnabled)is-enabled#else is-disabled#end">#if($statsEnabled)Historique actif#else Historique inactif#end</span>
      </article>

      <article class="nh-card nh-info-card">
        <div class="nh-card-heading">
          <div class="nh-card-heading-main">
            <div class="nh-card-icon" aria-hidden="true">◌</div>
            <div>
              <h3>Informations utiles</h3>
              <span class="nh-card-kicker">Repères du portail</span>
            </div>
          </div>
        </div>
        <div class="nh-info-stack">
          <div class="nh-info-row"><strong>Documentation</strong><span>$escapetool.xml($documentationCount) documents disponibles.</span></div>
          <div class="nh-info-row"><strong>Formation</strong><span>$escapetool.xml($formationCount) éléments de formation disponibles.</span></div>
          <div class="nh-info-row"><strong>Besoin d’aide ?</strong><span>Utilisez le contact administrateur en bas de page.</span></div>
        </div>
      </article>
    </section>

    <section class="nh-bottom" aria-label="Ressources du wiki">
      <div class="nh-stat">
        <span class="nh-stat-orb" aria-hidden="true">D</span>
        <div><strong>$escapetool.xml($documentationCount)</strong><span>Documentations</span></div>
      </div>
      <div class="nh-stat">
        <span class="nh-stat-orb" aria-hidden="true">F</span>
        <div><strong>$escapetool.xml($formationCount)</strong><span>Formations</span></div>
      </div>
      <div class="nh-admin">
        <div class="nh-admin-copy"><strong>Contacter l’administrateur</strong><span>Une question, un problème ou une demande d’évolution ?</span></div>
        <button class="nh-contact-button" type="button" data-open-contact>Envoyer un message</button>
      </div>
    </section>
  </div>

  <div class="nh-modal-backdrop" data-contact-modal role="dialog" aria-modal="true" aria-labelledby="nh-contact-title" aria-hidden="true">
    <div class="nh-modal">
      <div class="nh-modal-head">
        <div>
          <h2 id="nh-contact-title">Contacter l’administrateur</h2>
          <p>Votre message sera envoyé à l’adresse administrateur configurée dans XWiki.</p>
        </div>
        <button class="nh-modal-close" type="button" aria-label="Fermer" data-close-contact>×</button>
      </div>
      <form class="nh-form" method="post" action="">
        <input type="hidden" name="homeAction" value="contact-admin" />
        <input type="hidden" name="form_token" value="$escapetool.xml($services.csrf.getToken())" />
        <div class="nh-field">
          <label for="nh-sender-name">Nom *</label>
          <input id="nh-sender-name" name="senderName" type="text" maxlength="120" autocomplete="name" required />
        </div>
        <div class="nh-field">
          <label for="nh-sender-email">Email</label>
          <input id="nh-sender-email" name="senderEmail" type="email" maxlength="180" autocomplete="email" />
        </div>
        <div class="nh-field">
          <label for="nh-message">Message *</label>
          <textarea id="nh-message" name="message" maxlength="5000" required></textarea>
        </div>
        <div class="nh-form-actions">
          <button class="nh-button-secondary" type="button" data-close-contact>Annuler</button>
          <button class="nh-button-primary" type="submit">Envoyer</button>
        </div>
      </form>
    </div>
  </div>

  <div class="nh-toast" role="status" aria-live="polite" data-toast></div>
</div>
{{/html}}
{{/velocity}}