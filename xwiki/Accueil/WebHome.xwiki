{{velocity}}
## ============================================================
## ACCUEIL XWIKI — configuration serveur
## ============================================================
#set ($showcomments = false)
#set ($showannotations = false)
#set ($showattachments = false)
#set ($showhistory = false)
#set ($showinformation = false)
#set ($displayDocExtra = false)

## Espaces utilisés pour les compteurs du bandeau inférieur.
#set ($documentationSpace = 'Documentation')
#set ($formationSpace = 'Formation')

## Compteurs dynamiques.
#set ($documentationCount = $services.query.xwql("where doc.space = 'Documentation' or doc.space like 'Documentation.%'").count())
#set ($formationCount = $services.query.xwql("where doc.space = 'Formation' or doc.space like 'Formation.%'").count())

## Adresse administrateur configurée dans XWiki.
#set ($adminEmail = $xwiki.getXWikiPreference('admin_email'))
#set ($contactStatus = '')
#set ($contactMessage = '')

## Traitement sécurisé du formulaire de contact.
#if ("$!request.getMethod()" == 'POST' && "$!request.getParameter('homeAction')" == 'contact-admin')
  #if (!$services.csrf.isTokenValid("$!request.getParameter('form_token')"))
    #set ($contactStatus = 'error')
    #set ($contactMessage = 'Votre session a expiré. Rechargez la page puis réessayez.')
  #elseif ("$!adminEmail" == '')
    #set ($contactStatus = 'error')
    #set ($contactMessage = "Aucune adresse administrateur n'est configurée dans XWiki.")
  #else
    #set ($senderName = "$!request.getParameter('senderName')".trim())
    #set ($senderEmail = "$!request.getParameter('senderEmail')".trim())
    #set ($userMessage = "$!request.getParameter('message')".trim())

    #if ($senderName.length() == 0 || $userMessage.length() == 0)
      #set ($contactStatus = 'error')
      #set ($contactMessage = 'Le nom et le message sont obligatoires.')
    #elseif ($senderName.length() > 120 || $senderEmail.length() > 180 || $userMessage.length() > 5000)
      #set ($contactStatus = 'error')
      #set ($contactMessage = 'Le message dépasse la taille autorisée.')
    #else
      #set ($safeSubjectName = $senderName.replace('\r', ' ').replace('\n', ' '))
      #set ($mailSubject = "[Wiki] Message depuis la page d'accueil — ${safeSubjectName}")
      #set ($mailBody = "Message envoyé depuis la page d'accueil du wiki.\n\nNom : ${senderName}\nEmail : ${senderEmail}\nUtilisateur XWiki : ${xcontext.user}\n\nMessage :\n${userMessage}")
      #set ($mail = $services.mail.sender.createMessage($adminEmail, $mailSubject))
      #set ($discard = $mail.addPart('text/plain; charset=UTF-8', $mailBody))
      #set ($mailResult = $services.mail.sender.send($mail))
      #set ($contactStatus = 'success')
      #set ($contactMessage = "Votre message a été transmis à l'administrateur.")
    #end
  #end
#end

{{html clean="false"}}
<div class="naval-home" data-contact-status="$escapetool.xml($!contactStatus)" data-contact-message="$escapetool.xml($!contactMessage)">
  <style>
    .naval-home {
      --navy-950: #041426;
      --navy-900: #071d35;
      --navy-850: #092746;
      --navy-800: #0b3158;
      --blue-600: #1769b5;
      --blue-500: #2486dc;
      --blue-400: #52a8ef;
      --cyan-300: #87d7ff;
      --white: #f7fbff;
      --muted: #a9bfd5;
      --line: rgba(141, 198, 240, .18);
      --glass: rgba(8, 35, 63, .72);
      color: var(--white);
      margin: -15px -15px 24px;
      padding: clamp(22px, 4vw, 58px);
      min-height: 760px;
      overflow: hidden;
      position: relative;
      isolation: isolate;
      background:
        radial-gradient(circle at 18% 15%, rgba(36, 134, 220, .22), transparent 30%),
        radial-gradient(circle at 82% 0%, rgba(82, 168, 239, .12), transparent 28%),
        linear-gradient(145deg, var(--navy-950), var(--navy-900) 48%, #08213d 100%);
      font-family: Inter, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    }

    .naval-home *, .naval-home *::before, .naval-home *::after { box-sizing: border-box; }
    .naval-home button, .naval-home input, .naval-home textarea { font: inherit; }

    .naval-home::before,
    .naval-home::after {
      content: "";
      position: absolute;
      width: 440px;
      height: 440px;
      border-radius: 999px;
      pointer-events: none;
      filter: blur(2px);
      opacity: .24;
      z-index: -1;
    }
    .naval-home::before { top: 90px; left: -260px; border: 1px solid rgba(82, 168, 239, .45); }
    .naval-home::after { right: -300px; bottom: 120px; border: 1px solid rgba(135, 215, 255, .38); }

    .nh-shell { width: min(1460px, 100%); margin: 0 auto; }

    .nh-eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 9px;
      margin-bottom: 10px;
      color: var(--cyan-300);
      font-size: 12px;
      font-weight: 800;
      letter-spacing: .16em;
      text-transform: uppercase;
    }
    .nh-eyebrow::before {
      content: "";
      width: 24px;
      height: 2px;
      border-radius: 99px;
      background: currentColor;
      box-shadow: 0 0 16px rgba(135, 215, 255, .55);
    }

    .nh-header { margin-bottom: 28px; }
    .nh-title {
      margin: 0;
      max-width: 820px;
      font-size: clamp(28px, 4vw, 50px);
      line-height: 1.04;
      letter-spacing: -.035em;
      font-weight: 780;
    }
    .nh-subtitle {
      max-width: 760px;
      margin: 13px 0 0;
      color: var(--muted);
      font-size: clamp(14px, 1.4vw, 17px);
      line-height: 1.65;
    }

    .nh-hero {
      display: grid;
      grid-template-columns: minmax(390px, .95fr) minmax(420px, 1.05fr);
      gap: clamp(24px, 4vw, 66px);
      align-items: center;
      min-height: 550px;
    }

    .nh-orbit-stage {
      min-height: 530px;
      position: relative;
      display: grid;
      place-items: center;
    }
    .nh-orbit {
      width: min(520px, 100%);
      aspect-ratio: 1;
      position: relative;
      border-radius: 50%;
    }
    .nh-orbit::before,
    .nh-orbit::after {
      content: "";
      position: absolute;
      inset: 11%;
      border-radius: 50%;
      border: 1px solid rgba(135, 215, 255, .14);
      box-shadow: inset 0 0 45px rgba(36, 134, 220, .035);
      pointer-events: none;
    }
    .nh-orbit::after {
      inset: 27%;
      border-style: dashed;
      animation: nh-spin 26s linear infinite;
    }

    .nh-hub {
      position: absolute;
      left: 50%;
      top: 50%;
      transform: translate(-50%, -50%);
      width: 126px;
      aspect-ratio: 1;
      border-radius: 50%;
      display: grid;
      place-items: center;
      text-align: center;
      z-index: 2;
      color: white;
      border: 1px solid rgba(135, 215, 255, .35);
      background:
        radial-gradient(circle at 34% 25%, rgba(82, 168, 239, .30), transparent 32%),
        linear-gradient(145deg, rgba(16, 69, 117, .94), rgba(5, 29, 53, .96));
      box-shadow: 0 20px 50px rgba(0, 0, 0, .24), inset 0 0 34px rgba(82, 168, 239, .10);
    }
    .nh-hub::before {
      content: "";
      position: absolute;
      inset: -10px;
      border-radius: inherit;
      border: 1px solid rgba(82, 168, 239, .16);
      animation: nh-pulse 3.6s ease-in-out infinite;
    }
    .nh-hub-icon { display: block; font-size: 28px; margin-bottom: 2px; }
    .nh-hub-label { display: block; max-width: 82px; font-size: 11px; font-weight: 800; letter-spacing: .10em; text-transform: uppercase; }

    .nh-node {
      --node-size: 86px;
      position: absolute;
      left: 50%;
      top: 50%;
      width: var(--node-size);
      height: var(--node-size);
      border-radius: 50%;
      border: 1px solid rgba(135, 215, 255, .28);
      color: #dceefe;
      cursor: pointer;
      display: grid;
      place-items: center;
      padding: 11px;
      text-align: center;
      z-index: 4;
      background: linear-gradient(145deg, rgba(12, 54, 94, .95), rgba(7, 31, 57, .97));
      box-shadow: 0 14px 34px rgba(0, 0, 0, .20), inset 0 0 24px rgba(82, 168, 239, .06);
      transition: border-color .25s ease, box-shadow .25s ease, background .25s ease, color .25s ease;
      will-change: transform;
    }
    .nh-node::before {
      content: "";
      position: absolute;
      inset: -6px;
      border-radius: inherit;
      border: 1px solid transparent;
      transition: border-color .25s ease, transform .25s ease;
    }
    .nh-node:hover,
    .nh-node:focus-visible {
      outline: none;
      color: white;
      border-color: rgba(135, 215, 255, .72);
      background: linear-gradient(145deg, rgba(23, 105, 181, .98), rgba(8, 49, 86, .98));
      box-shadow: 0 16px 38px rgba(0, 0, 0, .25), 0 0 26px rgba(82, 168, 239, .20);
    }
    .nh-node:hover::before,
    .nh-node:focus-visible::before { border-color: rgba(82, 168, 239, .34); transform: scale(1.04); }
    .nh-node.is-active {
      color: white;
      border-color: rgba(135, 215, 255, .92);
      background: linear-gradient(145deg, #1976c9, #0b467b);
      box-shadow: 0 17px 40px rgba(0, 0, 0, .25), 0 0 30px rgba(36, 134, 220, .34), inset 0 0 20px rgba(255, 255, 255, .05);
    }
    .nh-node-icon { display: block; font-size: 22px; line-height: 1; margin-bottom: 5px; }
    .nh-node-label { display: block; font-size: 10px; line-height: 1.15; font-weight: 760; }

    .nh-detail {
      position: relative;
      min-height: 390px;
      padding: clamp(24px, 4vw, 44px);
      border: 1px solid var(--line);
      border-radius: 28px;
      overflow: hidden;
      background: linear-gradient(145deg, rgba(10, 42, 74, .78), rgba(5, 27, 50, .90));
      box-shadow: 0 24px 65px rgba(0, 0, 0, .18), inset 0 1px 0 rgba(255,255,255,.035);
      backdrop-filter: blur(14px);
    }
    .nh-detail::after {
      content: "";
      position: absolute;
      width: 260px;
      height: 260px;
      border-radius: 50%;
      right: -120px;
      top: -120px;
      background: radial-gradient(circle, rgba(36, 134, 220, .18), transparent 68%);
      pointer-events: none;
    }
    .nh-detail-content { position: relative; z-index: 1; }
    .nh-detail-content.is-changing { animation: nh-detail-in .34s ease both; }
    .nh-detail-index { color: var(--blue-400); font-size: 12px; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; }
    .nh-detail-title { margin: 12px 0 12px; font-size: clamp(27px, 3vw, 40px); letter-spacing: -.03em; line-height: 1.08; }
    .nh-detail-description { max-width: 670px; margin: 0; color: #b7cce0; font-size: 15px; line-height: 1.72; }
    .nh-detail-points { list-style: none; margin: 25px 0 0; padding: 0; display: grid; gap: 11px; }
    .nh-detail-points li { display: flex; align-items: flex-start; gap: 10px; color: #d8e8f7; font-size: 14px; line-height: 1.45; }
    .nh-detail-points li::before { content: ""; width: 7px; height: 7px; margin-top: 7px; flex: 0 0 auto; border-radius: 50%; background: var(--blue-400); box-shadow: 0 0 12px rgba(82, 168, 239, .6); }
    .nh-detail-link {
      display: inline-flex;
      align-items: center;
      gap: 9px;
      margin-top: 27px;
      padding: 11px 17px;
      border-radius: 12px;
      color: white !important;
      text-decoration: none !important;
      font-weight: 760;
      font-size: 13px;
      background: rgba(36, 134, 220, .17);
      border: 1px solid rgba(82, 168, 239, .30);
      transition: transform .2s ease, background .2s ease;
    }
    .nh-detail-link:hover { transform: translateY(-2px); background: rgba(36, 134, 220, .28); }

    .nh-cards {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 16px;
      margin-top: 18px;
    }
    .nh-card {
      min-height: 190px;
      padding: 24px;
      border: 1px solid var(--line);
      border-radius: 20px;
      background: linear-gradient(145deg, rgba(10, 42, 74, .64), rgba(6, 29, 53, .82));
      box-shadow: inset 0 1px 0 rgba(255,255,255,.025);
      transition: transform .22s ease, border-color .22s ease;
    }
    .nh-card:hover { transform: translateY(-4px); border-color: rgba(82, 168, 239, .34); }
    .nh-card-icon { width: 42px; height: 42px; display: grid; place-items: center; border-radius: 50%; font-size: 18px; background: rgba(36, 134, 220, .16); border: 1px solid rgba(82, 168, 239, .20); }
    .nh-card h3 { margin: 17px 0 8px; font-size: 17px; }
    .nh-card p { margin: 0; color: var(--muted); font-size: 13px; line-height: 1.62; }

    .nh-bottom {
      margin-top: 16px;
      padding: 20px;
      display: grid;
      grid-template-columns: 1fr 1fr 1.25fr;
      gap: 12px;
      align-items: stretch;
      border: 1px solid var(--line);
      border-radius: 22px;
      background: rgba(5, 27, 50, .72);
    }
    .nh-stat,
    .nh-admin {
      min-height: 112px;
      border-radius: 16px;
      padding: 18px 20px;
      display: flex;
      align-items: center;
      gap: 15px;
      background: rgba(15, 57, 96, .44);
      border: 1px solid rgba(141, 198, 240, .11);
    }
    .nh-stat-orb { width: 52px; height: 52px; border-radius: 50%; display: grid; place-items: center; flex: 0 0 auto; color: white; font-size: 22px; background: linear-gradient(145deg, rgba(36, 134, 220, .55), rgba(8, 62, 108, .66)); box-shadow: 0 0 22px rgba(36, 134, 220, .14); }
    .nh-stat strong { display: block; font-size: 27px; line-height: 1; letter-spacing: -.03em; }
    .nh-stat span { display: block; margin-top: 6px; color: var(--muted); font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; }
    .nh-admin { justify-content: space-between; }
    .nh-admin-copy strong { display: block; font-size: 15px; }
    .nh-admin-copy span { display: block; margin-top: 5px; color: var(--muted); font-size: 12px; line-height: 1.4; }
    .nh-contact-button {
      border: 1px solid rgba(135, 215, 255, .30);
      border-radius: 12px;
      padding: 10px 14px;
      white-space: nowrap;
      cursor: pointer;
      color: white;
      font-weight: 750;
      font-size: 12px;
      background: linear-gradient(145deg, #1769b5, #0d4a82);
      box-shadow: 0 10px 24px rgba(0,0,0,.16);
      transition: transform .2s ease, filter .2s ease;
    }
    .nh-contact-button:hover { transform: translateY(-2px); filter: brightness(1.08); }

    .nh-modal-backdrop {
      position: fixed;
      inset: 0;
      z-index: 99999;
      display: none;
      place-items: center;
      padding: 20px;
      background: rgba(2, 12, 24, .72);
      backdrop-filter: blur(8px);
    }
    .nh-modal-backdrop.is-open { display: grid; animation: nh-fade .2s ease both; }
    .nh-modal {
      width: min(600px, 100%);
      max-height: min(760px, calc(100vh - 40px));
      overflow: auto;
      border-radius: 24px;
      border: 1px solid rgba(135, 215, 255, .24);
      background: linear-gradient(145deg, #0a2d50, #061b31 72%);
      box-shadow: 0 32px 90px rgba(0,0,0,.44);
      padding: clamp(22px, 4vw, 34px);
      color: var(--white);
    }
    .nh-modal-head { display: flex; justify-content: space-between; gap: 20px; align-items: flex-start; }
    .nh-modal-head h2 { margin: 0; font-size: 25px; letter-spacing: -.025em; }
    .nh-modal-head p { margin: 7px 0 0; color: var(--muted); font-size: 13px; line-height: 1.5; }
    .nh-modal-close { width: 36px; height: 36px; border-radius: 50%; border: 1px solid rgba(135, 215, 255, .18); background: rgba(255,255,255,.04); color: white; cursor: pointer; font-size: 21px; }
    .nh-form { margin-top: 24px; display: grid; gap: 15px; }
    .nh-field { display: grid; gap: 7px; }
    .nh-field label { color: #dceeff; font-size: 12px; font-weight: 760; }
    .nh-field input,
    .nh-field textarea {
      width: 100%;
      border: 1px solid rgba(135, 215, 255, .18);
      border-radius: 12px;
      padding: 11px 12px;
      color: white;
      background: rgba(2, 18, 33, .52);
      outline: none;
      transition: border-color .2s ease, box-shadow .2s ease;
    }
    .nh-field textarea { min-height: 150px; resize: vertical; }
    .nh-field input:focus,
    .nh-field textarea:focus { border-color: rgba(82, 168, 239, .68); box-shadow: 0 0 0 3px rgba(36, 134, 220, .12); }
    .nh-form-actions { display: flex; justify-content: flex-end; gap: 10px; margin-top: 2px; }
    .nh-button-secondary,
    .nh-button-primary { border-radius: 11px; padding: 10px 15px; cursor: pointer; font-weight: 760; font-size: 13px; }
    .nh-button-secondary { color: #d8eafa; border: 1px solid rgba(135, 215, 255, .18); background: transparent; }
    .nh-button-primary { color: white; border: 1px solid rgba(135, 215, 255, .25); background: linear-gradient(145deg, #2486dc, #135f9f); }

    .nh-toast {
      position: fixed;
      right: 22px;
      bottom: 22px;
      z-index: 100000;
      max-width: min(420px, calc(100vw - 44px));
      padding: 13px 16px;
      border-radius: 13px;
      border: 1px solid rgba(135, 215, 255, .24);
      background: #092746;
      color: white;
      box-shadow: 0 18px 50px rgba(0,0,0,.32);
      font-size: 13px;
      line-height: 1.45;
      display: none;
    }
    .nh-toast.is-visible { display: block; animation: nh-toast .3s ease both; }
    .nh-toast.is-error { border-color: rgba(255, 148, 148, .34); }

    @keyframes nh-spin { to { transform: rotate(360deg); } }
    @keyframes nh-pulse { 0%,100% { transform: scale(.96); opacity: .32; } 50% { transform: scale(1.06); opacity: .72; } }
    @keyframes nh-detail-in { from { opacity: .25; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }
    @keyframes nh-fade { from { opacity: 0; } to { opacity: 1; } }
    @keyframes nh-toast { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }

    @media (max-width: 980px) {
      .nh-hero { grid-template-columns: 1fr; }
      .nh-orbit-stage { min-height: 500px; }
      .nh-orbit { width: min(500px, 96vw); }
      .nh-cards { grid-template-columns: 1fr; }
      .nh-bottom { grid-template-columns: 1fr 1fr; }
      .nh-admin { grid-column: 1 / -1; }
    }
    @media (max-width: 620px) {
      .naval-home { margin-left: -10px; margin-right: -10px; padding: 22px 14px 34px; }
      .nh-header { margin-bottom: 8px; }
      .nh-orbit-stage { min-height: 420px; }
      .nh-hub { width: 102px; }
      .nh-node { --node-size: 72px; }
      .nh-node-icon { font-size: 18px; }
      .nh-node-label { font-size: 9px; }
      .nh-detail { min-height: 0; padding: 23px; border-radius: 22px; }
      .nh-bottom { grid-template-columns: 1fr; }
      .nh-admin { grid-column: auto; align-items: flex-start; flex-direction: column; }
      .nh-contact-button { width: 100%; }
    }
    @media (prefers-reduced-motion: reduce) {
      .naval-home *, .naval-home *::before, .naval-home *::after { animation-duration: .001ms !important; animation-iteration-count: 1 !important; scroll-behavior: auto !important; transition-duration: .001ms !important; }
    }
  </style>

  <div class="nh-shell">
    <header class="nh-header">
      <span class="nh-eyebrow">Portail interne</span>
      <h1 class="nh-title">Bienvenue sur votre espace de connaissance</h1>
      <p class="nh-subtitle">Accédez rapidement aux modules du wiki, aux ressources essentielles et aux informations utiles depuis un point d’entrée unique.</p>
    </header>

    <section class="nh-hero" aria-label="Modules du wiki">
      <div class="nh-orbit-stage">
        <div class="nh-orbit" data-module-orbit>
          <div class="nh-hub" aria-hidden="true">
            <span><span class="nh-hub-icon">✦</span><span class="nh-hub-label">Votre Wiki</span></span>
          </div>
          <div data-module-nodes></div>
        </div>
      </div>

      <article class="nh-detail" aria-live="polite">
        <div class="nh-detail-content" data-module-detail>
          <span class="nh-detail-index" data-detail-index>Module 01</span>
          <h2 class="nh-detail-title" data-detail-title>Documentation</h2>
          <p class="nh-detail-description" data-detail-description>Retrouvez les procédures, guides et références du wiki.</p>
          <ul class="nh-detail-points" data-detail-points></ul>
          <a class="nh-detail-link" data-detail-link href="#">Ouvrir le module <span aria-hidden="true">→</span></a>
        </div>
      </article>
    </section>

    <section class="nh-cards" aria-label="Informations principales">
      <article class="nh-card">
        <div class="nh-card-icon" aria-hidden="true">◎</div>
        <h3>À la une</h3>
        <p>Utilisez ce panneau pour faire ressortir une actualité, une échéance importante ou un changement récent dans le wiki.</p>
      </article>
      <article class="nh-card">
        <div class="nh-card-icon" aria-hidden="true">↗</div>
        <h3>Accès rapides</h3>
        <p>Placez ici les liens les plus utilisés par vos équipes : procédures critiques, outils, formulaires ou pages métier.</p>
      </article>
      <article class="nh-card">
        <div class="nh-card-icon" aria-hidden="true">◌</div>
        <h3>Informations utiles</h3>
        <p>Un espace libre pour afficher des contacts, consignes, horaires, statuts de services ou toute autre information transversale.</p>
      </article>
    </section>

    <section class="nh-bottom" aria-label="Ressources du wiki">
      <div class="nh-stat">
        <span class="nh-stat-orb" aria-hidden="true">D</span>
        <div><strong>$escapetool.xml($documentationCount)</strong><span>Documentations</span></div>
      </div>
      <div class="nh-stat">
        <span class="nh-stat-orb" aria-hidden="true">F</span>
        <div><strong>$escapetool.xml($formationCount)</strong><span>Formations</span></div>
      </div>
      <div class="nh-admin">
        <div class="nh-admin-copy"><strong>Contacter l’administrateur</strong><span>Une question, un problème ou une demande d’évolution ?</span></div>
        <button class="nh-contact-button" type="button" data-open-contact>Envoyer un message</button>
      </div>
    </section>
  </div>

  <div class="nh-modal-backdrop" data-contact-modal role="dialog" aria-modal="true" aria-labelledby="nh-contact-title" aria-hidden="true">
    <div class="nh-modal">
      <div class="nh-modal-head">
        <div>
          <h2 id="nh-contact-title">Contacter l’administrateur</h2>
          <p>Votre message sera envoyé à l’adresse administrateur configurée dans XWiki.</p>
        </div>
        <button class="nh-modal-close" type="button" aria-label="Fermer" data-close-contact>×</button>
      </div>
      <form class="nh-form" method="post" action="">
        <input type="hidden" name="homeAction" value="contact-admin" />
        <input type="hidden" name="form_token" value="$escapetool.xml($services.csrf.getToken())" />
        <div class="nh-field">
          <label for="nh-sender-name">Nom *</label>
          <input id="nh-sender-name" name="senderName" type="text" maxlength="120" autocomplete="name" required />
        </div>
        <div class="nh-field">
          <label for="nh-sender-email">Email</label>
          <input id="nh-sender-email" name="senderEmail" type="email" maxlength="180" autocomplete="email" />
        </div>
        <div class="nh-field">
          <label for="nh-message">Message *</label>
          <textarea id="nh-message" name="message" maxlength="5000" required></textarea>
        </div>
        <div class="nh-form-actions">
          <button class="nh-button-secondary" type="button" data-close-contact>Annuler</button>
          <button class="nh-button-primary" type="submit">Envoyer</button>
        </div>
      </form>
    </div>
  </div>

  <div class="nh-toast" role="status" aria-live="polite" data-toast></div>

  <script>
    (function () {
      'use strict';

      /* ========================================================
       * CONFIGURATION DES MODULES
       * Ajoutez/supprimez simplement des objets dans ce tableau.
       * Le placement circulaire se recalcule automatiquement.
       * ======================================================== */
      var modules = [
        {
          label: 'Documentation',
          icon: 'D',
          title: 'Documentation',
          description: 'Retrouvez les procédures, les guides de référence et les connaissances partagées de votre organisation.',
          points: ['Procédures et modes opératoires', 'Référentiels techniques', 'Guides et bonnes pratiques'],
          url: '$xwiki.getURL("Documentation.WebHome", "view")'
        },
        {
          label: 'Formation',
          icon: 'F',
          title: 'Formation',
          description: 'Centralisez les parcours de formation, supports pédagogiques et ressources destinées à la montée en compétence.',
          points: ['Parcours par métier', 'Supports de cours', 'Ressources et exercices'],
          url: '$xwiki.getURL("Formation.WebHome", "view")'
        },
        {
          label: 'Projets',
          icon: 'P',
          title: 'Projets',
          description: 'Suivez les espaces projets, les décisions, les livrables et les informations nécessaires au travail collectif.',
          points: ['Espaces projets', 'Décisions et comptes-rendus', 'Suivi des livrables'],
          url: '$xwiki.getURL("Projets.WebHome", "view")'
        },
        {
          label: 'Équipe',
          icon: 'E',
          title: 'Équipe',
          description: 'Retrouvez les informations d’équipe, les rôles, les contacts et les ressources communes.',
          points: ['Annuaire interne', 'Rôles et responsabilités', 'Informations partagées'],
          url: '$xwiki.getURL("Equipe.WebHome", "view")'
        },
        {
          label: 'Outils',
          icon: 'O',
          title: 'Outils',
          description: 'Accédez aux outils et services utiles au quotidien depuis un catalogue centralisé.',
          points: ['Applications métier', 'Services internes', 'Liens et raccourcis'],
          url: '$xwiki.getURL("Outils.WebHome", "view")'
        },
        {
          label: 'Support',
          icon: 'S',
          title: 'Support',
          description: 'Trouvez les réponses aux problèmes courants et les différents moyens de demander de l’aide.',
          points: ['Questions fréquentes', 'Incidents connus', 'Canaux de support'],
          url: '$xwiki.getURL("Support.WebHome", "view")'
        }
      ];

      var root = document.currentScript.closest('.naval-home');
      if (!root) return;

      var orbit = root.querySelector('[data-module-orbit]');
      var nodesHost = root.querySelector('[data-module-nodes]');
      var detail = root.querySelector('[data-module-detail]');
      var detailIndex = root.querySelector('[data-detail-index]');
      var detailTitle = root.querySelector('[data-detail-title]');
      var detailDescription = root.querySelector('[data-detail-description]');
      var detailPoints = root.querySelector('[data-detail-points]');
      var detailLink = root.querySelector('[data-detail-link]');
      var nodeButtons = [];

      function createNodes() {
        nodesHost.innerHTML = '';
        nodeButtons = modules.map(function (module, index) {
          var button = document.createElement('button');
          button.type = 'button';
          button.className = 'nh-node';
          button.setAttribute('aria-label', 'Afficher ' + module.label);
          button.setAttribute('aria-pressed', index === 0 ? 'true' : 'false');
          button.innerHTML = '<span><span class="nh-node-icon" aria-hidden="true">' + escapeHTML(module.icon) + '</span><span class="nh-node-label">' + escapeHTML(module.label) + '</span></span>';
          button.addEventListener('click', function () { selectModule(index); });
          nodesHost.appendChild(button);
          return button;
        });
        layoutNodes();
        selectModule(0, true);
      }

      function escapeHTML(value) {
        return String(value)
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#039;');
      }

      function layoutNodes() {
        if (!orbit || !nodeButtons.length) return;
        var rect = orbit.getBoundingClientRect();
        var compact = window.matchMedia('(max-width: 620px)').matches;
        var nodeSize = compact ? 72 : 86;
        var hubClearance = compact ? 88 : 106;
        var maxRadius = Math.max(hubClearance, Math.min(rect.width, rect.height) / 2 - nodeSize / 2 - 10);
        var ringGap = compact ? 72 : 82;
        var radii = [];

        for (var radius = hubClearance; radius <= maxRadius + 1; radius += ringGap) {
          radii.push(Math.min(radius, maxRadius));
          if (radius >= maxRadius) break;
        }
        if (!radii.length) radii.push(maxRadius);
        if (radii[radii.length - 1] !== maxRadius && maxRadius - radii[radii.length - 1] > 30) radii.push(maxRadius);

        var capacities = radii.map(function (radius) {
          return Math.max(4, Math.floor((2 * Math.PI * radius) / (nodeSize + 18)));
        });

        var assignments = radii.map(function () { return []; });
        var ringIndex = radii.length - 1;
        nodeButtons.forEach(function (_, index) {
          while (ringIndex > 0 && assignments[ringIndex].length >= capacities[ringIndex]) ringIndex -= 1;
          assignments[ringIndex].push(index);
          if (assignments[ringIndex].length >= capacities[ringIndex] && ringIndex > 0) ringIndex -= 1;
        });

        assignments.forEach(function (indices, currentRing) {
          if (!indices.length) return;
          var radius = radii[currentRing];
          var offset = currentRing % 2 ? -90 : -90 + (180 / indices.length);
          indices.forEach(function (nodeIndex, position) {
            var angle = (offset + (360 / indices.length) * position) * Math.PI / 180;
            var x = Math.cos(angle) * radius;
            var y = Math.sin(angle) * radius;
            var button = nodeButtons[nodeIndex];
            button.style.transform = 'translate(-50%, -50%) translate(' + x.toFixed(2) + 'px, ' + y.toFixed(2) + 'px)';
            button.style.transitionDelay = (nodeIndex * 18) + 'ms';
          });
        });
      }

      function selectModule(index, instant) {
        if (!modules[index]) return;
        var module = modules[index];
        nodeButtons.forEach(function (button, buttonIndex) {
          var active = buttonIndex === index;
          button.classList.toggle('is-active', active);
          button.setAttribute('aria-pressed', active ? 'true' : 'false');
        });

        function render() {
          detailIndex.textContent = 'Module ' + String(index + 1).padStart(2, '0');
          detailTitle.textContent = module.title;
          detailDescription.textContent = module.description;
          detailPoints.innerHTML = '';
          (module.points || []).forEach(function (point) {
            var li = document.createElement('li');
            li.textContent = point;
            detailPoints.appendChild(li);
          });
          detailLink.href = module.url || '#';
          detailLink.style.display = module.url ? 'inline-flex' : 'none';
        }

        if (instant) {
          render();
          return;
        }
        detail.classList.remove('is-changing');
        window.requestAnimationFrame(function () {
          render();
          detail.classList.add('is-changing');
        });
      }

      var resizeTimer;
      window.addEventListener('resize', function () {
        window.clearTimeout(resizeTimer);
        resizeTimer = window.setTimeout(layoutNodes, 100);
      });

      var modal = root.querySelector('[data-contact-modal]');
      var openContact = root.querySelector('[data-open-contact]');
      var closeContacts = root.querySelectorAll('[data-close-contact]');
      var firstField = root.querySelector('#nh-sender-name');
      var lastFocused = null;

      function openModal() {
        lastFocused = document.activeElement;
        modal.classList.add('is-open');
        modal.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
        window.setTimeout(function () { firstField.focus(); }, 0);
      }
      function closeModal() {
        modal.classList.remove('is-open');
        modal.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
        if (lastFocused && typeof lastFocused.focus === 'function') lastFocused.focus();
      }
      openContact.addEventListener('click', openModal);
      closeContacts.forEach(function (button) { button.addEventListener('click', closeModal); });
      modal.addEventListener('click', function (event) { if (event.target === modal) closeModal(); });
      document.addEventListener('keydown', function (event) { if (event.key === 'Escape' && modal.classList.contains('is-open')) closeModal(); });

      var contactStatus = root.getAttribute('data-contact-status');
      var contactMessage = root.getAttribute('data-contact-message');
      var toast = root.querySelector('[data-toast]');
      if (contactStatus && contactMessage) {
        toast.textContent = contactMessage;
        toast.classList.add('is-visible');
        if (contactStatus === 'error') {
          toast.classList.add('is-error');
          openModal();
        }
        window.setTimeout(function () { toast.classList.remove('is-visible'); }, 6000);
      }

      createNodes();
    }());
  </script>
</div>
{{/html}}
{{/velocity}}
