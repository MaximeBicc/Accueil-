#set ($popularDocumentQuery = $services.query.hql("select trackedDocument.value, sum(viewCount.value) from BaseObject trackingObject, StringProperty trackedDocument, DateProperty trackedDay, IntegerProperty viewCount, XWikiDocument doc, BaseObject documentObject, StringProperty typeProp where trackingObject.className = :viewClassName and trackingObject.id = trackedDocument.id.id and trackedDocument.id.name = :trackedDocumentProperty and trackingObject.id = trackedDay.id.id and trackedDay.id.name = :trackedDayProperty and trackingObject.id = viewCount.id.id and viewCount.id.name = :trackedViewsProperty and trackedDay.value >= :cutoffDate and doc.fullName = trackedDocument.value and doc.fullName = documentObject.name and documentObject.id = typeProp.id.id and typeProp.id.name = :typePropertyName and typeProp.value = :documentTypeValue and ((doc.space = :rootSpace) or (doc.space like :rootSpaceLike)) and doc.fullName <> :rootPage and doc.language = '' group by trackedDocument.value order by sum(viewCount.value) desc"))
