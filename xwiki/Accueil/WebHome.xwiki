#set ($discard = $popularDocumentQuery.bindValue('rootSpaceLike', $documentationSpaceLike))
#set ($discard = $popularDocumentQuery.bindValue('rootPage', $documentationRootPage))
#set ($popularDocuments = $popularDocumentQuery.setLimit(5).execute())

## ============================================================
## CONTACT ADMINISTRATEUR
## ============================================================
#set ($adminEmail = $xwiki.getXWikiPreference('admin_email'))
#set ($contactStatus = '')
#set ($contactMessage = '')

