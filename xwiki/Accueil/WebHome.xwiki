{{velocity}}
## ============================================================
## ACCUEIL XWIKI — page uniquement
## ============================================================
##
## Extensions à attacher à cette page :
##   StyleSheet Extension : Accueil - Base
##   StyleSheet Extension : Accueil - Modules
##   StyleSheet Extension : Accueil - Panneaux & Contact
##   JavaScript Extension : Accueil - Modules
##   JavaScript Extension : Accueil - Contact
##
## Règle : aucun CSS et aucun JavaScript métier dans WebHome.xwiki.
## ============================================================

#set ($showcomments = false)
#set ($showannotations = false)
#set ($showattachments = false)
#set ($showhistory = false)
#set ($showinformation = false)
#set ($displayDocExtra = false)

## ============================================================
## COMPTEURS RÉCURSIFS
## ============================================================
##
## Indiquer ici le dossier / espace racine de chaque catégorie.
## Exemples :
##   Documentation
##   Ressources.Documentation
##   Formation
##   Ressources.Formation
##
## Le dossier racine lui-même (son WebHome) n'est PAS compté.
## Tous ses enfants, sous-enfants, sous-sous-enfants, etc. sont comptés.
##
#set ($documentationRootSpace = 'Documentation')
#set ($formationRootSpace = 'Formation')

## Échappement des caractères spéciaux de LIKE selon la Query API XWiki.
#set ($documentationSpaceLike = $documentationRootSpace.replaceAll('([%_!])', '!$1').concat('.%'))
#set ($formationSpaceLike = $formationRootSpace.replaceAll('([%_!])', '!$1').concat('.%'))

#set ($documentationRootPage = "${documentationRootSpace}.WebHome")
#set ($formationRootPage = "${formationRootSpace}.WebHome")

#set ($documentationQuery = $services.query.xwql("where ((doc.space = :rootSpace) or (doc.space like :rootSpaceLike escape '!')) and doc.fullName <> :rootPage and doc.language = ''"))
#set ($discard = $documentationQuery.bindValue('rootSpace', $documentationRootSpace))
#set ($discard = $documentationQuery.bindValue('rootSpaceLike', $documentationSpaceLike))
#set ($discard = $documentationQuery.bindValue('rootPage', $documentationRootPage))
#set ($documentationCount = $documentationQuery.count())

#set ($formationQuery = $services.query.xwql("where ((doc.space = :rootSpace) or (doc.space like :rootSpaceLike escape '!')) and doc.fullName <> :rootPage and doc.language = ''"))
#set ($discard = $formationQuery.bindValue('rootSpace', $formationRootSpace))
#set ($discard = $formationQuery.bindValue('rootSpaceLike', $formationSpaceLike))
#set ($discard = $formationQuery.bindValue('rootPage', $formationRootPage))
#set ($formationCount = $formationQuery.count())

## Contact administrateur.
#set ($adminEmail = $xwiki.getXWikiPreference('admin_email'))
#set ($contactStatus = '')
#set ($contactMessage = '')

#if ("$!request.getMethod()" == 'POST' && "$!request.getParameter('homeAction')" == 'contact-admin')
  #if (!$services.csrf.isTokenValid("$!request.getParameter('form_token')"))
    #set ($contactStatus = 'error')
    #set ($contactMessage = 'Votre session a expiré. Rechargez la page puis réessayez.')
  #elseif ("$!adminEmail" == '')
    #set ($contactStatus = 'error')
    #set ($contactMessage = "Aucune adresse administrateur n'est configurée dans XWiki.")
  #else
    #set ($senderName = "$!request.getParameter('senderName')".trim())
    #set ($senderEmail = "$!request.getParameter('senderEmail')".trim())
    #set ($userMessage = "$!request.getParameter('message')".trim())

    #if ($senderName.length() == 0 || $userMessage.length() == 0)
      #set ($contactStatus = 'error')
      #set ($contactMessage = 'Le nom et le message sont obligatoires.')
    #elseif ($senderName.length() > 120 || $senderEmail.length() > 180 || $userMessage.length() > 5000)
      #set ($contactStatus = 'error')
      #set ($contactMessage = 'Le message dépasse la taille autorisée.')
    #else
      #set ($safeSubjectName = $senderName.replace('\r', ' ').replace('\n', ' '))
      #set ($mailSubject = "[Wiki] Message depuis la page d'accueil — ${safeSubjectName}")
      #set ($mailBody = "Message envoyé depuis la page d'accueil du wiki.\n\nNom : ${senderName}\nEmail : ${senderEmail}\nUtilisateur XWiki : ${xcontext.user}\n\nMessage :\n${userMessage}")
      #set ($mail = $services.mail.sender.createMessage($adminEmail, $mailSubject))
      #set ($discard = $mail.addPart('text/plain; charset=UTF-8', $mailBody))
      #set ($mailResult = $services.mail.sender.send($mail))
      #set ($contactStatus = 'success')
      #set ($contactMessage = "Votre message a été transmis à l'administrateur.")
    #end
  #end
#end

{{html clean="false"}}
<div class="naval-home"
     data-contact-status="$escapetool.xml($!contactStatus)"
     data-contact-message="$escapetool.xml($!contactMessage)">

  <div class="nh-shell">
    <header class="nh-header">
      <span class="nh-eyebrow">Portail interne</span>
      <h1 class="nh-title">Bienvenue sur votre espace de connaissance</h1>
      <p class="nh-subtitle">Accédez rapidement aux modules du wiki, aux ressources essentielles et aux informations utiles depuis un point d’entrée unique.</p>
    </header>

    <!-- ======================================================
         MODULES
         Ajouter / supprimer un bloc data-home-module suffit.
         Le JavaScript Accueil - Modules recalcule l'orbite.
         ====================================================== -->
    <div class="nh-module-source" aria-hidden="true">
      <div data-home-module
           data-label="Documentation"
           data-icon="D"
           data-title="Documentation"
           data-description="Retrouvez les procédures, les guides de référence et les connaissances partagées de votre organisation."
           data-url="$escapetool.xml($xwiki.getURL('Documentation.WebHome', 'view'))">
        <span data-module-point>Procédures et modes opératoires</span>
        <span data-module-point>Référentiels techniques</span>
        <span data-module-point>Guides et bonnes pratiques</span>
      </div>

      <div data-home-module
           data-label="Formation"
           data-icon="F"
           data-title="Formation"
           data-description="Centralisez les parcours de formation, supports pédagogiques et ressources destinées à la montée en compétence."
           data-url="$escapetool.xml($xwiki.getURL('Formation.WebHome', 'view'))">
        <span data-module-point>Parcours par métier</span>
        <span data-module-point>Supports de cours</span>
        <span data-module-point>Ressources et exercices</span>
      </div>

      <div data-home-module
           data-label="Projets"
           data-icon="P"
           data-title="Projets"
           data-description="Suivez les espaces projets, les décisions, les livrables et les informations nécessaires au travail collectif."
           data-url="$escapetool.xml($xwiki.getURL('Projets.WebHome', 'view'))">
        <span data-module-point>Espaces projets</span>
        <span data-module-point>Décisions et comptes-rendus</span>
        <span data-module-point>Suivi des livrables</span>
      </div>

      <div data-home-module
           data-label="Équipe"
           data-icon="E"
           data-title="Équipe"
           data-description="Retrouvez les informations d’équipe, les rôles, les contacts et les ressources communes."
           data-url="$escapetool.xml($xwiki.getURL('Equipe.WebHome', 'view'))">
        <span data-module-point>Annuaire interne</span>
        <span data-module-point>Rôles et responsabilités</span>
        <span data-module-point>Informations partagées</span>
      </div>

      <div data-home-module
           data-label="Outils"
           data-icon="O"
           data-title="Outils"
           data-description="Accédez aux outils et services utiles au quotidien depuis un catalogue centralisé."
           data-url="$escapetool.xml($xwiki.getURL('Outils.WebHome', 'view'))">
        <span data-module-point>Applications métier</span>
        <span data-module-point>Services internes</span>
        <span data-module-point>Liens et raccourcis</span>
      </div>

      <div data-home-module
           data-label="Support"
           data-icon="S"
           data-title="Support"
           data-description="Trouvez les réponses aux problèmes courants et les différents moyens de demander de l’aide."
           data-url="$escapetool.xml($xwiki.getURL('Support.WebHome', 'view'))">
        <span data-module-point>Questions fréquentes</span>
        <span data-module-point>Incidents connus</span>
        <span data-module-point>Canaux de support</span>
      </div>
    </div>

    <section class="nh-hero" aria-label="Modules du wiki">
      <div class="nh-orbit-stage">
        <div class="nh-orbit" data-module-orbit>
          <div class="nh-hub" aria-hidden="true">
            <span>
              <span class="nh-hub-icon">✦</span>
              <span class="nh-hub-label">Votre Wiki</span>
            </span>
          </div>
          <div data-module-nodes></div>
        </div>
      </div>

      <article class="nh-detail" aria-live="polite">
        <div class="nh-detail-content" data-module-detail>
          <span class="nh-detail-index" data-detail-index>Module 01</span>
          <h2 class="nh-detail-title" data-detail-title>Documentation</h2>
          <p class="nh-detail-description" data-detail-description>Retrouvez les procédures, guides et références du wiki.</p>
          <ul class="nh-detail-points" data-detail-points></ul>
          <a class="nh-detail-link" data-detail-link href="#">Ouvrir le module <span aria-hidden="true">→</span></a>
        </div>
      </article>
    </section>

    <section class="nh-cards" aria-label="Informations principales">
      <article class="nh-card">
        <div class="nh-card-icon" aria-hidden="true">◎</div>
        <h3>À la une</h3>
        <p>Utilisez ce panneau pour faire ressortir une actualité, une échéance importante ou un changement récent dans le wiki.</p>
      </article>

      <article class="nh-card">
        <div class="nh-card-icon" aria-hidden="true">↗</div>
        <h3>Accès rapides</h3>
        <p>Placez ici les liens les plus utilisés par vos équipes : procédures critiques, outils, formulaires ou pages métier.</p>
      </article>

      <article class="nh-card">
        <div class="nh-card-icon" aria-hidden="true">◌</div>
        <h3>Informations utiles</h3>
        <p>Un espace libre pour afficher des contacts, consignes, horaires, statuts de services ou toute autre information transversale.</p>
      </article>
    </section>

    <section class="nh-bottom" aria-label="Ressources du wiki">
      <div class="nh-stat">
        <span class="nh-stat-orb" aria-hidden="true">D</span>
        <div>
          <strong>$escapetool.xml($documentationCount)</strong>
          <span>Documentations</span>
        </div>
      </div>

      <div class="nh-stat">
        <span class="nh-stat-orb" aria-hidden="true">F</span>
        <div>
          <strong>$escapetool.xml($formationCount)</strong>
          <span>Formations</span>
        </div>
      </div>

      <div class="nh-admin">
        <div class="nh-admin-copy">
          <strong>Contacter l’administrateur</strong>
          <span>Une question, un problème ou une demande d’évolution ?</span>
        </div>
        <button class="nh-contact-button" type="button" data-open-contact>Envoyer un message</button>
      </div>
    </section>
  </div>

  <div class="nh-modal-backdrop"
       data-contact-modal
       role="dialog"
       aria-modal="true"
       aria-labelledby="nh-contact-title"
       aria-hidden="true">
    <div class="nh-modal">
      <div class="nh-modal-head">
        <div>
          <h2 id="nh-contact-title">Contacter l’administrateur</h2>
          <p>Votre message sera envoyé à l’adresse administrateur configurée dans XWiki.</p>
        </div>
        <button class="nh-modal-close" type="button" aria-label="Fermer" data-close-contact>×</button>
      </div>

      <form class="nh-form" method="post" action="">
        <input type="hidden" name="homeAction" value="contact-admin" />
        <input type="hidden" name="form_token" value="$escapetool.xml($services.csrf.getToken())" />

        <div class="nh-field">
          <label for="nh-sender-name">Nom *</label>
          <input id="nh-sender-name" name="senderName" type="text" maxlength="120" autocomplete="name" required />
        </div>

        <div class="nh-field">
          <label for="nh-sender-email">Email</label>
          <input id="nh-sender-email" name="senderEmail" type="email" maxlength="180" autocomplete="email" />
        </div>

        <div class="nh-field">
          <label for="nh-message">Message *</label>
          <textarea id="nh-message" name="message" maxlength="5000" required></textarea>
        </div>

        <div class="nh-form-actions">
          <button class="nh-button-secondary" type="button" data-close-contact>Annuler</button>
          <button class="nh-button-primary" type="submit">Envoyer</button>
        </div>
      </form>
    </div>
  </div>

  <div class="nh-toast" role="status" aria-live="polite" data-toast></div>
</div>
{{/html}}
{{/velocity}}