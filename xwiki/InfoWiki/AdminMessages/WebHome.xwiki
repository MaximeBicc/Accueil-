#set ($messageObjects = $storageDocument.getObjects($messageClassName))
#set ($messageCount = $messageObjects.size())
#set ($unreadCount = 0)
#set ($todoCount = 0)

#foreach ($messageObject in $messageObjects)
  #if ($messageObject)
    #set ($readValue = "$!messageObject.get('isRead')")
    #set ($doneValue = "$!messageObject.get('isDone')")
    #if ("$readValue" != 'Oui' && "$readValue" != '1' && "$readValue" != 'true')
      #set ($unreadCount = $unreadCount + 1)
    #end
