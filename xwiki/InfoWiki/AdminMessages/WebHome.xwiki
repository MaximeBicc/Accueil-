      ## Sur cette instance, un booléen XWiki lu via get() est affiché Oui / Non.
      #set ($currentRead = "$!targetObject.get('isRead')")
      #if ("$currentRead" == 'Oui' || "$currentRead" == '1' || "$currentRead" == 'true')
        #set ($discard = $targetObject.set('isRead', 0))
      #else
        #set ($discard = $targetObject.set('isRead', 1))
      #end
      #set ($discard = $storageDocument.save('Mise à jour état lu du message administrateur', true))
