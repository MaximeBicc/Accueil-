      #set ($todoCount = $todoCount + 1)
    #end
  #end
#end

{{html clean="false"}}
<div class="container-fluid">
  <div class="page-header">
    <h1>Messages administrateur</h1>
    <p class="text-muted">$escapetool.xml($messageCount) message(s) · $escapetool.xml($unreadCount) non lu(s) · $escapetool.xml($todoCount) à faire</p>
  </div>

  #if ("$actionMessage" != '')
    #if ("$actionStatus" == 'success')
      <div class="alert alert-success">$escapetool.xml($actionMessage)</div>
    #else
      <div class="alert alert-danger">$escapetool.xml($actionMessage)</div>
    #end
  #end

  #if (!$xwiki.exists($messageClassName))
    <div class="alert alert-warning">La classe <strong>InfoWiki.CODE.AdminMessageClass</strong> n’existe pas encore.</div>
  #elseif ($messageCount == 0)
    <div class="alert alert-info">Aucun message pour le moment.</div>
  #else
    <div class="table-responsive">
      <table class="table table-hover table-striped">
        <thead>
          <tr>
            <th>Lu</th>
            <th>Fait</th>
            <th>Date</th>
            <th>Utilisateur</th>
            <th>Nom</th>
            <th>Message</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          #foreach ($messageObject in $messageObjects)
            #if ($messageObject)
              #set ($readValue = "$!messageObject.get('isRead')")
              #set ($doneValue = "$!messageObject.get('isDone')")
              #set ($isRead = false)
              #set ($isDone = false)
              #if ("$readValue" == 'Oui' || "$readValue" == '1' || "$readValue" == 'true')
                #set ($isRead = true)
              #end
              #if ("$doneValue" == 'Oui' || "$doneValue" == '1' || "$doneValue" == 'true')
                #set ($isDone = true)
              #end

              ## IMPORTANT : on lit les valeurs BRUTES des propriétés.
              ## get('...') peut retourner une valeur déjà préparée pour l'affichage
              ## (HTML pour un TextArea, libellé localisé pour un booléen, etc.).
              #set ($createdValue = $messageObject.getProperty('created').value)
              #set ($senderUserValue = $messageObject.getProperty('senderUser').value)
              #set ($senderNameValue = $messageObject.getProperty('senderName').value)
              #set ($messageValue = $messageObject.getProperty('message').value)
              #set ($messageNumberText = "$!messageObject.number")

              <tr>
                <td>
                  #if ($isRead)
                    <span class="label label-success">Lu</span>
                  #else
                    <span class="label label-warning">Non lu</span>
                  #end
                </td>
                <td>
                  #if ($isDone)
                    <span class="label label-success">Fait</span>
                  #else
                    <span class="label label-default">Pas fait</span>
                  #end
                </td>
                <td>$escapetool.xml("$!createdValue")</td>
                <td>$escapetool.xml("$!senderUserValue")</td>
                <td>$escapetool.xml("$!senderNameValue")</td>
                <td style="white-space:pre-wrap;max-width:520px;">$escapetool.xml("$!messageValue")</td>
                <td>
                  <form method="post" action="" style="display:inline-block;margin-right:5px;">
                    <input type="hidden" name="form_token" value="$escapetool.xml($services.csrf.getToken())" />
                    <input type="hidden" name="messageNumber" value="$escapetool.xml($messageNumberText)" />
                    <input type="hidden" name="adminMessageAction" value="toggle-read" />
                    <button type="submit" class="btn btn-default btn-xs">#if ($isRead)Marquer non lu#else Marquer lu#end</button>
                  </form>
                  <form method="post" action="" style="display:inline-block;">
                    <input type="hidden" name="form_token" value="$escapetool.xml($services.csrf.getToken())" />
                    <input type="hidden" name="messageNumber" value="$escapetool.xml($messageNumberText)" />
                    <input type="hidden" name="adminMessageAction" value="toggle-done" />
                    <button type="submit" class="btn btn-primary btn-xs">#if ($isDone)Remettre à faire#else Marquer fait#end</button>
                  </form>
                </td>
              </tr>
            #end
          #end
        </tbody>
      </table>
    </div>
  #end
</div>
{{/html}}
{{/velocity}}
