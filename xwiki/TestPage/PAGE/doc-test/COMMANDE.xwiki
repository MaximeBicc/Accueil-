## Le refactoring profond supprime les sous-espaces physiques, pas les seuls enfants logiques.
## L'aperçu et la confirmation utilisent donc exactement la même liste et les mêmes versions.
#macro(collectDeletionPreview $deletionRootRef)
  #set($deletionComplete = true)
  #set($deletionMessage = '')
  #set($deletionNodes = [])
  #set($deletionSnapshot = '')
  #set($deletionRefs = [])
  #checkDocumentationRef($deletionRootRef)
