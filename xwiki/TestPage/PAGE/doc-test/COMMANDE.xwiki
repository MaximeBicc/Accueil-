                        #set($idDoc = $xwiki.getDocument($idRef))
                        #set($idObj = $idDoc.getObject($className))

                        #if($idObj)
                          $idObj.set("id", $idRef)
                          $idDoc.save("Mise à jour après déplacement")
                        #end

                        #if($sourceType == "folder")
                          #foreach($idChildRef in $idDoc.getChildren())
                            #set($idChildDoc = $xwiki.getDocument($idChildRef))
                            #set($idChildObj = $idChildDoc.getObject($className))
                            #if($idChildObj)
                              #set($idChildType = "$!idChildObj.getValue('type')")
                              #if($idChildType == "folder" || $idChildType == "document")
                                #set($ignore = $idQueue.add($idChildRef))
                              #end
                            #end
                          #end
                        #end
                      #end
                    #end

                    <div id="move-result"
                         data-old-ref="$escapetool.xml($sourceRef)"
                         data-new-ref="$escapetool.xml($newPageRef)"
                         style="display:none"></div>
                    DEPLACEMENT_OK
                  #end
                #end
              #catch(Exception e)
                ERREUR_DEPLACEMENT: $e.message
              #end
            #end
          #end
        #end
      #end
    #end

  ## ============================================================
  ## CREATION EXISTANTE
  ## ============================================================
  #else
    #set($type = $!request.getParameter('type'))
    #set($nomFichier = $!request.getParameter('nom_fichier'))
    #set($technicalName = "$!request.getParameter('technical_name')")
    #if(!$technicalName || "$!technicalName" == "")
      #set($technicalName = "$nomFichier")
    #end
    #set($pageParent = $!request.getParameter('page'))
    #set($sourceFilename = "$!request.getParameter('source_filename')")
    #set($sourceKind = "$!request.getParameter('source_kind')")

    #set($docParent = "")
    #if($pageParent && "$!pageParent" != "")
      #set($docParent = $xwiki.getDocument($pageParent))
    #end

    #if($action != "ajouter un fichier" && $action != "ajouter un document")
      ERREUR_ACTION
    #elseif(!$nomFichier || "$!nomFichier" == "")
      ERREUR_CHAMPS
    #elseif(!$pageParent || "$!pageParent" == "")
      ERREUR_PAGE_DE_STOCKAGE_INTROUVABLE
    #elseif($docParent.isNew())
      ERREUR_PAGE_DE_STOCKAGE_INTROUVABLE
      $pageParent
    #elseif($sourceKind != "" && $sourceKind != "pdf" && $sourceKind != "word" && $sourceKind != "file")
      ERREUR_FORMAT_DOCUMENT
    #elseif($sourceFilename.contains('"') || $sourceFilename.contains("{{") || $sourceFilename.contains("}}"))
      ERREUR_NOM_DOCUMENT
    #elseif(!$xwiki.hasAccessLevel("edit", $xcontext.user, $doc.fullName))
      ERREUR_DROITS
    #else
      #try
        #set($pageParentClean = $pageParent)
        #if($pageParent.endsWith(".WebHome"))
          #set($pageParentClean = $pageParent.substring(0, $pageParent.length() - 8))
        #end

        #set($newPageRef = "${pageParentClean}.${technicalName}.WebHome")
        #set($newPageDoc = $xwiki.getDocument($newPageRef))

        #if(!$newPageDoc.isNew())
          ERREUR_PAGE_EXISTE
        #else
          #set($pageReady = false)

          #if($type == "document" && $sourceKind == "word")
            #set($fileUpload = $xwiki.fileupload)
            #set($officeFileName = $fileUpload.getFileName("filePath"))

            #if(!$officeFileName || "$!officeFileName" == "")
              ERREUR_DOCUMENT_MANQUANT
            #else
              #set($discard = $fileUpload.loadFileList())
              #set($officeFileStream = "")

              #foreach($fileItem in $fileUpload.fileItems)
                #if($fileItem.fieldName == "filePath")
