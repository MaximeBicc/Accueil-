    #set($deletionComplete = false)
    #set($deletionMessage = 'Vous ne pouvez pas préparer la suppression de cet élément.')
  #else
    #set($deletionRootDoc = $xwiki.getDocumentAsAuthor($deletionRootRef))
    #set($deletionRootObject = $deletionRootDoc.getObject($className))
    #set($deletionRootType = "$!deletionRootObject.getValue('type')")
    #if($deletionRootDoc.isNew() || !$deletionRootObject || ($deletionRootType != 'folder' && $deletionRootType != 'document'))
      #set($deletionComplete = false)
      #set($deletionMessage = 'Cet élément est introuvable ou ne fait pas partie de la documentation.')
    #else
      #set($discard = $deletionRefs.add($deletionRootRef))
      #set($deletionRootSpace = $deletionRootRef.substring(0, $deletionRootRef.length() - 8))
      #if($deletionRootType == 'folder')
        #set($deletionPrefix = $deletionRootSpace.replace('!', '!!').replace('_', '!_'))
        #set($deletionPrefix = "${deletionPrefix}.%")
        #set($deletionPhysicalRefs = $services.query.hql("select distinct doc.fullName from XWikiDocument doc where doc.space = :deletionSpace or doc.space like :deletionPrefix escape '!' order by doc.fullName").bindValue('deletionSpace', $deletionRootSpace).bindValue('deletionPrefix', $deletionPrefix).setLimit(501).execute())
        #if($deletionPhysicalRefs.size() > 500)
          #set($deletionComplete = false)
          #set($deletionMessage = 'Ce dossier dépasse la limite de 500 pages. Réduisez son contenu avant de le supprimer.')
        #end
        #foreach($deletionPhysicalRef in $deletionPhysicalRefs)
          #if(!$deletionRefs.contains($deletionPhysicalRef))
            #set($discard = $deletionRefs.add($deletionPhysicalRef))
          #end
        #end
      #end
      #foreach($deletionRef in $deletionRefs)
        #set($deletionInsideRoot = $deletionRef == $deletionRootRef || $deletionRef.startsWith("${deletionRootSpace}."))
        #checkDocumentationRef($deletionRef)
        #if(!$validDocumentationRef)
          #checkDocumentationRef("${deletionRef}.WebHome")
        #end
        #if(!$deletionInsideRoot || !$validDocumentationRef || !$xwiki.hasAccessLevel('view', $xcontext.user, $deletionRef))
          #set($deletionComplete = false)
          #set($deletionMessage = 'L’aperçu ne peut pas afficher toutes les pages de ce dossier. La suppression est bloquée.')
        #else
          #set($deletionDoc = $xwiki.getDocumentAsAuthor($deletionRef))
          #if(!$deletionDoc || $deletionDoc.isNew())
            #set($deletionComplete = false)
            #set($deletionMessage = 'Le dossier a changé pendant la préparation. Rechargez l’aperçu.')
          #else
            #set($deletionObject = false)
            #set($deletionObject = $deletionDoc.getObject($className))
            #set($deletionType = 'document')
            #if($deletionObject && "$!deletionObject.getValue('type')" == 'folder')
              #set($deletionType = 'folder')
            #end
            #set($deletionParentRef = '')
            #if($deletionRef != $deletionRootRef)
              #set($deletionParentSpace = $deletionRef)
              #if($deletionRef.endsWith('.WebHome'))
                #set($deletionParentSpace = $deletionRef.substring(0, $deletionRef.length() - 8))
              #end
              #set($deletionParentSpace = $deletionParentSpace.substring(0, $deletionParentSpace.lastIndexOf('.')))
              #set($deletionParentRef = "${deletionParentSpace}.WebHome")
              #foreach($deletionParentDepth in [0..500])
                #if($deletionRefs.contains($deletionParentRef) || !$deletionParentSpace.startsWith("${deletionRootSpace}."))
                  #break
                #end
                #if(!$deletionRefs.contains($deletionParentRef) && $deletionParentSpace.startsWith("${deletionRootSpace}."))
                  #set($deletionParentSpace = $deletionParentSpace.substring(0, $deletionParentSpace.lastIndexOf('.')))
                  #set($deletionParentRef = "${deletionParentSpace}.WebHome")
                #end
              #end
              #if(!$deletionRefs.contains($deletionParentRef))
                #set($deletionParentRef = $deletionRootRef)
              #end
            #end
            #set($discard = $deletionNodes.add({'ref':$deletionRef,'parentRef':$deletionParentRef,'title':$deletionDoc.displayTitle,'type':$deletionType,'version':"$deletionDoc.version"}))
            #set($deletionSnapshot = "${deletionSnapshot}${deletionRef}@$deletionDoc.version\n")
          #end
        #end
      #end
    #end
  #end
#end

## Un refactoring peut terminer son travail tout en journalisant un échec sur une sous-page.
#macro(checkRefactoringJob $checkedJob)
  #set($refactoringFailed = false)
  #set($refactoringStatus = false)
  #if($checkedJob)
    #set($refactoringStatus = $checkedJob.getStatus())
  #end
  #if(!$refactoringStatus || $refactoringStatus.getError())
    #set($refactoringFailed = true)
  #else
    #foreach($refactoringEvent in $refactoringStatus.getLogTail())
      #if("$!refactoringEvent.level" == 'ERROR')
        #set($refactoringFailed = true)
      #end
    #end
  #end
#end

