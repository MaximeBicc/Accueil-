    #set($proposalFieldDefinition = false)
    #if($proposalDefinition)
      #set($proposalFieldDefinition = $proposalDefinition.get($proposalField))
    #end
    #if(!$proposalFieldDefinition)
      #docError('ERREUR_CLASSE_PROPOSITION' "Configuration des propositions : champ « ${proposalField} » absent (type ${proposalExpectedType} attendu).")
