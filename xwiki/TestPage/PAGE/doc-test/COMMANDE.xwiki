    #set($ignore = $collectiontool.reverseModifiable($tryRefHistory))

    #set($textPath = "")
    #foreach($tableRef in $tryRefHistory)
      #set($tableDoc = $xwiki.getDocument($tableRef))
      #if($foreach.index == 0)
        #set($textPath = $tableDoc.displayTitle)
      #else
        #set($textPath = "${textPath} > ${tableDoc.displayTitle}")
      #end
    #end

    <div class="breadcrumb-bar-shell">
      <div id="breadcrumb-wrapper">
        <div id="breadcrumb-container">
          #foreach($tableRef in $tryRefHistory)
            #set($tableDoc = $xwiki.getDocument($tableRef))
            <span class="folder" data-full-name="$escapetool.xml($tableRef)">$escapetool.xml($tableDoc.displayTitle)</span>
            #if($foreach.hasNext)
              <span class="breadcrumb-separator">&rsaquo;</span>
            #end
          #end
        </div>

        <input type="text"
               id="breadcrumb-input"
               value="$escapetool.xml($textPath)"
               data-valid-path="$escapetool.xml($textPath)"
               autocomplete="off"
               spellcheck="false"
               style="display:none;" />

        <button type="button"
                id="breadcrumb-copy-btn"
                class="breadcrumb-copy-btn"
                title="Copier le chemin"
                aria-label="Copier le chemin">
          <span class="breadcrumb-copy-icon" aria-hidden="true"></span>
        </button>
      </div>
    </div>

    <div id="breadcrumb-error"
         class="breadcrumb-error"
         role="alert"
         aria-live="polite"
         style="display:none;"></div>

    #set($children = $parentDoc.getChildren())

    <ul id="explorer-search-results"
        class="file-explorer-list explorer-search-results"
        style="display:none;"></ul>

    <ul id="explorer-current-list" class="file-explorer-list">
      #foreach($childRef in $children)
        #set($childDoc = $xwiki.getDocument($childRef))
        #set($metaobj = $childDoc.getObject($className))

        #if($metaobj)
          #set($childType = "$!metaobj.getValue('type')")

          #if($childType == "folder")
            <li class="explorer-row"
                data-ref="$escapetool.xml($childRef)"
                data-title="$escapetool.xml($childDoc.displayTitle)"
                data-desc=""
                data-tags=""
                data-type="folder">
              <label class="explorer-select-box">
                <input type="checkbox"
                       class="explorer-select-input"
                       data-ref="$escapetool.xml($childRef)"
                       data-title="$escapetool.xml($childDoc.displayTitle)"
                       data-type="folder" />
              </label>
              <span class="folder folder-item"
                    data-full-name="$escapetool.xml($childRef)"
                    data-title="$escapetool.xml($childDoc.displayTitle)"
                    data-type="folder">
                $services.icon.renderHTML('folder') $escapetool.xml($childDoc.displayTitle)
              </span>
            </li>

          #elseif($childType == "document")
            #set($description = "$!metaobj.getValue('description')")
            #set($tags = "$!metaobj.getValue('tag')")
            #set($creator = $metaobj.getValue('createur'))
            #set($created = $xwiki.formatDate($childDoc.creationDate, 'dd/MM/yyyy HH:mm'))
            #set($modified = $xwiki.formatDate($childDoc.date, 'dd/MM/yyyy HH:mm'))
            #set($docUrl = $childDoc.getURL('view'))
            #set($docUrlPreview = $childDoc.getURL('view', 'xpage=print'))

            <li class="explorer-row"
                data-ref="$escapetool.xml($childRef)"
                data-title="$escapetool.xml($childDoc.displayTitle)"
                data-desc="$escapetool.xml($description)"
                data-tags="$escapetool.xml($tags)"
                data-type="document">
              <label class="explorer-select-box">
                <input type="checkbox"
                       class="explorer-select-input"
                       data-ref="$escapetool.xml($childRef)"
                       data-title="$escapetool.xml($childDoc.displayTitle)"
                       data-type="document" />
              </label>
              <span class="document-item"
                    data-full-name="$escapetool.xml($childRef)"
                    data-title="$escapetool.xml($childDoc.displayTitle)"
                    data-type="document"
                    data-creator="$escapetool.xml($creator)"
                    data-created="$created"
                    data-modified="$modified"
                    data-desc="$escapetool.xml($description)"
                    data-tags="$escapetool.xml($tags)"
                    data-url="$docUrl"
                    data-url-preview="$docUrlPreview">
                $services.icon.renderHTML('page') $escapetool.xml($childDoc.displayTitle)
              </span>
            </li>
          #end
        #end
      #end
    </ul>

    <div id="explorer-search-empty"
         class="explorer-search-empty"
         style="display:none;">
      Aucun élément ne correspond à la recherche.
    </div>

    <div id="preview-sidebar" class="sidebar-preview">
      <div id="sidebar-drag-handle"></div>
      <div class="sidebar-header">
        <h3 id="sidebar-title">Nom du document</h3>
        <button id="sidebar-close" class="close-btn">&times;</button>
      </div>
      <div class="sidebar-body">
        <div class="sidebar-section" data-sidebar-section="information">
          <button type="button"
                  class="sidebar-section-toggle"
                  aria-expanded="false">
            <span>Informations</span>
            <span class="sidebar-section-chevron" aria-hidden="true"></span>
          </button>

          <div class="sidebar-section-content" style="display:none;">
            <div class="sidebar-info-grid">
              <div class="meta-group"><strong>Créateur :</strong> <span id="sidebar-creator"></span></div>
              <div class="meta-group"><strong>Créé le :</strong> <span id="sidebar-created"></span></div>
              <div class="meta-group"><strong>Modifié le :</strong> <span id="sidebar-modified"></span></div>
            </div>
          </div>
        </div>

        <div class="sidebar-section" data-sidebar-section="metadata">
          <button type="button"
                  class="sidebar-section-toggle"
                  aria-expanded="false">
            <span>Description et mots-clés</span>
            <span class="sidebar-section-chevron" aria-hidden="true"></span>
          </button>

          <div class="sidebar-section-content" style="display:none;">
            <div class="sidebar-editable-section">
              <label for="sidebar-desc-input">Description</label>
              <textarea id="sidebar-desc-input"
                        class="sidebar-desc-input"
                        rows="4"
                        maxlength="4000"
                        placeholder="Ajouter une description au document"></textarea>
            </div>

            <div class="sidebar-editable-section">
              <label for="sidebar-tag-input">Mots-clés</label>
              <div id="sidebar-tags-list" class="sidebar-tags-list"></div>
              <div class="sidebar-tag-entry">
                <input id="sidebar-tag-input"
                       class="sidebar-tag-input"
                       type="text"
                       maxlength="80"
                       autocomplete="off"
                       placeholder="Ajouter un mot-clé" />
                <button id="sidebar-tag-add"
                        type="button"
                        class="sidebar-tag-add-btn">Ajouter</button>
              </div>
              <p class="sidebar-field-help">Entrée ou virgule pour ajouter un mot-clé.</p>
            </div>

            <div class="sidebar-metadata-actions">
              <button id="sidebar-metadata-save"
                      type="button"
                      class="sidebar-metadata-save-btn">Enregistrer</button>
              <span id="sidebar-metadata-status"
                    class="sidebar-metadata-status"
                    aria-live="polite"></span>
            </div>
          </div>
        </div>

        <div class="sidebar-section sidebar-section-preview is-open"
             data-sidebar-section="preview">
          <button type="button"
                  class="sidebar-section-toggle"
                  aria-expanded="true">
            <span>Aperçu</span>
            <span class="sidebar-section-chevron" aria-hidden="true"></span>
          </button>

          <div class="sidebar-section-content sidebar-preview-content" style="display:flex;">
            <div class="preview-frame-container">
              <div class="iframe-wrapper">
                <iframe id="sidebar-iframe" src="" frameborder="0"></iframe>
                <div class="zoom-controls">
                  <button id="btn-zoom-out" class="zoom-btn" title="Dézoomer">-</button>
                  <span id="zoom-level">80%</span>
                  <button id="btn-zoom-in" class="zoom-btn" title="Zoomer">+</button>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="sidebar-footer">
        <a id="sidebar-open-btn" href="#" class="open-doc-btn" target="_blank">Ouvrir le document</a>
      </div>
    </div>

  #else
    ERREUR_ACTION
  #end
#else
  ERREUR_METHOD
#end
{{/html}}
{{/velocity}}
