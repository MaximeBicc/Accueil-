                  #break
                #end
              #end

              #if(!$officeFileStream || "$!officeFileStream" == "")
                ERREUR_DOCUMENT_MANQUANT
              #else
                #set($targetDocumentReference = $newPageDoc.documentReference)
                #set($parentDocumentReference = $docParent.documentReference)

                #set($xdomOfficeDoc = $services.officeimporter.officeToXDOM(
                  $officeFileStream,
                  $officeFileName,
                  $targetDocumentReference,
                  false
                ))

                #if($xdomOfficeDoc)
                  #set($pageReady = $services.officeimporter.save(
                    $xdomOfficeDoc,
                    $targetDocumentReference,
                    $parentDocumentReference,
                    $nomFichier,
                    false
                  ))
                  #set($discard = $xdomOfficeDoc.close())

                  #if(!$pageReady)
                    ERREUR_IMPORT_OFFICE: $services.officeimporter.errorMessage
                  #end
                #else
                  ERREUR_IMPORT_OFFICE: $services.officeimporter.errorMessage
                #end
              #end
            #end
          #else
            $newPageDoc.setTitle("$nomFichier")
            $newPageDoc.setParent($docParent.fullName)

            #if($type == "document" && $sourceKind == "pdf" && $sourceFilename != "")
              #set($dq = '"')
              #set($pageContent = "{{pdf filename=${dq}${sourceFilename}${dq}/}}")
              $newPageDoc.setContent($pageContent)
            #elseif($type == "document" && $sourceKind == "file" && $sourceFilename != "")
              #set($pageContent = "[[Télécharger le fichier>>attach:${sourceFilename}]]")
              $newPageDoc.setContent($pageContent)
            #else
              $newPageDoc.setContent("")
            #end

            $newPageDoc.save("Création d'un nouveau fichier")
            #set($pageReady = true)
          #end

          #if($pageReady)
            #set($newPageDoc = $xwiki.getDocument($newPageRef))
            #set($object = $newPageDoc.getObject($className))

            #if(!$object)
              #set($numeroObject = $newPageDoc.createNewObject($className))
              #set($object = $newPageDoc.getObject($className, $numeroObject))
            #end

            $object.set("nom", $nomFichier)
            $object.set("type", "${type}")
            $object.set("id", $newPageRef)
            $object.set("tag", "")
            $object.set("description", "")

            #set($userDoc = $xwiki.getDocument($xcontext.user))
            #set($firstName = "$!userDoc.getValue('first_name')")
            #set($lastName = "$!userDoc.getValue('last_name')")

            #if("$!firstName" != "" && "$!lastName" != "")
              #set($creatorName = "$firstName $lastName")
            #elseif("$!firstName" != "")
              #set($creatorName = "$firstName")
            #elseif("$!lastName" != "")
              #set($creatorName = "$lastName")
            #else
              #set($creatorName = $xwiki.getUserName($xcontext.user, false))
            #end

            $object.set("createur", "$creatorName")
            $newPageDoc.save("Création de l'objet pour le nouveau fichier")

            #set($uploadUrl = $newPageDoc.getURL("upload"))
            <div id="creation-result"
                 data-page-ref="$escapetool.xml($newPageRef)"
                 data-upload-url="$escapetool.xml($uploadUrl)"
                 style="display:none"></div>
            LIEN_AJOUTE_OK
          #end
        #end
      #catch(Exception e)
        ERREUR_INCONNUE: $e.message
      #end
    #end
  #end

#elseif ($request.getMethod() == "GET")
  #set($action = $request.get("action"))
  #set($mainParent = 'TestPage.PAGE.doc-test.WebHome')
  #set($className = "TestPage.PAGE.Doc.CODE.docClass.WebHome")

  ## ============================================================
  ## DONNEES POUR LA VUE ARCHITECTURE
  ## ============================================================
  #if($action == "architecture")
    <div id="architecture-data">
      #set($treeQueue = [])
      #set($ignore = $treeQueue.add($mainParent))

      #foreach($treeIndex in [0..500])
        #if($treeIndex < $treeQueue.size())
          #set($treeRef = $treeQueue.get($treeIndex))
          #set($treeDoc = $xwiki.getDocument($treeRef))
          #set($treeType = "")
          #set($treeParentRef = "")

          #if($treeRef == $mainParent)
            #set($treeType = "root")
          #else
            #set($treeObj = $treeDoc.getObject($className))
            #if($treeObj)
              #set($treeType = "$!treeObj.getValue('type')")
            #end
            #set($treeParentRef = "$!treeDoc.getParent()")
          #end

          #if($treeType == "root" || $treeType == "folder" || $treeType == "document")
            <div class="architecture-node-data"
                 data-ref="$escapetool.xml($treeRef)"
                 data-parent-ref="$escapetool.xml($treeParentRef)"
                 data-title="$escapetool.xml($treeDoc.displayTitle)"
                 data-type="$escapetool.xml($treeType)"></div>

            #if($treeType == "root" || $treeType == "folder")
              #foreach($treeChildRef in $treeDoc.getChildren())
                #set($treeChildDoc = $xwiki.getDocument($treeChildRef))
                #set($treeChildObj = $treeChildDoc.getObject($className))
                #if($treeChildObj)
                  #set($treeChildType = "$!treeChildObj.getValue('type')")
                  #if($treeChildType == "folder" || $treeChildType == "document")
                    #set($ignore = $treeQueue.add($treeChildRef))
                  #end
                #end
              #end
            #end
          #end
        #end
      #end
    </div>

  ## ============================================================
  ## EXPLORATEUR NORMAL
  ## ============================================================
  #elseif($action == "recupContact")
    #set($parentRef = $request.get("childRef"))
    #set($parentDoc = $xwiki.getDocument($parentRef))

    <div id="pageData" parent-page="$escapetool.xml($parentRef)">
      <h4>$escapetool.xml($parentDoc.displayTitle)</h4>
    </div>

    <div class="explorer-management-toolbar">
      <div class="explorer-management-left">
        <button type="button" id="explorer-select-toggle" class="btn btn-default">Sélectionner</button>
        <button type="button" id="explorer-move-btn" class="btn btn-default" disabled>Déplacer</button>
        <button type="button" id="explorer-delete-btn" class="btn btn-danger" disabled>Supprimer</button>
        <button type="button" id="explorer-architecture-btn" class="btn btn-default">Architecture</button>
      </div>
      <span id="explorer-selection-count" class="explorer-selection-count"></span>
    </div>

    <div id="explorer-move-destination" class="explorer-move-destination" style="display:none;">
      <div>
        <strong>Déplacement en cours :</strong>
        <span id="explorer-move-title"></span>
      </div>
      <div class="explorer-move-destination-actions">
        <button type="button" id="explorer-move-here-btn" class="btn btn-primary">Déplacer ici</button>
        <button type="button" id="explorer-move-cancel-btn" class="btn btn-default">Annuler</button>
      </div>
    </div>

    #set($tryRefHistory = [$parentRef])
    #set($trouve = false)
    #set($tryRef = $parentRef)

    #foreach($niveau in [0..100])
      #if($tryRef == $mainParent)
        #set($trouve = true)
        #break
      #end

      #if(!$trouve)
        #set($tryDoc = $xwiki.getDocument($tryRef))
        #set($tryParent = $tryDoc.getParent())

        #if(!$tryParent || $tryParent == "" || $tryParent == $tryRef)
          #break
        #end

        #set($tryRef = $tryParent)

        #if(!$tryRefHistory.contains($tryRef))
          #set($ignore = $tryRefHistory.add($tryRef))
        #else
          #break
        #end
      #end
    #end

    #set($ignore = $collectiontool.reverseModifiable($tryRefHistory))

    <div id="breadcrumb-wrapper">
      <div id="breadcrumb-container">
        #foreach($tableRef in $tryRefHistory)
          #set($tableDoc = $xwiki.getDocument($tableRef))
          <span class="folder" data-full-name="$escapetool.xml($tableRef)">$escapetool.xml($tableDoc.displayTitle)</span>
          #if($foreach.hasNext)
            <span class="breadcrumb-separator">&rsaquo;</span>
          #end
        #end
      </div>

      #set($textPath = "")
      #foreach($tableRef in $tryRefHistory)
        #set($tableDoc = $xwiki.getDocument($tableRef))
        #if($foreach.index == 0)
          #set($textPath = $tableDoc.displayTitle)
        #else
          #set($textPath = "${textPath} > ${tableDoc.displayTitle}")
        #end
      #end

      <input type="text" id="breadcrumb-input" value="$escapetool.xml($textPath)" style="display:none;" />
    </div>

    #set($children = $parentDoc.getChildren())
    <ul class="file-explorer-list">
      #foreach($childRef in $children)
        #set($childDoc = $xwiki.getDocument($childRef))
        #set($metaobj = $childDoc.getObject($className))

        #if($metaobj)
          #set($childType = "$!metaobj.getValue('type')")

          #if($childType == "folder")
            <li class="explorer-row"
                data-ref="$escapetool.xml($childRef)"
                data-title="$escapetool.xml($childDoc.displayTitle)"
                data-type="folder">
              <label class="explorer-select-box">
                <input type="checkbox"
                       class="explorer-select-input"
                       data-ref="$escapetool.xml($childRef)"
                       data-title="$escapetool.xml($childDoc.displayTitle)"
                       data-type="folder" />
              </label>
              <span class="folder folder-item"
                    data-full-name="$escapetool.xml($childRef)"
                    data-title="$escapetool.xml($childDoc.displayTitle)"
                    data-type="folder">
                $services.icon.renderHTML('folder') $escapetool.xml($childDoc.displayTitle)
              </span>
            </li>

          #elseif($childType == "document")
            #set($description = $metaobj.getValue('description'))
            #set($creator = $metaobj.getValue('createur'))
            #set($created = $xwiki.formatDate($childDoc.creationDate, 'dd/MM/yyyy HH:mm'))
            #set($modified = $xwiki.formatDate($childDoc.date, 'dd/MM/yyyy HH:mm'))
            #set($docUrl = $childDoc.getURL('view'))
            #set($docUrlPreview = $childDoc.getURL('view', 'xpage=print'))

            <li class="explorer-row"
                data-ref="$escapetool.xml($childRef)"
                data-title="$escapetool.xml($childDoc.displayTitle)"
                data-type="document">
              <label class="explorer-select-box">
                <input type="checkbox"
                       class="explorer-select-input"
                       data-ref="$escapetool.xml($childRef)"
                       data-title="$escapetool.xml($childDoc.displayTitle)"
                       data-type="document" />
              </label>
              <span class="document-item"
                    data-full-name="$escapetool.xml($childRef)"
                    data-title="$escapetool.xml($childDoc.displayTitle)"
                    data-type="document"
                    data-creator="$escapetool.xml($creator)"
                    data-created="$created"
                    data-modified="$modified"
                    data-desc="$escapetool.xml($description)"
                    data-url="$docUrl"
                    data-url-preview="$docUrlPreview">
                $services.icon.renderHTML('page') $escapetool.xml($childDoc.displayTitle)
              </span>
            </li>
          #end
        #end
      #end
    </ul>

    <div id="preview-sidebar" class="sidebar-preview">
      <div id="sidebar-drag-handle"></div>
      <div class="sidebar-header">
        <h3 id="sidebar-title">Nom du document</h3>
        <button id="sidebar-close" class="close-btn">&times;</button>
      </div>
      <div class="sidebar-body">
        <div class="meta-group"><strong>Créateur :</strong> <span id="sidebar-creator"></span></div>
        <div class="meta-group"><strong>Créé le :</strong> <span id="sidebar-created"></span></div>
        <div class="meta-group"><strong>Modifié le :</strong> <span id="sidebar-modified"></span></div>
        <div class="meta-group"><strong>Description :</strong><p id="sidebar-desc"></p></div>
        <div class="preview-frame-container">
          <strong>Aperçu :</strong>
          <div class="iframe-wrapper">
            <iframe id="sidebar-iframe" src="" frameborder="0"></iframe>
            <div class="zoom-controls">
              <button id="btn-zoom-out" class="zoom-btn" title="Dézoomer">-</button>
              <span id="zoom-level">80%</span>
              <button id="btn-zoom-in" class="zoom-btn" title="Zoomer">+</button>
            </div>
          </div>
        </div>
      </div>
      <div class="sidebar-footer">
        <a id="sidebar-open-btn" href="#" class="open-doc-btn" target="_blank">Ouvrir le document</a>
      </div>
    </div>

  #else
    ERREUR_ACTION
  #end
#else
  ERREUR_METHOD
#end
{{/html}}
{{/velocity}}
