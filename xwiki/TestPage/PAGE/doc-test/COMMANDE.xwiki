    <div class="explorer-search-toolbar">
      <div class="explorer-search-field">
        <input type="search"
               id="explorer-search-input"
               class="form-control"
               placeholder="Rechercher dans ce dossier et ses sous-dossiers"
               autocomplete="off" />
      </div>

      <select id="explorer-type-filter"
              class="form-control explorer-filter-select"
              aria-label="Filtrer par type">
        <option value="">Tous</option>
        <option value="document">Documents</option>
        <option value="folder">Dossiers</option>
      </select>

      <select id="explorer-tag-filter"
              class="form-control explorer-filter-select"
              aria-label="Filtrer par mot-clé"
              disabled>
        <option value="">Tags</option>
      </select>

      <button type="button"
              id="explorer-search-reset"
              class="explorer-search-reset"
              title="Effacer la recherche"
              aria-label="Effacer la recherche">×</button>

      <span id="explorer-search-count"
            class="explorer-search-count"
            aria-live="polite"></span>
    </div>

    <div class="explorer-management-toolbar">
      <div class="explorer-management-left">
        <button type="button" id="explorer-select-toggle" class="btn btn-default">Sélectionner</button>
        <button type="button" id="explorer-move-btn" class="btn btn-default" disabled>Déplacer</button>
        <button type="button" id="explorer-delete-btn" class="btn btn-danger" disabled>Supprimer</button>
        <button type="button" id="explorer-architecture-btn" class="btn btn-default">Architecture</button>
      </div>
      <span id="explorer-selection-count" class="explorer-selection-count"></span>
    </div>

    <div id="explorer-move-destination" class="explorer-move-destination" style="display:none;">
