{{velocity}}
{{html clean="false"}}
#if($request.getMethod() == 'POST')
  #if($errorCode != '')
    <div id="documentation-error" data-code="#docOutput($errorCode)" data-message="#docOutput($errorMessage)"></div>
    #docOutput($errorCode)
  #else
    <div id="creation-result" data-code="#docOutput($resultCode)" data-page-ref="#docOutput($resultRef)" data-proposal-ref="#docOutput($resultProposalRef)" data-upload-url="" style="display:none"></div>
    <div id="move-result" data-old-ref="#docOutput($resultOldRef)" data-new-ref="#docOutput($resultRef)" style="display:none"></div>
    <div id="metadata-result" data-modified="$xwiki.formatDate($datetool.date, 'dd/MM/yyyy HH:mm')" style="display:none"></div>
    #docOutput($resultCode)
  #end
#elseif($request.getMethod() == 'GET' && !$canView)
  ERREUR_DROITS
#elseif($request.getMethod() == 'GET')
  #if($action == 'workflow')
    <div id="documentation-permissions" data-can-view="$canView" data-can-create="$canCreate" data-can-move="$canMove" data-can-modify="$canModify" data-can-import="$canImport" data-can-content="$canContent" data-can-propose="$canPropose" data-can-review="$canReview" data-can-configure="$canConfigure" data-can-delete="$canDelete" data-settings-version="#docOutput("$!configuration.version")"></div>
    #if($canConfigure)
      #set($allGroups = $services.query.hql("select distinct doc.fullName from XWikiDocument doc, BaseObject obj where obj.name = doc.fullName and obj.className = 'XWiki.XWikiGroups' order by doc.fullName").execute())
      #foreach($groupRef in $allGroups)
        #if($xwiki.hasAccessLevel('view', $xcontext.user, $groupRef))
          #set($groupDoc = $xwiki.getDocument($groupRef))
          #set($canonicalGroup = $services.model.serialize($groupDoc.documentReference))
          <span class="doc-group-data" data-ref="#docOutput($canonicalGroup)" data-title="#docOutput($groupDoc.displayTitle)"></span>
        #end
      #end
      #if($configurationObject)
        #foreach($right in $settingsFields.keySet())
          #set($configuredGroups = "$!configurationObject.getValue($settingsFields.get($right))")
          #foreach($configuredGroup in $configuredGroups.split('[\r\n]+'))
            #if($configuredGroup.replaceAll('^\s+|\s+$', '') != '')
              <span class="doc-grant-data" data-right="$right" data-group="#docOutput($configuredGroup.replaceAll('^\s+|\s+$', ''))"></span>
            #end
          #end
        #end
      #end
    #end
  #elseif($action == 'contenu document')
    #set($contentRef = "$!request.getParameter('source_ref')")
    #if($contentRef == '')
      #set($contentRef = "$!request.getParameter('ref')")
    #end
    #checkDocumentationRef($contentRef)
    #if(!$validDocumentationRef || !$xwiki.hasAccessLevel('view', $xcontext.user, $contentRef))
      ERREUR_DROITS
    #else
      #set($contentDoc = $xwiki.getDocument($contentRef))
      #set($contentObject = $contentDoc.getObject($className))
      #set($sourceContentObject = $contentDoc.getObject($contentClass))
      #set($editableSource = "$!contentDoc.content")
      #if($sourceContentObject)
        #set($editableSource = "$!sourceContentObject.getValue('source')")
      #end
      #set($loadedType = "$!contentObject.getValue('type')")
      #if(!$contentObject || ($loadedType != 'document' && $loadedType != 'folder'))
        ERREUR_ELEMENT_INVALIDE
      #else
        <div id="documentation-content" data-version="#docOutput("$contentDoc.version")" data-type="#docOutput($loadedType)" data-title="#docOutput($contentDoc.displayTitle)" data-description="#docOutput("$!contentObject.getValue('description')")" data-tags="#docOutput("$!contentObject.getValue('tag')")"></div>
        #if($loadedType == 'folder')
          #set($editableSource = '')
        #end
        <textarea id="documentation-source">#docOutput($editableSource)</textarea>
      #end
    #end
  #elseif($action == 'apercu suppression')
    #set($deletionRequestedRef = "$!request.getParameter('source_ref')")
    #collectDeletionPreview($deletionRequestedRef)
    <div id="deletion-preview-data" data-ref="#docOutput($deletionRequestedRef)" data-complete="$deletionComplete" data-message="#docOutput($deletionMessage)"></div>
    <span id="architecture-icon-folder-template" style="display:none;">$services.icon.renderHTML('folder')</span>
    <span id="architecture-icon-document-template" style="display:none;">$services.icon.renderHTML('file')</span>
    #if($deletionComplete)
      #foreach($deletionNode in $deletionNodes)
        <div class="deletion-node-data" data-ref="#docOutput($deletionNode.get('ref'))" data-parent-ref="#docOutput($deletionNode.get('parentRef'))" data-title="#docOutput($deletionNode.get('title'))" data-type="#docOutput($deletionNode.get('type'))" data-version="#docOutput($deletionNode.get('version'))"></div>
      #end
      <textarea id="deletion-preview-snapshot">#docOutput($deletionSnapshot)</textarea>
    #end
  #elseif($action == 'propositions' || $action == 'corbeille')
    #set($listedSpace = $proposalSpace)
    #if($action == 'corbeille')
      #set($listedSpace = $trashSpace)
    #end
    #if($isAuthenticated && ($canPropose || $canImport || $canReview))
      #set($listedRefs = $services.query.hql('select doc.fullName from XWikiDocument doc, BaseObject obj where obj.name = doc.fullName and obj.className = :className and doc.space = :space order by doc.creationDate').bindValue('className', $proposalClassPath).bindValue('space', $listedSpace).execute())
      #foreach($listedRef in $listedRefs)
        #checkProposalRef($listedRef $listedSpace)
        #if($validProposalRef)
          #set($listedDoc = false)
          #set($listedDoc = $xwiki.getDocumentAsAuthor($listedRef))
          #set($listedObject = false)
          #if($listedDoc)
            #set($listedObject = $listedDoc.getObject($proposalClassPath))
          #end
          #set($showProposal = $listedObject && ($canReview || "$!listedObject.getValue('author')" == $currentUser))
          #set($listedCanRestore = $listedObject && ($canReview || ("$!listedObject.getValue('author')" == $currentUser && ($canPropose || ($canImport && "$!listedObject.getValue('operation')" == 'import')))))
          #set($listedCanEdit = $listedCanRestore && "$!listedObject.getValue('status')" == 'pending' && "$!listedObject.getValue('operation')" != 'delete')
          #set($deletedLabel = '')
          #set($expiresLabel = '')
          #if($showProposal && $listedSpace == $trashSpace)
            #set($deletedDate = false)
            #set($deletedDate = $listedObject.getValue('deletedAt'))
            #set($showProposal = $deletedDate && $deletedDate.time > $trashCutoff && "$!listedObject.getValue('status')" == 'rejected')
            #if($showProposal)
              #set($deletedLabel = $xwiki.formatDate($deletedDate, 'dd/MM/yyyy HH:mm'))
              #set($expiresCalendar = $datetool.toCalendar($deletedDate))
              #set($discard = $expiresCalendar.add(5, 7))
              #set($expiresLabel = $xwiki.formatDate($expiresCalendar.time, 'dd/MM/yyyy HH:mm'))
            #end
          #elseif($showProposal)
            #set($showProposal = "$!listedObject.getValue('status')" == 'pending')
          #end
          #if($showProposal)
            #set($overlayParentRef = "$!listedObject.getValue('parentRef')")
            #set($overlayParentProposalRef = "$!listedObject.getValue('parentProposalRef')")
            #if($overlayParentRef == '' && ("$!listedObject.getValue('operation')" == 'modify' || "$!listedObject.getValue('operation')" == 'content'))
              #set($overlaySourceDoc = $xwiki.getDocumentAsAuthor("$!listedObject.getValue('sourceRef')"))
              #if($overlaySourceDoc && !$overlaySourceDoc.isNew())
                #set($overlayParentRef = "$!overlaySourceDoc.parent")
              #end
            #end
            #checkProposalRef($overlayParentProposalRef $proposalSpace)
            #if($validProposalRef)
              #set($overlayParentDoc = false)
              #set($overlayParentDoc = $xwiki.getDocumentAsAuthor($overlayParentProposalRef))
              #set($overlayParentObject = false)
              #if($overlayParentDoc)
                #set($overlayParentObject = $overlayParentDoc.getObject($proposalClassPath))
              #end
              #if($overlayParentObject && "$!overlayParentObject.getValue('status')" == 'accepted')
                #set($overlayParentRef = "$!overlayParentObject.getValue('publishedRef')")
                #set($overlayParentProposalRef = '')
              #end
            #end
            <span class="doc-proposal-data" data-ref="#docOutput($listedRef)" data-kind="#docOutput("$!listedObject.getValue('kind')")" data-operation="#docOutput("$!listedObject.getValue('operation')")" data-type="#docOutput("$!listedObject.getValue('type')")" data-title="#docOutput("$!listedObject.getValue('title')")" data-parent-ref="#docOutput($overlayParentRef)" data-parent-proposal-ref="#docOutput($overlayParentProposalRef)" data-source-ref="#docOutput("$!listedObject.getValue('sourceRef')")" data-author="#docOutput("$!listedObject.getValue('author')")" data-submitted-at="$xwiki.formatDate($listedObject.getValue('submittedAt'), 'dd/MM/yyyy HH:mm')" data-batch-id="#docOutput("$!listedObject.getValue('batchId')")" data-status="#docOutput("$!listedObject.getValue('status')")" data-can-restore="$listedCanRestore" data-can-edit="$listedCanEdit" data-url="#docOutput($listedDoc.getURL('view'))" data-url-preview="#docOutput($listedDoc.getURL('view', 'xpage=print'))" data-version="#docOutput("$listedDoc.version")" data-description="#docOutput("$!listedObject.getValue('description')")" data-tags="#docOutput("$!listedObject.getValue('tags')")" data-review-comment="#docOutput("$!listedObject.getValue('reviewComment')")" data-deleted-at="#docOutput($deletedLabel)" data-expires-at="#docOutput($expiresLabel)"></span>
          #end
        #end
      #end
    #end
  ## ============================================================
  ## RESOLUTION SECURISEE DU CHEMIN SAISI DANS L'EXPLORATEUR
  ## ============================================================
  #elseif($action == "resolvePath")
    #set($segments = $request.getParameterValues('segment'))
    #set($rootDoc = $xwiki.getDocument($mainParent))
    #set($currentRef = $mainParent)
    #set($currentDoc = $rootDoc)
    #set($pathValid = true)
    #set($hasSegment = false)

    #if($segments)
      #foreach($segment in $segments)
        #if("$!segment" != "")
          #set($hasSegment = true)

          ## Le premier segment peut être le nom visible de la racine.
          #if($foreach.index == 0 && ("$segment" == "$rootDoc.displayTitle" || "$segment" == "doc-test"))
            ## Rien à faire : on est déjà sur la racine.
          #else
            #set($matchedRef = "")

            #foreach($candidateRef in $currentDoc.getChildren())
              #set($candidateDoc = $xwiki.getDocument($candidateRef))
              #set($candidateObj = false)
              #set($candidateObj = $candidateDoc.getObject($className))
              #set($candidateType = "")

              #if($candidateObj)
                #set($candidateType = "$!candidateObj.getValue('type')")
              #end

              ## La barre de chemin sert à naviguer dans des dossiers.
              #if($candidateType == "folder" && $xwiki.hasAccessLevel("view", $xcontext.user, $candidateRef))
                #set($candidateClean = "$candidateRef")
                #if($candidateClean.endsWith(".WebHome"))
                  #set($candidateClean = $candidateClean.substring(0, $candidateClean.length() - 8))
                #end

                #set($candidateDot = $candidateClean.lastIndexOf("."))
                #if($candidateDot >= 0)
                  #set($candidateTechnicalName = $candidateClean.substring($candidateDot + 1))
                #else
                  #set($candidateTechnicalName = $candidateClean)
                #end

                ## Accepte le titre visible ou le nom technique XWiki.
                #if("$candidateDoc.displayTitle" == "$segment" || "$candidateTechnicalName" == "$segment")
                  #set($matchedRef = "$candidateRef")
                  #break
                #end
              #end
            #end

            #if("$matchedRef" == "")
              #set($pathValid = false)
              #break
            #else
              #set($currentRef = $matchedRef)
              #set($currentDoc = $xwiki.getDocument($currentRef))
            #end
          #end
        #end
      #end
    #else
      #set($pathValid = false)
    #end

    #if($pathValid && $hasSegment)
      <div id="path-resolution"
           data-status="ok"
           data-ref="#docOutput($currentRef)"
           style="display:none"></div>
      PATH_OK
    #else
      <div id="path-resolution"
           data-status="invalid"
           style="display:none"></div>
      PATH_NOT_FOUND
    #end

  ## ============================================================
  ## DONNEES POUR LA VUE ARCHITECTURE
  ## ============================================================
  #elseif($action == "architecture")
    <div id="architecture-data">
      ## Modèles d'icônes natifs XWiki récupérés ensuite par le JavaScript.
      <span id="architecture-icon-folder-template" style="display:none;">$services.icon.renderHTML('folder')</span>
      <span id="architecture-icon-document-template" style="display:none;">$services.icon.renderHTML('file')</span>

      #set($treeQueue = [])
      #set($ignore = $treeQueue.add($mainParent))

      #foreach($treeIndex in [0..500])
        #if($treeIndex < $treeQueue.size())
          #set($treeRef = $treeQueue.get($treeIndex))
          #set($treeDoc = $xwiki.getDocument($treeRef))
          #set($treeType = "")
          #set($treeParentRef = "")

          #if($treeRef == $mainParent)
            #set($treeType = "root")
          #else
            #set($treeObj = false)
              #set($treeObj = $treeDoc.getObject($className))
            #if($treeObj)
              #set($treeType = "$!treeObj.getValue('type')")
            #end
            #set($treeParentRef = "$!treeDoc.getParent()")
          #end

          #checkDocumentationRef($treeRef)
          #if($validDocumentationRef && $xwiki.hasAccessLevel("view", $xcontext.user, $treeRef) && ($treeType == "root" || $treeType == "folder" || $treeType == "document"))
            #set($treeDescription = "")
            #set($treeTags = "")
            #set($treeCreator = "")
            #set($treeCreated = "")
            #set($treeModified = "")
            #set($treeUrl = "")
            #set($treeUrlPreview = "")

            #if($treeType == "document" && $treeObj)
              #set($treeDescription = "$!treeObj.getValue('description')")
              #set($treeTags = "$!treeObj.getValue('tag')")
              #set($treeCreator = "$!treeObj.getValue('createur')")
              #set($treeCreated = $xwiki.formatDate($treeDoc.creationDate, 'dd/MM/yyyy HH:mm'))
              #set($treeModified = $xwiki.formatDate($treeDoc.date, 'dd/MM/yyyy HH:mm'))
              #set($treeUrl = $treeDoc.getURL('view'))
              #set($treeUrlPreview = $treeDoc.getURL('view', 'xpage=print'))
            #end

            <div class="architecture-node-data"
                 data-ref="#docOutput($treeRef)"
                 data-version="#docOutput("$treeDoc.version")"
                 data-parent-ref="#docOutput($treeParentRef)"
                 data-title="#docOutput($treeDoc.displayTitle)"
                 data-type="#docOutput($treeType)"
                 data-desc="#docOutput($treeDescription)"
                 data-tags="#docOutput($treeTags)"
                 data-creator="#docOutput($treeCreator)"
                 data-created="#docOutput($treeCreated)"
                 data-modified="#docOutput($treeModified)"
                 data-url="#docOutput($treeUrl)"
                 data-url-preview="#docOutput($treeUrlPreview)"></div>

            #if($treeType == "root" || $treeType == "folder")
              #foreach($treeChildRef in $treeDoc.getChildren())
                #set($treeChildDoc = $xwiki.getDocument($treeChildRef))
                #set($treeChildObj = false)
              #set($treeChildObj = $treeChildDoc.getObject($className))
                #if($treeChildObj)
                  #set($treeChildType = "$!treeChildObj.getValue('type')")
                  #if($treeChildType == "folder" || $treeChildType == "document")
                    #set($ignore = $treeQueue.add($treeChildRef))
                  #end
                #end
              #end
            #end
          #end
        #end
      #end
    </div>

  ## ============================================================
  ## EXPLORATEUR NORMAL
  ## ============================================================
  #elseif($action == "recupContact")
    #set($parentRef = $request.get("childRef"))
    #checkDocumentationRef($parentRef)
    #if(!$validDocumentationRef || !$xwiki.hasAccessLevel("view", $xcontext.user, $parentRef))
      ERREUR_DROITS
    #else
    #set($parentDoc = $xwiki.getDocument($parentRef))

    <div id="pageData" parent-page="#docOutput($parentRef)">
      <h4>#docOutput($parentDoc.displayTitle)</h4>
    </div>

    <div class="explorer-search-toolbar">
      <div class="explorer-search-field">
        <input type="search"
               id="explorer-search-input"
               class="form-control"
               placeholder="Rechercher dans ce dossier et ses sous-dossiers"
               autocomplete="off" />
      </div>

      <select id="explorer-type-filter"
              class="form-control explorer-filter-select"
              aria-label="Filtrer par type">
        <option value="">Tous</option>
        <option value="document">Documents</option>
        <option value="folder">Dossiers</option>
      </select>

      <select id="explorer-tag-filter"
              class="form-control explorer-filter-select"
              aria-label="Filtrer par mot-clé"
              disabled>
        <option value="">Tags</option>
      </select>

      <button type="button"
              id="explorer-search-reset"
              class="explorer-search-reset"
              title="Effacer la recherche"
              aria-label="Effacer la recherche">×</button>

      <span id="explorer-search-count"
            class="explorer-search-count"
            aria-live="polite"></span>
    </div>

    <div class="explorer-management-toolbar">
      <div class="explorer-management-left">
        <button type="button" id="explorer-select-toggle" class="btn btn-default">Sélectionner</button>
        <button type="button" id="explorer-move-btn" class="btn btn-default" disabled>Déplacer</button>
        <button type="button" id="explorer-delete-btn" class="btn btn-danger" disabled>Supprimer</button>
        <button type="button" id="explorer-architecture-btn" class="btn btn-default">Architecture</button>
      </div>
      <span id="explorer-selection-count" class="explorer-selection-count"></span>
    </div>

    <div id="explorer-move-destination" class="explorer-move-destination" style="display:none;">
      <div>
        <strong>Déplacement en cours :</strong>
        <span id="explorer-move-title"></span>
      </div>
      <div class="explorer-move-destination-actions">
        <button type="button" id="explorer-move-here-btn" class="btn btn-primary">Déplacer ici</button>
        <button type="button" id="explorer-move-cancel-btn" class="btn btn-default">Annuler</button>
      </div>
    </div>

    #set($tryRefHistory = [$parentRef])
    #set($trouve = false)
    #set($tryRef = $parentRef)

    #foreach($niveau in [0..100])
      #if($tryRef == $mainParent)
        #set($trouve = true)
        #break
      #end

      #if(!$trouve)
        #set($tryDoc = $xwiki.getDocument($tryRef))
        #set($tryParent = $tryDoc.getParent())

        #if(!$tryParent || $tryParent == "" || $tryParent == $tryRef)
          #break
        #end

        #set($tryRef = $tryParent)

        #if(!$tryRefHistory.contains($tryRef))
          #set($ignore = $tryRefHistory.add($tryRef))
        #else
          #break
        #end
      #end
    #end

    #set($ignore = $collectiontool.reverseModifiable($tryRefHistory))

    #set($textPath = "")
    #foreach($tableRef in $tryRefHistory)
      #set($tableDoc = $xwiki.getDocument($tableRef))
      #if($foreach.index == 0)
        #set($textPath = $tableDoc.displayTitle)
      #else
        #set($textPath = "${textPath} > ${tableDoc.displayTitle}")
      #end
    #end

    <div class="breadcrumb-bar-shell">
      <div id="breadcrumb-wrapper">
        <div id="breadcrumb-container">
          #foreach($tableRef in $tryRefHistory)
            #set($tableDoc = $xwiki.getDocument($tableRef))
            <span class="folder" data-full-name="#docOutput($tableRef)">$escapetool.xml($tableDoc.displayTitle)</span>
            #if($foreach.hasNext)
              <span class="breadcrumb-separator">&rsaquo;</span>
            #end
          #end
        </div>

        <input type="text"
               id="breadcrumb-input"
               value="#docOutput($textPath)"
               data-valid-path="#docOutput($textPath)"
               autocomplete="off"
               spellcheck="false"
               style="display:none;" />

        <button type="button"
                id="breadcrumb-copy-btn"
                class="breadcrumb-copy-btn"
                title="Copier le chemin"
                aria-label="Copier le chemin">
          <span class="breadcrumb-copy-icon" aria-hidden="true">$services.icon.renderHTML('copy')</span>
        </button>
      </div>
    </div>

    <div id="breadcrumb-error"
         class="breadcrumb-error"
         role="alert"
         aria-live="polite"
         style="display:none;"></div>

    #set($children = $parentDoc.getChildren())

    <ul id="explorer-search-results"
        class="file-explorer-list explorer-search-results"
        style="display:none;"></ul>

    <ul id="explorer-current-list" class="file-explorer-list">
      #foreach($childRef in $children)
        #set($childDoc = $xwiki.getDocument($childRef))
        #set($metaobj = false)
              #set($metaobj = $childDoc.getObject($className))

        #checkDocumentationRef($childRef)
        #if($validDocumentationRef && $metaobj && $xwiki.hasAccessLevel("view", $xcontext.user, $childRef))
          #set($childType = "$!metaobj.getValue('type')")

          #if($childType == "folder")
            <li class="explorer-row"
                data-ref="#docOutput($childRef)"
                data-version="#docOutput("$childDoc.version")"
                data-title="#docOutput($childDoc.displayTitle)"
                data-desc=""
                data-tags=""
                data-type="folder">
              <label class="explorer-select-box">
                <input type="checkbox"
                       class="explorer-select-input"
                       data-ref="#docOutput($childRef)"
                data-version="#docOutput("$childDoc.version")"
                       data-title="#docOutput($childDoc.displayTitle)"
                       data-type="folder" />
              </label>
              <span class="folder folder-item"
                    data-full-name="#docOutput($childRef)"
                    data-version="#docOutput("$childDoc.version")"
                    data-title="#docOutput($childDoc.displayTitle)"
                    data-type="folder">
                $services.icon.renderHTML('folder') #docOutput($childDoc.displayTitle)
              </span>
            </li>

          #elseif($childType == "document")
            #set($description = "$!metaobj.getValue('description')")
            #set($tags = "$!metaobj.getValue('tag')")
            #set($creator = $metaobj.getValue('createur'))
            #set($created = $xwiki.formatDate($childDoc.creationDate, 'dd/MM/yyyy HH:mm'))
            #set($modified = $xwiki.formatDate($childDoc.date, 'dd/MM/yyyy HH:mm'))
            #set($docUrl = $childDoc.getURL('view'))
            #set($docUrlPreview = $childDoc.getURL('view', 'xpage=print'))

            <li class="explorer-row"
                data-ref="#docOutput($childRef)"
                data-version="#docOutput("$childDoc.version")"
                data-title="#docOutput($childDoc.displayTitle)"
                data-desc="#docOutput($description)"
                data-tags="#docOutput($tags)"
                data-type="document">
              <label class="explorer-select-box">
                <input type="checkbox"
                       class="explorer-select-input"
                       data-ref="#docOutput($childRef)"
                data-version="#docOutput("$childDoc.version")"
                       data-title="#docOutput($childDoc.displayTitle)"
                       data-type="document" />
              </label>
              <span class="document-item"
                    data-full-name="#docOutput($childRef)"
                    data-version="#docOutput("$childDoc.version")"
                    data-title="#docOutput($childDoc.displayTitle)"
                    data-type="document"
                    data-creator="#docOutput($creator)"
                    data-created="$created"
                    data-modified="$modified"
                    data-desc="#docOutput($description)"
                    data-tags="#docOutput($tags)"
                    data-url="$docUrl"
                    data-url-preview="$docUrlPreview">
                $services.icon.renderHTML('page') #docOutput($childDoc.displayTitle)
              </span>
            </li>
          #end
        #end
      #end
    </ul>

    <div id="explorer-search-empty"
         class="explorer-search-empty"
         style="display:none;">
      Aucun élément ne correspond à la recherche.
    </div>

    <div id="preview-sidebar" class="sidebar-preview">
      <div id="sidebar-drag-handle"></div>
      <div class="sidebar-header">
        <h3 id="sidebar-title">Nom du document</h3>
        <button id="sidebar-close" class="close-btn">&times;</button>
      </div>
      <div class="sidebar-body">
        <div class="sidebar-section" data-sidebar-section="information">
          <button type="button"
                  class="sidebar-section-toggle"
                  aria-expanded="false">
            <span>Informations</span>
            <span class="sidebar-section-chevron" aria-hidden="true"></span>
          </button>

          <div class="sidebar-section-content" style="display:none;">
            <div class="sidebar-info-grid">
              <div class="meta-group"><strong>Créateur :</strong> <span id="sidebar-creator"></span></div>
              <div class="meta-group"><strong>Créé le :</strong> <span id="sidebar-created"></span></div>
              <div class="meta-group"><strong>Modifié le :</strong> <span id="sidebar-modified"></span></div>
            </div>
          </div>
        </div>

        <div class="sidebar-section" data-sidebar-section="metadata">
          <button type="button"
                  class="sidebar-section-toggle"
                  aria-expanded="false">
            <span>Description et mots-clés</span>
            <span class="sidebar-section-chevron" aria-hidden="true"></span>
          </button>

          <div class="sidebar-section-content" style="display:none;">
            <div class="sidebar-editable-section">
              <label for="sidebar-desc-input">Description</label>
              <textarea id="sidebar-desc-input"
                        class="sidebar-desc-input"
                        rows="4"
                        maxlength="4000"
                        placeholder="Ajouter une description au document"></textarea>
            </div>

            <div class="sidebar-editable-section">
              <label for="sidebar-tag-input">Mots-clés</label>
              <div id="sidebar-tags-list" class="sidebar-tags-list"></div>
              <div class="sidebar-tag-entry">
                <input id="sidebar-tag-input"
                       class="sidebar-tag-input"
                       type="text"
                       maxlength="80"
                       autocomplete="off"
                       placeholder="Ajouter un mot-clé" />
                <button id="sidebar-tag-add"
                        type="button"
                        class="sidebar-tag-add-btn">Ajouter</button>
              </div>
              <p class="sidebar-field-help">Entrée ou virgule pour ajouter un mot-clé.</p>
            </div>

            <div class="sidebar-metadata-actions">
              <button id="sidebar-metadata-save"
                      type="button"
                      class="sidebar-metadata-save-btn">Enregistrer</button>
              <span id="sidebar-metadata-status"
                    class="sidebar-metadata-status"
                    aria-live="polite"></span>
            </div>
          </div>
        </div>

        <div class="sidebar-section sidebar-section-preview is-open"
             data-sidebar-section="preview">
          <button type="button"
                  class="sidebar-section-toggle"
                  aria-expanded="true">
            <span>Aperçu</span>
            <span class="sidebar-section-chevron" aria-hidden="true"></span>
          </button>

          <div class="sidebar-section-content sidebar-preview-content" style="display:flex;">
            <div class="preview-frame-container">
              <div class="iframe-wrapper">
                <iframe id="sidebar-iframe" src="" frameborder="0"></iframe>
                <div class="zoom-controls">
                  <button id="btn-zoom-out" class="zoom-btn" title="Dézoomer">-</button>
                  <span id="zoom-level">80%</span>
                  <button id="btn-zoom-in" class="zoom-btn" title="Zoomer">+</button>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="sidebar-footer">
        #if($canContent || $canPropose)
          <button type="button" id="doc-content-edit" class="btn btn-default">Modifier le contenu</button>
        #end
        <a id="sidebar-open-btn" href="#" class="open-doc-btn" target="_blank">Ouvrir le document</a>
      </div>
    </div>

    #end
  #else
    ERREUR_ACTION
  #end
#else
  ERREUR_METHOD
#end
{{/html}}
{{/velocity}}
