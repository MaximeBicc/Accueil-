{{velocity}}
#set($classPath = "TestPage.PAGE.Glossaire.CODE.glossaireClass.WebHome")
#set($dataSpace = "TestPage.PAGE.Glossaire.DATA")
#set($action = "$!request.action")

## Cette page sert d'endpoint AJAX pour le tableau du glossaire.
## Un accès normal à DATA ne doit pas être refusé : le CSRF n'est contrôlé
## que lorsqu'une vraie opération d'écriture (save/delete) est demandée.
#if($action != "save" && $action != "delete")
GLOSSAIRE_READY
#else
  #set($csrfToken = $request.getParameter("form_token"))

  #if(!$csrfToken || !$services.csrf.isTokenValid($csrfToken))
GLOSSAIRE_ERROR|Jeton CSRF invalide ou absent
  #elseif($action == "save")
    #set($targetRef = "$!request.targetRef")
    #set($targetDoc = $xwiki.getDocument($targetRef))

    #if($targetDoc.isNew())
GLOSSAIRE_ERROR|Document introuvable
    #else
      #set($glossaireObj = $targetDoc.getObject($classPath))

      #if(!$glossaireObj)
GLOSSAIRE_ERROR|Objet glossaire introuvable
      #elseif(!$request.acronym || !$request.label || !$request.definition)
GLOSSAIRE_ERROR|Données incomplètes
      #else
        #set($oldAcronym = "$!glossaireObj.getValue('acronyme')")
        #set($newAcronym = $request.acronym.trim())
        #set($newLabel = $request.label.trim())
        #set($newDefinition = $request.definition.trim())

        #if($newAcronym == "")
GLOSSAIRE_ERROR|L'acronyme ne peut pas être vide
        #else
          ## Mise à jour des données avant le renommage.
          #set($discard = $glossaireObj.set("acronyme", $newAcronym))
          #set($discard = $glossaireObj.set("libelle", $newLabel))
          #set($discard = $glossaireObj.set("definition", $newDefinition))
          #set($discard = $targetDoc.setTitle($newAcronym))
          #set($discard = $targetDoc.save("Modification via interface Glossaire", true))

          ## Par défaut la référence reste celle reçue du navigateur.
          #set($finalRef = $targetRef)
          #set($finalDocName = $targetDoc.getName())

          ## On ne renomme techniquement la page que si l'acronyme a réellement changé.
          #if($newAcronym != $oldAcronym)
            #set($candidateName = $xwiki.cleanName($newAcronym))
            #set($baseCandidateName = $candidateName)

            ## Les pages renommées sont adressées explicitement en page imbriquée
            ## (...Nom.WebHome). C'est important : après un premier renommage XWiki,
            ## renvoyer seulement ...Nom pointe parfois vers une référence différente.
            #set($candidateRef = "${dataSpace}.${candidateName}.WebHome")
            #set($candidateTerminalRef = "${dataSpace}.${candidateName}")
            #set($counter = 1)
            #set($nameAvailable = false)

            #foreach($i in [1..100])
              #set($nestedCandidateDoc = $xwiki.getDocument($candidateRef))
              #set($terminalCandidateDoc = $xwiki.getDocument($candidateTerminalRef))
              #set($nestedOccupied = !$nestedCandidateDoc.isNew() && $candidateRef != $targetRef)
              #set($terminalOccupied = !$terminalCandidateDoc.isNew() && $candidateTerminalRef != $targetRef)

              #if(!$nestedOccupied && !$terminalOccupied)
                #set($nameAvailable = true)
                #break
              #else
                #set($candidateName = "${baseCandidateName}_${counter}")
                #set($candidateRef = "${dataSpace}.${candidateName}.WebHome")
                #set($candidateTerminalRef = "${dataSpace}.${candidateName}")
                #set($counter = $counter + 1)
              #end
            #end

            #if(!$nameAvailable)
GLOSSAIRE_ERROR|Impossible de trouver un nom de page disponible
            #else
              ## Destination explicite, avec WebHome, afin que la référence retournée
              ## soit exactement celle que le second clic sur Sauver devra réutiliser.
              #set($sourceReference = $services.model.resolveDocument($targetRef))
              #set($targetReference = $services.model.resolveDocument($candidateRef))
              #set($renameJob = $services.refactoring.rename($sourceReference, $targetReference))
              #set($discard = $renameJob.join())

              #set($finalRef = $candidateRef)
              #set($finalDocName = "${candidateName}.WebHome")
GLOSSAIRE_OK|$finalRef|$finalDocName
            #end
          #else
GLOSSAIRE_OK|$finalRef|$finalDocName
          #end
        #end
      #end
    #end
  #elseif($action == "delete")
    #set($targetRef = "$!request.targetRef")
    #set($targetDoc = $xwiki.getDocument($targetRef))

    #if($targetDoc.isNew())
GLOSSAIRE_ERROR|Document introuvable
    #else
      #set($sourceReference = $services.model.resolveDocument($targetRef))
      #set($deleteJob = $services.refactoring.delete($sourceReference))
      #set($discard = $deleteJob.join())
GLOSSAIRE_OK
    #end
  #end
#end
{{/velocity}}
