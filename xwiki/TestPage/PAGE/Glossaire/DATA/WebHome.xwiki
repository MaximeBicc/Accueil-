      #end
    #end

    #set($glossaireAclTrustedUsers = '')
    #foreach($gaclTrustedReference in $gaclTrustedReferences)
      #set($gaclTrustedName = $services.model.serialize($gaclTrustedReference, 'default'))
      ## Les listes natives sont séparées par des virgules. Protéger aussi
      ## les antislashs utilisés par la sérialisation des références XWiki.
      #set($gaclTrustedName = $gaclTrustedName.replace('\', '\\').replace(',', '\,'))
      #if($glossaireAclTrustedUsers == '')
