    #foreach($identityField in ['acronyme', 'libelle', 'definition', 'author', 'submittedAt'])
      #if($sameProposal && "$!destinationObject.getValue($identityField)" != "$!sourceObject.getValue($identityField)")
        #set($sameProposal = false)
      #end
    #end
    #if(!$sameProposal)
      #set($moveError = 'La destination de corbeille existe déjà et ne correspond pas à cette décision')
    #end
  #else
    #set($destinationObject = $destinationDoc.newObject($proposalClassPath))
    #if(!$destinationObject)
      #set($moveError = "La classe des propositions n'est pas installée")
    #else
      #copyGlossaireProposalFields($sourceObject $destinationObject)
      #set($discard = $destinationObject.set('sourceProposalId', $sourceDoc.name))
      #set($discard = $destinationObject.set('status', $trashStatus))
      #set($discard = $destinationObject.set('reviewComment', $moveComment))
      #set($discard = $destinationObject.set('reviewer', $currentUser))
      #set($discard = $destinationObject.set('reviewedAt', $now))
      #set($discard = $destinationObject.set('deletedAt', $now))
      #set($preparedTrashMillis = -1)
      #set($preparedTrashDate = false)
      #set($preparedTrashDate = $destinationObject.getValue('deletedAt'))
