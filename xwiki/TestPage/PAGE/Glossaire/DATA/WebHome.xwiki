#set($classPath = "TestPage.PAGE.Glossaire.CODE.glossaireClass.WebHome")
#set($dataSpace = "TestPage.PAGE.Glossaire.DATA")
#set($dataSpaces = ['TestPage', 'PAGE', 'Glossaire', 'DATA'])

## IMPORTANT : ne pas utiliser $request.action ici.
## Dans XWiki, "action" peut représenter l'action de page (view/edit) au lieu
## du paramètre POST envoyé par fetch(). On lit donc explicitement le paramètre.
#set($actionParam = $request.getParameter("action"))
#set($action = "$!actionParam")

## Cette page sert d'endpoint AJAX pour le tableau du glossaire.
#if($action != "save" && $action != "delete" && $action != "import")
GLOSSAIRE_READY
#else
  #set($csrfToken = $request.getParameter("form_token"))

  #if(!$csrfToken || !$services.csrf.isTokenValid($csrfToken))
GLOSSAIRE_ERROR|Jeton CSRF invalide ou absent

  #elseif($action == "save")
    #set($targetRef = "$!request.getParameter('targetRef')")
    #set($targetDoc = $xwiki.getDocument($targetRef))

    #if($targetDoc.isNew())
GLOSSAIRE_ERROR|Document introuvable
    #else
      #set($glossaireObj = $targetDoc.getObject($classPath))

      #set($acronymParam = $request.getParameter("acronym"))
      #set($labelParam = $request.getParameter("label"))
      #set($definitionParam = $request.getParameter("definition"))

      #if(!$glossaireObj)
GLOSSAIRE_ERROR|Objet glossaire introuvable
      #elseif(!$acronymParam || !$labelParam || !$definitionParam)
GLOSSAIRE_ERROR|Données incomplètes
      #else
        ## Pas de .trim() côté Velocity : cette instance XWiki les rejette.
        ## Les champs sont déjà nettoyés côté JavaScript avant l'envoi.
        #set($oldAcronym = "$!glossaireObj.getValue('acronyme')")
        #set($newAcronym = "$!acronymParam")
        #set($newLabel = "$!labelParam")
        #set($newDefinition = "$!definitionParam")

        #if($newAcronym == "")
GLOSSAIRE_ERROR|L'acronyme ne peut pas être vide
        #else
          #set($workingDoc = $targetDoc)
          #set($workingObj = $glossaireObj)
          #set($renameError = "")

          #if($newAcronym != $oldAcronym)
            #set($baseCandidateName = $newAcronym)

            #if(!$baseCandidateName || $baseCandidateName == "" || $baseCandidateName.contains('$') || $baseCandidateName.contains('{') || $baseCandidateName.contains('}') || $baseCandidateName.contains('/'))
              #set($renameError = "Nom technique d'acronyme invalide")
            #else
              #set($sourceReference = $services.model.resolveDocument($targetRef))
              #set($candidateName = $baseCandidateName)
              #set($counter = 1)
              #set($nameAvailable = false)
              #set($candidateReference = false)

              #foreach($i in [1..100])
                #set($terminalCandidateReference = $services.model.createDocumentReference('', $dataSpaces, $candidateName))
