## Fragment à intégrer dans DATA, avant le traitement des actions.
## Contrat : errorMessage est global et initialisé à '' par le service.
## newViewRefs : union cumulative des groupes autorisés à lire.
## newAddRefs : union des groupes ajout direct + validation.
## Ces deux paramètres contiennent des DocumentReference validées côté serveur.
## XWikiGuest est accepté uniquement dans la première liste (droit de lecture).
## Les écritures ci-dessous utilisent save() ; XWiki peut aussi contrôler les
## droits de l'auteur effectif du script avant de les accepter.

#macro(applyGlossaireNativeRights $aclDocument $aclClassName $aclProtectedScript $aclPrivateScope)
  #if($errorMessage == '')
    #if(!$aclDocument)
      #set($errorMessage = 'Une page à protéger est inaccessible')
    #elseif(!$xwiki.hasAccessLevel('edit', $xcontext.user, $services.model.serialize($aclDocument.documentReference, 'default')))
      #set($errorMessage = 'Droits insuffisants pour synchroniser les autorisations natives du glossaire')
    #else
      ## getObjects renvoie une copie des wrappers : removeObject ne modifie
      ## pas la collection sur laquelle cette boucle est en cours.
      #foreach($gaclRule in $aclDocument.getObjects($aclClassName))
        #set($gaclOldLevels = "$!gaclRule.getValue('levels')")
        #set($gaclKeptLevels = '')
        #foreach($gaclLevel in $gaclOldLevels.split('[,\s]+'))
          #if($gaclLevel != '' && $gaclLevel != 'view' && $gaclLevel != 'edit' && $gaclLevel != 'delete')
            #if($gaclKeptLevels == '')
              #set($gaclKeptLevels = $gaclLevel)
            #else
              #set($gaclKeptLevels = "$gaclKeptLevels,$gaclLevel")
            #end
          #end
        #end
        #if($gaclKeptLevels == '')
          #if(!$aclDocument.removeObject($gaclRule))
            #set($errorMessage = "Impossible de retirer une ancienne autorisation native du glossaire")
          #end
        #elseif($gaclKeptLevels != $gaclOldLevels)
          #set($discard = $gaclRule.set('levels', $gaclKeptLevels))
        #end
      #end

      #if($errorMessage == '')
        #set($gaclViewRule = false)
        #set($gaclWriteRule = false)
        #set($gaclViewRule = $aclDocument.newObject($aclClassName))
        #set($gaclWriteRule = $aclDocument.newObject($aclClassName))
        #if(!$gaclViewRule || !$gaclWriteRule)
          #set($errorMessage = "Les classes des autorisations natives XWiki ne sont pas disponibles")
        #else
          #set($gaclDocumentViewGroups = $glossaireAclViewGroups)
          #set($gaclDocumentViewUsers = $glossaireAclViewUsers)
          #if($aclPrivateScope)
            #set($gaclDocumentViewGroups = '')
            #set($gaclDocumentViewUsers = $glossaireAclTrustedUsers)
          #end
          #set($discard = $gaclViewRule.set('levels', 'view'))
          #set($discard = $gaclViewRule.set('groups', $gaclDocumentViewGroups))
          #set($discard = $gaclViewRule.set('users', $gaclDocumentViewUsers))
          #set($discard = $gaclViewRule.set('allow', 1))
          #set($discard = $gaclWriteRule.set('levels', 'edit,delete'))
          ## Les groupes utilisent l'interface contrôlée. Ne pas accorder
          ## d'édition native qui permettrait d'injecter du contenu dans une
          ## fiche ensuite sauvegardée au nom de l'auteur de confiance.
          #set($gaclDocumentWriteGroups = '')
          #if($aclProtectedScript || $aclPrivateScope)
            #set($gaclDocumentWriteGroups = '')
          #end
          #set($discard = $gaclWriteRule.set('groups', $gaclDocumentWriteGroups))
          #set($discard = $gaclWriteRule.set('users', $glossaireAclTrustedUsers))
          #set($discard = $gaclWriteRule.set('allow', 1))

          ## Détecter une classe absente ou une propriété non installée avant
          ## d'enregistrer. Une liste vide de groupes reste restrictive grâce
          ## aux utilisateurs de confiance explicitement conservés.
          #if("$!gaclViewRule.getValue('levels')" != 'view' || "$!gaclViewRule.getValue('groups')" != $gaclDocumentViewGroups || "$!gaclViewRule.getValue('users')" != $gaclDocumentViewUsers || "$!gaclViewRule.getValue('allow')" != '1' || "$!gaclWriteRule.getValue('levels')" != 'edit,delete' || "$!gaclWriteRule.getValue('groups')" != $gaclDocumentWriteGroups || "$!gaclWriteRule.getValue('users')" != $glossaireAclTrustedUsers || "$!gaclWriteRule.getValue('allow')" != '1')
            #set($errorMessage = "Impossible de préparer les autorisations natives du glossaire")
          #else
            #set($discard = $aclDocument.save('Synchronisation des autorisations du glossaire', true))
            ## XWiki peut restaurer silencieusement les anciennes règles si
            ## l'auteur du script n'a pas les droits nécessaires. Relire les
            ## vrais objets après save(), pas les wrappers préparés ci-dessus.
            #set($gaclSavedDocument = false)
            #set($gaclSavedDocument = $xwiki.getDocument($aclDocument.documentReference))
            #set($gaclSavedManagedCount = 0)
            #set($gaclSavedViewCount = 0)
            #set($gaclSavedWriteCount = 0)
            #if($gaclSavedDocument && !$gaclSavedDocument.isNew())
              #foreach($gaclSavedRule in $gaclSavedDocument.getObjects($aclClassName))
                #set($gaclSavedLevels = "$!gaclSavedRule.getValue('levels')")
                #set($gaclSavedHasManagedLevel = false)
                #foreach($gaclSavedLevel in $gaclSavedLevels.split('[,\s]+'))
                  #if($gaclSavedLevel == 'view' || $gaclSavedLevel == 'edit' || $gaclSavedLevel == 'delete')
                    #set($gaclSavedHasManagedLevel = true)
                  #end
                #end
                #if($gaclSavedHasManagedLevel)
                  #set($gaclSavedManagedCount = $gaclSavedManagedCount + 1)
                  #if($gaclSavedLevels == 'view' && "$!gaclSavedRule.getValue('groups')" == $gaclDocumentViewGroups && "$!gaclSavedRule.getValue('users')" == $gaclDocumentViewUsers && "$!gaclSavedRule.getValue('allow')" == '1')
                    #set($gaclSavedViewCount = $gaclSavedViewCount + 1)
                  #elseif($gaclSavedLevels == 'edit,delete' && "$!gaclSavedRule.getValue('groups')" == $gaclDocumentWriteGroups && "$!gaclSavedRule.getValue('users')" == $glossaireAclTrustedUsers && "$!gaclSavedRule.getValue('allow')" == '1')
                    #set($gaclSavedWriteCount = $gaclSavedWriteCount + 1)
                  #end
                #end
              #end
            #end
            #if($gaclSavedManagedCount == 2 && $gaclSavedViewCount == 1 && $gaclSavedWriteCount == 1)
              #set($glossaireAclUpdatedCount = $glossaireAclUpdatedCount + 1)
            #else
              #set($gaclFailedReference = $aclDocument.getFullName())
              #set($errorMessage = "Les autorisations natives n'ont pas été conservées pour $gaclFailedReference. Vérifiez les droits du compte qui a enregistré DATA, puis réessayez.")
            #end
          #end
        #end
      #end
    #end
  #end
#end

