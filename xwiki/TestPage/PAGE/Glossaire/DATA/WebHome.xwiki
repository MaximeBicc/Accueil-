            #end
          #end
        #end
      #end
    #end

  ## ========================================================================
  ## IMPORT EXCEL
  ## ========================================================================
  #elseif($action == "import")
    #set($allowAcronymDuplicates = "$!request.getParameter('allowAcronymDuplicates')" == "true")
    #set($allowLabelDuplicates = "$!request.getParameter('allowLabelDuplicates')" == "true")
    #set($createdCount = 0)
    #set($skippedCount = 0)
    #set($processedCount = 0)

    ## IMPORTANT : on ne parcourt plus une plage numérique Velocity.
    ## On parcourt directement TOUS les paramètres reçus et on traite chaque
    ## paramètre acronym_N. Ainsi le serveur ne peut plus s'arrêter à la ligne 0.
    #set($parameterMap = $request.getParameterMap())

    #foreach($parameterName in $parameterMap.keySet())
      #if($parameterName.startsWith("acronym_"))
        #set($processedCount = $processedCount + 1)
        #set($i = $parameterName.substring(8))
        #set($labelParameterName = "label_$i")
        #set($definitionParameterName = "definition_$i")

        #set($importAcronymRaw = $request.getParameter($parameterName))
        #set($importLabelRaw = $request.getParameter($labelParameterName))
        #set($importDefinitionRaw = $request.getParameter($definitionParameterName))

        ## Aucun .trim() côté Velocity.
        #set($importAcronym = "$!importAcronymRaw")
        #set($importLabel = "$!importLabelRaw")
        #set($importDefinition = "$!importDefinitionRaw")

        #if(!$importAcronymRaw || !$importLabelRaw || !$importDefinitionRaw || $importAcronym == "" || $importLabel == "" || $importDefinition == "")
ROW_ERROR|$i|Données incomplètes
          #set($skippedCount = $skippedCount + 1)
        #elseif($importAcronym.contains('$') || $importAcronym.contains('{') || $importAcronym.contains('}') || $importAcronym.contains('/'))
ROW_ERROR|$i|Nom technique d'acronyme invalide
          #set($skippedCount = $skippedCount + 1)
        #else
          ## Vérification des doublons contre le glossaire, y compris les lignes
          ## déjà créées plus tôt dans ce même import.
          #set($acronymExists = false)
          #set($labelExists = false)
          #set($existingDocNames = $xwiki.getSpaceDocsName($dataSpace))

          #foreach($existingDocName in $existingDocNames)
            #set($existingRef = "${dataSpace}.${existingDocName}")
            #set($existingDoc = $xwiki.getDocument($existingRef))
            #set($existingObj = $existingDoc.getObject($classPath))

            #if($existingObj)
              #set($existingAcronym = "$!existingObj.getValue('acronyme')")
              #set($existingLabel = "$!existingObj.getValue('libelle')")

              #if($existingAcronym.equalsIgnoreCase($importAcronym))
                #set($acronymExists = true)
              #end
              #if($existingLabel.equalsIgnoreCase($importLabel))
                #set($labelExists = true)
              #end
            #end
          #end

          #set($blockedByAcronym = $acronymExists && !$allowAcronymDuplicates)
          #set($blockedByLabel = $labelExists && !$allowLabelDuplicates)

          #if($blockedByAcronym || $blockedByLabel)
            #if($blockedByAcronym && $blockedByLabel)
ROW_SKIP|$i|ACRONYM_AND_LABEL_DUPLICATE
            #elseif($blockedByAcronym)
ROW_SKIP|$i|ACRONYM_DUPLICATE
            #else
ROW_SKIP|$i|LABEL_DUPLICATE
            #end
            #set($skippedCount = $skippedCount + 1)
          #else
            #set($baseCandidateName = $importAcronym)
            #set($candidateName = $baseCandidateName)
            #set($counter = 1)
            #set($candidateReference = false)

            #foreach($n in [1..100])
              #set($terminalReference = $services.model.createDocumentReference('', $dataSpaces, $candidateName))
              #set($nestedSpaces = ['TestPage', 'PAGE', 'Glossaire', 'DATA', $candidateName])
              #set($nestedReference = $services.model.createDocumentReference('', $nestedSpaces, 'WebHome'))
              #set($terminalDoc = $xwiki.getDocument($terminalReference))
              #set($nestedDoc = $xwiki.getDocument($nestedReference))

              #if($terminalDoc.isNew() && $nestedDoc.isNew())
                #set($candidateReference = $terminalReference)
                #break
              #else
                #set($suffix = "_$counter")
                #set($candidateName = "$baseCandidateName$suffix")
                #set($counter = $counter + 1)
              #end
            #end

            #if(!$candidateReference)
ROW_ERROR|$i|Impossible de trouver un nom de page disponible
              #set($skippedCount = $skippedCount + 1)
            #else
              #set($newDoc = $xwiki.getDocument($candidateReference))
              #set($newObj = $newDoc.newObject($classPath))
              #set($discard = $newObj.set("acronyme", $importAcronym))
              #set($discard = $newObj.set("libelle", $importLabel))
              #set($discard = $newObj.set("definition", $importDefinition))
              #set($discard = $newDoc.setTitle($importAcronym))
              #set($discard = $newDoc.save("Import Excel via interface Glossaire", true))

              #set($finalImportRef = $newDoc.getFullName())
              #set($finalImportName = $newDoc.getName())
ROW_OK|$i|$finalImportRef|$finalImportName
              #set($createdCount = $createdCount + 1)
            #end
          #end
        #end
      #end
    #end

    #if($processedCount == 0)
GLOSSAIRE_ERROR|Aucune ligne d'import reçue par le serveur
    #else
GLOSSAIRE_IMPORT_OK|$createdCount|$skippedCount|$processedCount
    #end

