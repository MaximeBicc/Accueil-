{{velocity}}
#set($classPath = "TestPage.PAGE.Glossaire.CODE.glossaireClass.WebHome")
#set($dataSpaces = ['TestPage', 'PAGE', 'Glossaire', 'DATA'])
#set($action = "$!request.action")

## Cette page sert d'endpoint AJAX pour le tableau du glossaire.
## Un accès normal à DATA ne doit pas être refusé : le CSRF n'est contrôlé
## que lorsqu'une vraie opération d'écriture (save/delete) est demandée.
#if($action != "save" && $action != "delete")
GLOSSAIRE_READY
#else
  #set($csrfToken = $request.getParameter("form_token"))

  #if(!$csrfToken || !$services.csrf.isTokenValid($csrfToken))
GLOSSAIRE_ERROR|Jeton CSRF invalide ou absent
  #elseif($action == "save")
    #set($targetRef = "$!request.targetRef")
    #set($targetDoc = $xwiki.getDocument($targetRef))

    #if($targetDoc.isNew())
GLOSSAIRE_ERROR|Document introuvable
    #else
      #set($glossaireObj = $targetDoc.getObject($classPath))

      #if(!$glossaireObj)
GLOSSAIRE_ERROR|Objet glossaire introuvable
      #elseif(!$request.acronym || !$request.label || !$request.definition)
GLOSSAIRE_ERROR|Données incomplètes
      #else
        #set($oldAcronym = "$!glossaireObj.getValue('acronyme')")
        #set($newAcronym = $request.acronym.trim())
        #set($newLabel = $request.label.trim())
        #set($newDefinition = $request.definition.trim())

        #if($newAcronym == "")
GLOSSAIRE_ERROR|L'acronyme ne peut pas être vide
        #else
          ## IMPORTANT : on travaille avec de vraies DocumentReference XWiki.
          ## Aucun chemin de renommage n'est construit avec ${...}, afin qu'une
          ## variable Velocity ne puisse jamais devenir littéralement un dossier.
          #set($workingDoc = $targetDoc)
          #set($workingObj = $glossaireObj)
          #set($renameError = "")

          #if($newAcronym != $oldAcronym)
            #set($baseCandidateName = $xwiki.cleanName($newAcronym))

            ## Garde-fou supplémentaire : un nom technique contenant une syntaxe
            ## de variable est refusé avant toute opération de refactoring.
            #if(!$baseCandidateName || $baseCandidateName == "" || $baseCandidateName.contains('$') || $baseCandidateName.contains('{') || $baseCandidateName.contains('}'))
              #set($renameError = "Nom technique d'acronyme invalide")
            #else
              #set($sourceReference = $services.model.resolveDocument($targetRef))
              #set($candidateName = $baseCandidateName)
              #set($counter = 1)
              #set($nameAvailable = false)
              #set($candidateReference = false)

              #foreach($i in [1..100])
                ## Une fiche du glossaire est une page imbriquée :
                ## DATA / NomAcronyme / WebHome.
                #set($candidateSpaces = ['TestPage', 'PAGE', 'Glossaire', 'DATA', $candidateName])
                #set($nestedCandidateReference = $services.model.createDocumentReference('', $candidateSpaces, 'WebHome'))
                #set($terminalCandidateReference = $services.model.createDocumentReference('', $dataSpaces, $candidateName))

                #set($nestedCandidateDoc = $xwiki.getDocument($nestedCandidateReference))
                #set($terminalCandidateDoc = $xwiki.getDocument($terminalCandidateReference))

                ## Une référence déjà occupée n'est autorisée que si c'est la
                ## fiche que nous sommes précisément en train de renommer.
                #set($nestedOccupied = !$nestedCandidateDoc.isNew() && !$nestedCandidateReference.equals($sourceReference))
                #set($terminalOccupied = !$terminalCandidateDoc.isNew() && !$terminalCandidateReference.equals($sourceReference))

                #if(!$nestedOccupied && !$terminalOccupied)
                  #set($nameAvailable = true)
                  #set($candidateReference = $nestedCandidateReference)
                  #break
                #else
                  #set($suffix = "_$counter")
                  #set($candidateName = "$baseCandidateName$suffix")
                  #set($counter = $counter + 1)
                #end
              #end

              #if(!$nameAvailable || !$candidateReference)
                #set($renameError = "Impossible de trouver un nom de page disponible")
              #elseif(!$candidateReference.equals($sourceReference))
                ## L'API reçoit deux références typées. Aucun nom de chemin n'est
                ## interpolé dans une chaîne lors du renommage.
                #set($renameJob = $services.refactoring.rename($sourceReference, $candidateReference))

                #if(!$renameJob)
                  #set($renameError = "Le service XWiki de renommage n'a pas pu démarrer")
                #else
                  #set($discard = $renameJob.join())

                  ## On recharge obligatoirement le document à sa destination réelle.
                  ## C'est cette référence, et uniquement elle, qui sera renvoyée au JS.
                  #set($renamedDoc = $xwiki.getDocument($candidateReference))
                  #if($renamedDoc.isNew())
                    #set($renameError = "Le document renommé est introuvable à sa destination")
                  #else
                    #set($renamedObj = $renamedDoc.getObject($classPath))
                    #if(!$renamedObj)
                      #set($renameError = "Objet glossaire introuvable après renommage")
                    #else
                      #set($workingDoc = $renamedDoc)
                      #set($workingObj = $renamedObj)
                    #end
                  #end
                #end
              #end
            #end
          #end

          #if($renameError != "")
GLOSSAIRE_ERROR|$renameError
          #else
            ## On modifie les données seulement APRÈS avoir sécurisé le renommage.
            ## Ainsi, un renommage échoué ne laisse pas l'acronyme enregistré sous
            ## un ancien chemin technique incohérent.
            #set($discard = $workingObj.set("acronyme", $newAcronym))
            #set($discard = $workingObj.set("libelle", $newLabel))
            #set($discard = $workingObj.set("definition", $newDefinition))
            #set($discard = $workingDoc.setTitle($newAcronym))
            #set($discard = $workingDoc.save("Modification via interface Glossaire", true))

            ## getFullName() provient du document réellement chargé par XWiki :
            ## on ne reconstitue jamais la référence côté serveur.
            #set($finalRef = $workingDoc.getFullName())
            #set($finalDocName = $workingDoc.getName())

            ## Dernier garde-fou avant de transmettre la référence au navigateur.
            #if(!$finalRef || $finalRef.contains('$') || $finalRef.contains('{') || $finalRef.contains('}'))
GLOSSAIRE_ERROR|Référence XWiki finale invalide
            #else
GLOSSAIRE_OK|$finalRef|$finalDocName
            #end
          #end
        #end
      #end
    #end
  #elseif($action == "delete")
    #set($targetRef = "$!request.targetRef")
    #set($targetDoc = $xwiki.getDocument($targetRef))

    #if($targetDoc.isNew())
GLOSSAIRE_ERROR|Document introuvable
    #else
      #set($sourceReference = $services.model.resolveDocument($targetRef))
      #set($deleteJob = $services.refactoring.delete($sourceReference))
      #set($discard = $deleteJob.join())
GLOSSAIRE_OK
    #end
  #end
#end
{{/velocity}}
