{{velocity}}
{{html}}
#set($classPath = "TestPage.PAGE.Glossaire.CODE.glossaireClass.WebHome")
#set($dataSpace = "TestPage.PAGE.Glossaire.DATA")

## Extensions JavaScript / CSS du module
$xwiki.jsx.use("TestPage.PAGE.Glossaire.CODE.GlossaireExtension")
$xwiki.jsx.use("TestPage.PAGE.Glossaire.CODE.GlossairePageExtension")
$xwiki.ssx.use("TestPage.PAGE.Glossaire.CODE.GlossaireExtension")

#set($createAction = $request.getParameter("action"))
#if("$!createAction" == "checkAndCreate" && $request.acronyme && $request.libelle && $request.definition)
  ## Aucun .trim() côté Velocity sur cette instance XWiki.
  #set($acronymeInput = "$!request.acronyme")
  #set($libelleInput = "$!request.libelle")
  #set($definitionInput = "$!request.definition")

  ## 1. Génération du nom technique de base
  #set($cleanName = $xwiki.cleanName($acronymeInput))
  #set($newPageRef = "${dataSpace}.${cleanName}")
  #set($newPage = $xwiki.getDocument($newPageRef))

  ## 2. Détection de doublon à des fins d'information (sans bloquer)
  #set($alreadyExists = false)
  #if(!$newPage.isNew())
    #set($alreadyExists = true)
  #end

  ## 3. Boucle de sécurité pour trouver un nom de page disponible
  #set($counter = 1)
  #set($basePageRef = $newPageRef)
  #foreach($i in [1..100])
    #if(!$newPage.isNew())
      #set($newPageRef = "${basePageRef}_${counter}")
      #set($newPage = $xwiki.getDocument($newPageRef))
      #set($counter = $counter + 1)
    #else
      #break
    #end
  #end

  ## 4. Création et population de l'objet
  #set($newObj = $newPage.newObject($classPath))
  #set($discard = $newObj.set("acronyme", $acronymeInput))
  #set($discard = $newObj.set("libelle", $libelleInput))
  #set($discard = $newObj.set("definition", $definitionInput))
  #set($discard = $newPage.setTitle($acronymeInput))
  #set($discard = $newPage.save("Ajout via interface Glossaire", true))

  ## 5. Notification après redirection
  #if($alreadyExists)
    $request.session.setAttribute('glossary_status', 'warning')
  #else
    $request.session.setAttribute('glossary_status', 'success')
  #end
  $request.session.setAttribute('glossary_msg', $acronymeInput)

  $response.sendRedirect($doc.getURL())
  #stop
#end

## --- NOTIFICATIONS POST-REDIRECTION ---
#set($status = $request.session.getAttribute('glossary_status'))
#if($status)
  #set($msg = $request.session.getAttribute('glossary_msg'))

  #if($status == 'success')
    <div class="alert alert-success glossary-status-alert">
      <strong>Succès !</strong> Le terme <strong>$msg</strong> a été ajouté à la base de données.
    </div>
  #elseif($status == 'warning')
    <div class="alert alert-warning glossary-status-alert">
      <strong>Information :</strong> L'acronyme <strong>$msg</strong> existait déjà. Une nouvelle fiche distincte a tout de même été créée avec succès.
    </div>
  #end

  $request.session.removeAttribute('glossary_status')
  $request.session.removeAttribute('glossary_msg')
#end

## --- BARRE D'ACTIONS ---
<div class="row glossary-toolbar">
  <div id="glossaryToolbarLeft" class="col-md-6 glossary-toolbar-left">
    <button type="button" class="btn btn-success" data-toggle="modal" data-target="#glossaryModal">
      + Ajouter un nouvel acronyme
    </button>
  </div>
  <div id="glossaryToolbarRight" class="col-md-6 glossary-toolbar-right"></div>
</div>

## --- PAGINATION ---
<div class="pagination-container">
  <div>
    <label for="pageSizeSelect" class="glossary-page-size-label">Éléments par page :</label>
    <select id="pageSizeSelect">
      <option value="5">5</option>
      <option value="10" selected>10</option>
      <option value="25">25</option>
      <option value="50">50</option>
      <option value="all">Tout afficher</option>
    </select>
  </div>

  <div class="glossary-pagination-actions">
    <button type="button" id="btnPrevPage" class="btn btn-default btn-sm glossary-pagination-button">
      <span class="glyphicon glyphicon-chevron-left"></span>
    </button>
    <span id="pageIndicator">Page 1 / 1</span>
    <button type="button" id="btnNextPage" class="btn btn-default btn-sm glossary-pagination-button">
      <span class="glyphicon glyphicon-chevron-right"></span>
    </button>
  </div>
</div>

## --- POPUP D'ACTION GÉNÉRIQUE ---
<div id="actionFeedbackModal" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-label="Fermer"><span aria-hidden="true">&times;</span></button>
        <h4 class="modal-title" id="feedbackModalTitle">Action Personnalisée</h4>
      </div>
      <div class="modal-body">
        <p id="feedbackModalBodyText">Contenu par défaut...</p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-default" data-dismiss="modal">Fermer</button>
      </div>
    </div>
  </div>
</div>

#set($urlGlossaireData = $xwiki.getURL("TestPage.PAGE.Glossaire.DATA.WebHome", "view"))

## --- TABLEAU PRINCIPAL ---
<div class="table-responsive">
  <table class="table table-striped table-hover table-bordered"
         id="mainGlossaryTable"
         data-csrf="$services.csrf.getToken()"
         data-class-path="$classPath"
         data-endpoint-url="$!urlGlossaireData">
    <thead>
      <tr>
        <th class="glossary-col-acronym">Acronyme</th>
        <th class="glossary-col-label">Libellé complet</th>
        <th class="glossary-col-definition">Définition</th>
        <th class="glossary-col-actions">Actions</th>
      </tr>
      <tr class="filter-row">
        <th>
          <div class="glossary-filter-layout">
            <input type="text" id="filterAcronym" class="glossary-filter-input" placeholder="Filtrer...">
            <button type="button"
                    class="btn btn-default btn-xs sort-column-btn active"
                    data-column="acronym"
                    data-sort-active="true"
                    data-sort-direction="asc"
                    title="Trier par acronyme">
              <span class="sort-label">A→Z</span>
            </button>
          </div>
        </th>
        <th>
          <div class="glossary-filter-layout">
            <input type="text" id="filterLabel" class="glossary-filter-input" placeholder="Filtrer...">
            <button type="button"
                    class="btn btn-default btn-xs sort-column-btn"
                    data-column="label"
                    data-sort-active="false"
                    data-sort-direction="asc"
                    title="Trier par libellé">
              <span class="sort-label">A→Z</span>
            </button>
          </div>
        </th>
        <th>
          <div class="glossary-filter-layout">
            <input type="text" id="filterDefinition" class="glossary-filter-input" placeholder="Filtrer...">
            <button type="button"
                    class="btn btn-default btn-xs sort-column-btn"
                    data-column="definition"
                    data-sort-active="false"
                    data-sort-direction="asc"
                    title="Trier par définition">
              <span class="sort-label">A→Z</span>
            </button>
          </div>
        </th>
        <th class="glossary-empty-filter"></th>
      </tr>
    </thead>
    <tbody>
      #set($allDocNames = $xwiki.getSpaceDocsName($dataSpace))
      #foreach($docName in $allDocNames)
        #set($fullRef = "${dataSpace}.${docName}")
        #set($tDoc = $xwiki.getDocument($fullRef))
        #set($tObj = $tDoc.getObject($classPath))
        #if($tObj)
          #set($acronymeValue = $!tObj.getValue('acronyme'))
          #set($libelleValue = $!tObj.getValue('libelle'))
          #set($definitionValue = $!tObj.getValue('definition'))

          <tr class="main-term-row"
              data-acronym="$!acronymeValue.toUpperCase()"
              data-doc-name="$!docName"
              data-full-ref="$!fullRef">
            <td class="main-acronym">
              <span class="view-mode"><strong>$!acronymeValue</strong></span>
              <input type="text" class="form-control edit-mode edit-acronym glossary-edit-field" value="$!acronymeValue">
            </td>
            <td class="main-label">
              <span class="view-mode">$!libelleValue</span>
              <input type="text" class="form-control edit-mode edit-label glossary-edit-field" value="$!libelleValue">
            </td>
            <td class="main-definition">
              <span class="view-mode">$!definitionValue</span>
              <textarea class="form-control edit-mode edit-definition glossary-edit-field" rows="2">$!definitionValue</textarea>
            </td>
            <td>
              <div class="view-buttons">
                <button type="button" class="btn btn-xs btn-primary custom-action-btn js-edit-row">
                  <span class="glyphicon glyphicon-pencil"></span>
                </button>
                <button type="button" class="btn btn-xs btn-danger custom-action-btn js-delete-row">
                  <span class="glyphicon glyphicon-trash"></span>
                </button>
              </div>
              <div class="edit-buttons glossary-edit-buttons">
                <button type="button" class="btn btn-xs btn-success js-save-row">
                  <span class="glyphicon glyphicon-ok"></span> Sauver
                </button>
                <button type="button" class="btn btn-xs btn-default js-cancel-row">
                  <span class="glyphicon glyphicon-remove"></span>
                </button>
              </div>
            </td>
          </tr>
        #end
      #end
    </tbody>
  </table>
</div>

## --- CONFIRMATION DE SUPPRESSION SIMPLE ---
<div class="modal fade" id="deleteConfirmModal" tabindex="-1" role="dialog" aria-hidden="true">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header glossary-delete-modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-label="Fermer"><span aria-hidden="true">&times;</span></button>
        <h4 class="modal-title" id="deleteModalTitle">Confirmer la suppression</h4>
      </div>
      <div class="modal-body">
        <p>Êtes-vous sûr de vouloir supprimer définitivement cet élément ainsi que sa page XWiki ?</p>
        <table class="table table-bordered table-condensed glossary-delete-preview-table">
          <thead>
            <tr>
              <th>Acronyme</th>
              <th>Libellé complet</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td id="deleteModalAcronym" class="glossary-delete-acronym"></td>
              <td id="deleteModalLabel"></td>
            </tr>
          </tbody>
        </table>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-default" data-dismiss="modal">Annuler</button>
        <button type="button" class="btn btn-danger" id="btnConfirmDelete">Supprimer</button>
      </div>
    </div>
  </div>
</div>

## --- MODALE DE CRÉATION ---
<div class="modal fade" id="glossaryModal" tabindex="-1" role="dialog" aria-labelledby="glossaryModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-label="Fermer"><span aria-hidden="true">&times;</span></button>
        <h4 class="modal-title" id="glossaryModalLabel">Nouveau terme du Glossaire</h4>
      </div>

      <form method="post" action="">
        <input type="hidden" name="action" value="checkAndCreate">

        <div class="modal-body">
          <div class="row">
            <div class="col-md-5 modal-left-column">
              <h5 class="column-title">Informations du terme</h5>

              <div class="form-group">
                <label>Acronyme / Sigle (ex: API) :</label>
                <input type="text"
                       id="acronymeInputField"
                       name="acronyme"
                       class="form-control"
                       autocomplete="off"
                       required
                       placeholder="Ex: XWIKI">
              </div>

              <div class="form-group">
                <label>Libellé complet :</label>
                <input type="text"
                       id="libelleInputField"
                       name="libelle"
                       class="form-control"
                       autocomplete="off"
                       required
                       placeholder="Ex: Wiki d'entreprise open source">
              </div>

              <div class="form-group">
                <label>Définition :</label>
                <textarea name="definition"
                          class="form-control"
                          rows="5"
                          required
                          placeholder="Description détaillée..."></textarea>
              </div>
            </div>

            <div class="col-md-7 modal-right-column">
              <h5 class="column-title warning-title">Vérification des existants</h5>
              <p class="text-muted help-text">Ce tableau affiche les lignes dont l'acronyme ou le libellé correspond à votre saisie.</p>

              <div class="table-scroll-container">
                <table class="table table-striped table-hover" id="popupCheckTable">
                  <thead>
                    <tr>
                      <th class="glossary-popup-acronym-col">Acronyme</th>
                      <th>Libellé complet</th>
                    </tr>
                  </thead>
                  <tbody>
                    #foreach($docName in $allDocNames)
                      #set($fullRef = "${dataSpace}.${docName}")
                      #set($tDoc = $xwiki.getDocument($fullRef))
                      #set($tObj = $tDoc.getObject($classPath))
                      #if($tObj)
                        <tr class="term-row" data-full-ref="$!fullRef">
                          <td class="term-acronym">$!tObj.getValue('acronyme')</td>
                          <td class="term-label">$!tObj.getValue('libelle')</td>
                        </tr>
                      #end
                    #end
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>

        <div class="modal-footer">
          <button type="button" class="btn btn-default" data-dismiss="modal">Annuler</button>
          <button type="submit" class="btn btn-primary">Valider et Vérifier l'existence</button>
        </div>
      </form>
    </div>
  </div>
</div>
{{/html}}
{{/velocity}}
