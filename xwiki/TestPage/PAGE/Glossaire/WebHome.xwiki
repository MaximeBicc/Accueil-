#set($classPath = "TestPage.PAGE.Glossaire.CODE.glossaireClass.WebHome")
#set($dataSpace = "TestPage.PAGE.Glossaire.DATA")

## Appel des extensions de peau (Skin Extensions) JavaScript et CSS
$xwiki.jsx.use("TestPage.PAGE.Glossaire.CODE.GlossaireExtension")
$xwiki.ssx.use("TestPage.PAGE.Glossaire.CODE.GlossaireExtension")

#if("$!request.action" == "checkAndCreate" && $request.acronyme && $request.libelle && $request.definition)
  #set($acronymeInput = $request.acronyme.trim())
  #set($libelleInput = $request.libelle.trim())
  #set($definitionInput = $request.definition.trim())

  ## 1. Génération du nom technique de base
  #set($cleanName = $xwiki.cleanName($acronymeInput))
  #set($newPageRef = "${dataSpace}.${cleanName}")
  #set($newPage = $xwiki.getDocument($newPageRef))

  ## 2. Détection de doublon à des fins d'information (sans bloquer)
  #set($alreadyExists = false)
  #if(!$newPage.isNew())
    #set($alreadyExists = true)
  #end

  ## 3. Boucle de sécurité pour trouver un nom de page disponible (ex: API_1, API_2)
  #set($counter = 1)
  #set($basePageRef = $newPageRef)
  #foreach($i in [1..100])
    #if(!$newPage.isNew())
      #set($newPageRef = "${basePageRef}_${counter}")
      #set($newPage = $xwiki.getDocument($newPageRef))
      #set($counter = $counter + 1)
    #else
      #break
    #end
  #end

  ## 4. Création et population de l'objet
  #set($newObj = $newPage.newObject($classPath))
  #set($discard = $newObj.set("acronyme", $acronymeInput))
  #set($discard = $newObj.set("libelle", $libelleInput))
  #set($discard = $newObj.set("definition", $definitionInput))
  #set($discard = $newPage.setTitle($acronymeInput))
  #set($discard = $newPage.save("Ajout via interface Glossaire", true))

  ## 5. Stockage du statut en session pour l'affichage après redirection
  #if($alreadyExists)
    $request.session.setAttribute('glossary_status', 'warning')
  #else
    $request.session.setAttribute('glossary_status', 'success')
  #end
  $request.session.setAttribute('glossary_msg', $acronymeInput)

  ## Redirection et arrêt immédiat du script courant pour forcer le rafraîchissement propre
  $response.sendRedirect($doc.getURL())
  #stop
#end

## --- 1. AFFICHAGE DES NOTIFICATIONS (POST-REDIRECTION) ---
#set($status = $request.session.getAttribute('glossary_status'))
#if($status)
  #set($msg = $request.session.getAttribute('glossary_msg'))

  #if($status == 'success')
    <div class="alert alert-success" style="margin-bottom: 20px;">
      <strong>Succès !</strong> Le terme <strong>$msg</strong> a été ajouté à la base de données.
    </div>
  #elseif($status == 'warning')
    <div class="alert alert-warning" style="margin-bottom: 20px;">
      <strong>Information :</strong> L'acronyme <strong>$msg</strong> existait déjà. Une nouvelle fiche distincte a tout de même été créée avec succès.
    </div>
  #end

  $request.session.removeAttribute('glossary_status')
  $request.session.removeAttribute('glossary_msg')
#end

<script>
  document.addEventListener("DOMContentLoaded", function() {
    const alerts = document.querySelectorAll(".alert");
    alerts.forEach(alert => {
      setTimeout(() => {
        alert.classList.add("hidden");
      }, 7000); // 7000 milliseconds = 7 secondes
    });
  });
</script>

## --- 3. BOUTON D'AJOUT ---
<div class="row" style="margin-bottom: 15px;">
  <div class="col-md-6">
    <button type="button" class="btn btn-success" data-toggle="modal" data-target="#glossaryModal">
      + Ajouter un nouvel acronyme
    </button>
  </div>
</div>

## --- BLOC DE NAVIGATION POUR LA PAGINATION ---
<div class="pagination-container" style="display: flex; justify-content: space-between; align-items: center; margin-top: 15px; padding: 10px; background: #f9f9f9; border: 1px solid #ddd; border-radius: 4px;">
  <!-- Sélecteur de taille de page -->
  <div>
    <label for="pageSizeSelect" style="margin-right: 5px; font-weight: normal;">Éléments par page :</label>
    <select id="pageSizeSelect" onchange="changePageSize();" style="padding: 4px 8px; border-radius: 4px; border: 1px solid #ccc;">
      <option value="5">5</option>
      <option value="10" selected>10</option>
      <option value="25">25</option>
      <option value="50">50</option>
      <option value="all">Tout afficher</option>
    </select>
  </div>

  <!-- Flèches et indicateur de page -->
  <div style="display: flex; align-items: center; gap: 15px;">
    <button type="button" id="btnPrevPage" class="btn btn-default btn-sm" onclick="navigatePage(-1);" style="padding: 5px 10px;">
      <span class="glyphicon glyphicon-chevron-left"></span>
    </button>
    <span id="pageIndicator" style="font-weight: bold; min-width: 80px; text-align: center;">Page 1 / 1</span>
    <button type="button" id="btnNextPage" class="btn btn-default btn-sm" onclick="navigatePage(1);" style="padding: 5px 10px;">
      <span class="glyphicon glyphicon-chevron-right"></span>
    </button>
  </div>
</div>

## --- 4. POPUP UNIQUE POUR LES ACTIONS PERSONNALISÉES (MODALE) ---
<div id="actionFeedbackModal" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-label="Fermer"><span aria-hidden="true">&times;</span></button>
        <h4 class="modal-title" id="feedbackModalTitle">Action Personnalisée</h4>
      </div>
      <div class="modal-body">
        <p id="feedbackModalBodyText">Contenu par défaut...</p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-default" data-dismiss="modal">Fermer</button>
      </div>
    </div>
  </div>
</div>

