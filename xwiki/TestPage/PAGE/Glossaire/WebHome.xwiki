<div id="glossaryBootstrap" class="is-hidden"
     data-endpoint-url="$escapetool.xml($!urlGlossaireData)"
     data-csrf="$escapetool.xml($services.csrf.getToken())"
     data-can-view="$canView"
     data-can-propose="$canPropose"
     data-can-add="$canAdd"
     data-can-manage="$canManage"
     data-can-review="$canReview"
     data-can-configure="$canConfigure"
     data-config-version="$escapetool.xml($configurationVersion)"
     data-current-author="$escapetool.xml($currentAuthor)"></div>

<div class="glossary-page">
  <div class="nh-shell">
    <header class="nh-header">
      <h1 class="nh-title">Glossaire</h1>
      <p class="nh-subtitle">Retrouvez ici les acronymes, libellés et définitions du wiki.</p>
    </header>

## --- BARRE D'ACTIONS ---
<div class="row glossary-toolbar">
  <div id="glossaryToolbarLeft" class="col-md-6 glossary-toolbar-left">
    #if($canPropose)
    <button type="button" class="btn btn-success" data-toggle="modal" data-target="#glossaryModal">
      $services.icon.renderHTML('add') $escapetool.xml($createButtonText)
    </button>
    #elseif(!$isAuthenticated && $canView)
    <p class="text-muted">Connectez-vous pour proposer un acronyme.</p>
    #end
    #if($canReview)
    <button type="button" id="btnReviewGlossaryProposals" class="btn btn-primary glossary-proposals-button" data-toggle="modal" data-target="#glossaryProposalsModal" aria-describedby="glossaryProposalCountLabel">
      Propositions
      <span id="glossaryProposalCount" class="glossary-proposals-badge" aria-hidden="true">$pendingProposalDocs.size()</span>
      <span id="glossaryProposalCountLabel" class="sr-only" aria-live="polite">$pendingProposalDocs.size() proposition(s) en attente</span>
    </button>
    <button type="button" id="btnGlossaryTrash" class="btn btn-default glossary-proposals-button" data-toggle="modal" data-target="#glossaryTrashModal" aria-describedby="glossaryTrashCountLabel">
      Corbeille
      <span id="glossaryTrashCount" class="glossary-proposals-badge" aria-hidden="true">$trashProposalDocs.size()</span>
      <span id="glossaryTrashCountLabel" class="sr-only" aria-live="polite">$trashProposalDocs.size() proposition(s) dans la corbeille</span>
    </button>
    #end
  </div>
  <div id="glossaryToolbarRight" class="col-md-6 glossary-toolbar-right">
    #if($canView)
    <div id="glossaryImportToolbar" class="glossary-import-toolbar"></div>
    #end
    #if($canConfigure)
    <button type="button" id="btnGlossarySettings" class="btn btn-default" data-toggle="modal" data-target="#glossarySettingsModal">Paramètres</button>
    #end
  </div>
</div>

#if(!$canView)
<p class="alert alert-warning" role="status">Votre compte n'a pas accès au glossaire.</p>
#end

#if($canView)
## --- PAGINATION ---
<div class="pagination-container">
  <div>
    <label for="pageSizeSelect" class="glossary-page-size-label">Elements par page :</label>
    <select id="pageSizeSelect">
      <option value="5">5</option>
      <option value="10" selected>10</option>
      <option value="25">25</option>
      <option value="50">50</option>
      <option value="all">Tout afficher</option>
    </select>
  </div>

  <div class="glossary-pagination-actions">
    <button type="button" id="btnPrevPage" class="btn btn-default btn-sm glossary-pagination-button" aria-label="Page précédente" title="Page précédente">
      $services.icon.renderHTML('left')
    </button>
    <span id="pageIndicator">Page 1 / 1</span>
    <button type="button" id="btnNextPage" class="btn btn-default btn-sm glossary-pagination-button" aria-label="Page suivante" title="Page suivante">
      $services.icon.renderHTML('right')
    </button>
  </div>
</div>

## --- POPUP D'ACTION GÉNÉRIQUE ---
<div id="actionFeedbackModal" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-label="Fermer" title="Fermer">$services.icon.renderHTML('cross')</button>
        <h4 class="modal-title" id="feedbackModalTitle">Information</h4>
      </div>
      <div class="modal-body">
        <p id="feedbackModalBodyText">Information</p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-default" data-dismiss="modal">Fermer</button>
      </div>
    </div>
  </div>
</div>

## --- TABLEAU PRINCIPAL ---
<div class="table-responsive">
  <table class="table table-striped table-hover table-bordered"
         id="mainGlossaryTable"
         data-csrf="$services.csrf.getToken()"
         data-can-view="$canView"
         data-can-manage="$canManage"
         data-can-add="$canAdd"
         data-can-review="$canReview"
         data-can-configure="$canConfigure"
         data-can-propose="$canPropose"
         data-class-path="$classPath"
         data-endpoint-url="$escapetool.xml($!urlGlossaireData)"
         data-icon-right="$escapetool.xml($services.icon.renderHTML('right'))"
         data-icon-pencil="$escapetool.xml($services.icon.renderHTML('pencil'))"
         data-icon-trash="$escapetool.xml($services.icon.renderHTML('trash'))"
         data-icon-check="$escapetool.xml($services.icon.renderHTML('check'))"
         data-icon-cross="$escapetool.xml($services.icon.renderHTML('cross'))"
         data-icon-eye="$escapetool.xml($services.icon.renderHTML('eye'))"
         data-icon-download="$escapetool.xml($services.icon.renderHTML('download'))"
         data-icon-refresh="$escapetool.xml($services.icon.renderHTML('refresh'))">
    <thead>
      <tr>
        <th class="glossary-col-acronym">Acronyme</th>
        <th class="glossary-col-label">Libellé complet</th>
        <th class="glossary-col-definition">Définition</th>
        #if($canManage)
        <th class="glossary-col-actions">Actions</th>
        #end
      </tr>
      <tr class="filter-row">
        <th>
          <div class="glossary-filter-layout">
            <input type="text" id="filterAcronym" class="glossary-filter-input" placeholder="Filtrer">
            <button type="button"
                    class="btn btn-default btn-xs sort-column-btn active"
                    data-column="acronym"
                    data-sort-active="true"
                    data-sort-direction="asc"
                    title="Trier par acronyme">
              <span class="sort-label">A $services.icon.renderHTML('right') Z</span>
            </button>
          </div>
        </th>
        <th>
          <div class="glossary-filter-layout">
            <input type="text" id="filterLabel" class="glossary-filter-input" placeholder="Filtrer">
            <button type="button"
                    class="btn btn-default btn-xs sort-column-btn"
                    data-column="label"
                    data-sort-active="false"
                    data-sort-direction="asc"
                    title="Trier par libellé">
              <span class="sort-label">A $services.icon.renderHTML('right') Z</span>
            </button>
          </div>
        </th>
        <th>
          <div class="glossary-filter-layout">
            <input type="text" id="filterDefinition" class="glossary-filter-input" placeholder="Filtrer">
            <button type="button"
                    class="btn btn-default btn-xs sort-column-btn"
                    data-column="definition"
                    data-sort-active="false"
                    data-sort-direction="asc"
                    title="Trier par définition">
              <span class="sort-label">A $services.icon.renderHTML('right') Z</span>
            </button>
          </div>
        </th>
        #if($canManage)
        <th class="glossary-empty-filter"></th>
        #end
      </tr>
    </thead>
    <tbody>
      #set($allDocNames = $xwiki.getSpaceDocsName($dataSpace))
      #foreach($docName in $allDocNames)
        #set($termReference = $services.model.createDocumentReference('', $dataSpaces, $docName))
        #set($fullRef = $services.model.serialize($termReference, 'local'))
        #set($tDoc = $xwiki.getDocument($termReference))
        #set($tObj = false)
        #set($tObj = $tDoc.getObject($classPath))
        #if($tObj)
          #set($acronymeValue = $!tObj.getValue('acronyme'))
          #set($libelleValue = $!tObj.getValue('libelle'))
          #set($definitionValue = $!tObj.getValue('definition'))

          <tr class="main-term-row"
              data-acronym="$escapetool.xml($!acronymeValue.toUpperCase())"
              data-doc-name="$escapetool.xml($!docName)"
              data-full-ref="$escapetool.xml($!fullRef)">
            <td class="main-acronym">
              <span class="view-mode"><strong>$escapetool.xml($!acronymeValue)</strong></span>
              #if($canManage)
              <input type="text" class="form-control edit-mode edit-acronym glossary-edit-field" value="$escapetool.xml($!acronymeValue)">
              #end
            </td>
            <td class="main-label">
              <span class="view-mode">$escapetool.xml($!libelleValue)</span>
              #if($canManage)
              <input type="text" class="form-control edit-mode edit-label glossary-edit-field" value="$escapetool.xml($!libelleValue)">
              #end
            </td>
            <td class="main-definition">
              <span class="view-mode">$escapetool.xml($!definitionValue)</span>
              #if($canManage)
              <textarea class="form-control edit-mode edit-definition glossary-edit-field" rows="2">$escapetool.xml($!definitionValue)</textarea>
              #end
            </td>
            #if($canManage)
            <td>
              <div class="view-buttons">
                <button type="button" class="btn btn-xs btn-primary custom-action-btn js-edit-row" aria-label="Modifier" title="Modifier">
                  $services.icon.renderHTML('pencil')
                </button>
                <button type="button" class="btn btn-xs btn-danger custom-action-btn js-delete-row" aria-label="Supprimer" title="Supprimer">
                  $services.icon.renderHTML('trash')
                </button>
              </div>
              <div class="edit-buttons glossary-edit-buttons">
                <button type="button" class="btn btn-xs btn-success js-save-row">
                  $services.icon.renderHTML('check') Enregistrer
                </button>
                <button type="button" class="btn btn-xs btn-default js-cancel-row" aria-label="Annuler" title="Annuler">
                  $services.icon.renderHTML('cross')
                </button>
              </div>
            </td>
            #end
          </tr>
        #end
      #end
    </tbody>
  </table>
</div>

## --- CONFIRMATION DE SUPPRESSION SIMPLE ---
#if($canManage)
<div class="modal fade" id="deleteConfirmModal" tabindex="-1" role="dialog" aria-hidden="true">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header glossary-delete-modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-label="Fermer" title="Fermer">$services.icon.renderHTML('cross')</button>
        <h4 class="modal-title" id="deleteModalTitle">Supprimer un terme</h4>
      </div>
      <div class="modal-body">
        <p>Supprimer définitivement ce terme et sa page XWiki ?</p>
        <table class="table table-bordered table-condensed glossary-delete-preview-table">
          <thead>
            <tr>
              <th>Acronyme</th>
              <th>Libellé complet</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td id="deleteModalAcronym" class="glossary-delete-acronym"></td>
              <td id="deleteModalLabel"></td>
            </tr>
          </tbody>
        </table>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-default" data-dismiss="modal">Annuler</button>
        <button type="button" class="btn btn-danger" id="btnConfirmDelete">Supprimer</button>
      </div>
    </div>
  </div>
</div>
#end

## --- MODALE DE CRÉATION ---
#if($canPropose)
<div class="modal fade" id="glossaryModal" tabindex="-1" role="dialog" aria-labelledby="glossaryModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-label="Fermer" title="Fermer">$services.icon.renderHTML('cross')</button>
        <h4 class="modal-title" id="glossaryModalLabel">$escapetool.xml($createModalTitle)</h4>
      </div>

      <form id="glossaryCreateForm" method="post" action="$escapetool.xml($!urlGlossaireData)">
        <input type="hidden" name="action" value="$escapetool.xml($createAction)">
        <input type="hidden" name="xpage" value="plain">
        <input type="hidden" name="form_token" value="$services.csrf.getToken()">

        <div class="modal-body">
          #if(!$canManage)
          <p class="alert alert-info">Votre proposition sera examinée par les validateurs avant son ajout au glossaire.</p>
          #end
          <div class="row">
            <div class="col-md-5 modal-left-column">
              <h5 class="column-title">Nouveau terme</h5>

              <div class="form-group">
                <label for="acronymeInputField">Acronyme ou sigle :</label>
                <input type="text"
                       id="acronymeInputField"
                       name="acronyme"
                       maxlength="255"
                       class="form-control"
                       autocomplete="off"
                       required
                       placeholder="Exemple : API">
              </div>

              <div class="form-group">
                <label for="libelleInputField">Libellé complet :</label>
                <input type="text"
                       id="libelleInputField"
                       name="libelle"
                       maxlength="255"
                       class="form-control"
                       autocomplete="off"
                       required
                       placeholder="Nom complet">
              </div>

              <div class="form-group">
                <label for="definitionInputField">Définition (facultatif) :</label>
                <textarea id="definitionInputField" name="definition"
                          class="form-control"
                          rows="5"
                          placeholder="Saisir une définition"></textarea>
              </div>
            </div>

            <div class="col-md-7 modal-right-column">
              <h5 class="column-title warning-title">Termes existants</h5>
              <p class="text-muted help-text">Les termes qui correspondent à votre saisie apparaissent ici.</p>

              <div class="table-scroll-container">
                <table class="table table-striped table-hover" id="popupCheckTable">
                  <thead>
                    <tr>
                      <th class="glossary-popup-acronym-col">Acronyme</th>
                      <th>Libellé complet</th>
                    </tr>
                  </thead>
                  <tbody>
                    #foreach($docName in $allDocNames)
                      #set($termReference = $services.model.createDocumentReference('', $dataSpaces, $docName))
                      #set($fullRef = $services.model.serialize($termReference, 'local'))
                      #set($tDoc = $xwiki.getDocument($termReference))
                      #set($tObj = false)
                      #set($tObj = $tDoc.getObject($classPath))
                      #if($tObj)
                        <tr class="term-row" data-full-ref="$escapetool.xml($!fullRef)">
                          <td class="term-acronym">$escapetool.xml($!tObj.getValue('acronyme'))</td>
                          <td class="term-label">$escapetool.xml($!tObj.getValue('libelle'))</td>
                        </tr>
                      #end
                    #end
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>

        <div class="modal-footer">
          <button type="button" class="btn btn-default" data-dismiss="modal">Annuler</button>
          <button type="submit" class="btn btn-primary">$escapetool.xml($createSubmitText)</button>
        </div>
      </form>
    </div>
  </div>
</div>
#end

#end

## --- VALIDATION DES PROPOSITIONS ---
#if($canReview)
<div class="modal fade" id="glossaryProposalsModal" tabindex="-1" role="dialog" aria-labelledby="glossaryProposalsTitle" aria-hidden="true">
  <div class="modal-dialog modal-lg" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-label="Fermer" title="Fermer">$services.icon.renderHTML('cross')</button>
        <h4 class="modal-title" id="glossaryProposalsTitle">Propositions d'acronymes en attente</h4>
      </div>
      <div class="modal-body">
        <p>Vous pouvez corriger une proposition avant de la valider. Un motif est obligatoire pour la refuser.</p>
        <p id="glossaryProposalsEmpty" class="$escapetool.xml($pendingEmptyClass)">Aucune proposition en attente.</p>
        <div id="glossaryPendingProposals">
          #foreach($proposalDoc in $pendingProposalDocs)
            #set($proposalObject = $proposalDoc.getObject($proposalClass))
          <form class="glossary-proposal-card" data-proposal-ref="$escapetool.xml($proposalDoc.fullName)" data-expected-version="$escapetool.xml($proposalDoc.version)"
                data-proposal-author="$escapetool.xml($!proposalObject.getValue('author'))"
                data-proposal-submitted-at="$escapetool.xml($!proposalObject.getValue('submittedAt'))">
            <h5>$escapetool.xml($!proposalObject.getValue('acronyme')) — $escapetool.xml($!proposalObject.getValue('libelle'))</h5>
            <p class="text-muted glossary-proposal-meta">Proposé par $escapetool.xml($!proposalObject.getValue('author')) le $escapetool.xml($!proposalObject.getValue('submittedAt'))</p>
            <div class="form-group">
              <label for="proposalAcronym${foreach.count}">Acronyme ou sigle</label>
              <input id="proposalAcronym${foreach.count}" name="acronym" class="form-control" maxlength="255" value="$escapetool.xml($!proposalObject.getValue('acronyme'))" required>
            </div>
            <div class="form-group">
              <label for="proposalLabel${foreach.count}">Libellé complet</label>
              <input id="proposalLabel${foreach.count}" name="label" class="form-control" maxlength="255" value="$escapetool.xml($!proposalObject.getValue('libelle'))" required>
            </div>
            <div class="form-group">
              <label for="proposalDefinition${foreach.count}">Définition (facultatif)</label>
              <textarea id="proposalDefinition${foreach.count}" name="definition" class="form-control" rows="3">$escapetool.xml($!proposalObject.getValue('definition'))</textarea>
            </div>
            <div class="form-group">
              <label for="proposalComment${foreach.count}">Commentaire / motif du refus</label>
              <textarea id="proposalComment${foreach.count}" name="comment" class="form-control" rows="2" placeholder="Obligatoire en cas de refus"></textarea>
            </div>
            <p class="glossary-proposal-feedback text-danger is-hidden" role="alert"></p>
            <div class="glossary-proposal-actions">
              <button type="button" class="btn btn-success" data-review-action="approve">Valider et publier</button>
              <button type="button" class="btn btn-danger" data-review-action="reject">Refuser</button>
              <button type="button" class="btn btn-default" data-review-action="trash">Mettre à la corbeille</button>
            </div>
          </form>
          #end
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-default" data-dismiss="modal">Fermer</button>
      </div>
    </div>
  </div>
</div>
#end

## --- CORBEILLE DES PROPOSITIONS ---
#if($canReview)
<div class="modal fade" id="glossaryTrashModal" tabindex="-1" role="dialog" aria-labelledby="glossaryTrashTitle" aria-hidden="true">
  <div class="modal-dialog modal-lg" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-label="Fermer" title="Fermer">$services.icon.renderHTML('cross')</button>
        <h4 class="modal-title" id="glossaryTrashTitle">Corbeille des propositions</h4>
      </div>
      <div class="modal-body">
        <p>Les propositions refusées ou retirées sont conservées pendant 7 jours. Vous pouvez les corriger et les revalider pendant ce délai.</p>
        <p id="glossaryTrashEmpty" class="$escapetool.xml($trashEmptyClass)">La corbeille est vide.</p>
        <div id="glossaryTrashProposals">
          #foreach($trashDoc in $trashProposalDocs)
            #set($trashObject = $trashDoc.getObject($proposalClass))
            #set($deletedAt = $trashObject.getValue('deletedAt'))
            #set($expiresMillis = $deletedAt.time + 604800000)
            #set($trashStatusLabel = 'Proposition retirée')
            #if($trashObject.getValue('status') == 'rejected')
              #set($trashStatusLabel = 'Proposition refusée')
            #end
          <form class="glossary-trash-card" data-proposal-ref="$escapetool.xml($trashDoc.fullName)" data-expected-version="$escapetool.xml($trashDoc.version)"
                data-expires-at="$expiresMillis" data-deleted-at="$deletedAt.time" data-proposal-author="$escapetool.xml($!trashObject.getValue('author'))">
            <h5>$escapetool.xml($!trashObject.getValue('acronyme')) — $escapetool.xml($!trashObject.getValue('libelle'))</h5>
            <p><strong>$escapetool.xml($trashStatusLabel)</strong></p>
            <p class="text-muted glossary-proposal-meta">Proposé par $escapetool.xml($!trashObject.getValue('author')) le $escapetool.xml($!trashObject.getValue('submittedAt'))</p>
            <p class="text-muted glossary-proposal-meta">Mise à la corbeille le $escapetool.xml($deletedAt). <span class="glossary-trash-expiration" data-expires-at="$expiresMillis">Suppression après 7 jours.</span></p>
            <p class="glossary-proposal-comment">$escapetool.xml($!trashObject.getValue('reviewComment'))</p>
            <div class="form-group">
              <label for="trashAcronym${foreach.count}">Acronyme ou sigle</label>
              <input id="trashAcronym${foreach.count}" name="acronym" class="form-control" maxlength="255" value="$escapetool.xml($!trashObject.getValue('acronyme'))" required>
            </div>
            <div class="form-group">
              <label for="trashLabel${foreach.count}">Libellé complet</label>
              <input id="trashLabel${foreach.count}" name="label" class="form-control" maxlength="255" value="$escapetool.xml($!trashObject.getValue('libelle'))" required>
            </div>
            <div class="form-group">
              <label for="trashDefinition${foreach.count}">Définition (facultatif)</label>
              <textarea id="trashDefinition${foreach.count}" name="definition" class="form-control" rows="3">$escapetool.xml($!trashObject.getValue('definition'))</textarea>
            </div>
            <div class="form-group">
              <label for="trashComment${foreach.count}">Commentaire de revalidation (facultatif)</label>
              <textarea id="trashComment${foreach.count}" name="comment" class="form-control" rows="2"></textarea>
            </div>
            <p class="glossary-proposal-feedback text-danger is-hidden" role="alert"></p>
            <button type="button" class="btn btn-success" data-review-action="restore">Revalider et publier</button>
          </form>
          #end
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-default" data-dismiss="modal">Fermer</button>
      </div>
    </div>
  </div>
</div>
#end

## --- PARAMÈTRES ADMINISTRATEUR ---
#if($canConfigure)
#set($roleNames = ['Aucun accès', 'Lecture', 'Proposition', 'Ajout direct', 'Validation'])
<div class="modal fade" id="glossarySettingsModal" tabindex="-1" role="dialog" aria-labelledby="glossarySettingsTitle" aria-hidden="true">
  <div class="modal-dialog modal-lg" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-label="Fermer" title="Fermer">$services.icon.renderHTML('cross')</button>
        <h4 class="modal-title" id="glossarySettingsTitle">Paramètres du glossaire</h4>
      </div>
      <form id="glossarySettingsForm" method="post" action="$escapetool.xml($!urlGlossaireData)" data-expected-version="$escapetool.xml($configurationVersion)">
        <input type="hidden" name="action" value="settings">
        <input type="hidden" name="xpage" value="plain">
        <input type="hidden" name="form_token" value="$escapetool.xml($services.csrf.getToken())">
        <input type="hidden" name="expectedVersion" value="$escapetool.xml($configurationVersion)">
        <input type="hidden" name="settingsForm" value="true">
        <input type="hidden" name="groupCount" value="$settingsGroups.size()">
        <div class="modal-body">
          <p>Les niveaux sont cumulatifs : un validateur peut aussi ajouter, proposer et consulter. L'ajout direct permet de modifier et supprimer les acronymes publiés. Les membres de plusieurs groupes reçoivent le niveau le plus élevé.</p>
          #if($configurationDoc && !$configurationObject)
          <p class="alert alert-info glossary-settings-first-use">La configuration sera créée automatiquement lors du premier enregistrement. Aucun objet n'est à ajouter manuellement.</p>
          #end
          <div class="table-responsive">
            <table class="table table-striped table-bordered glossary-permissions-table">
              <thead><tr><th>Groupe XWiki</th><th>Niveau d'autorisation</th></tr></thead>
              <tbody>
                #foreach($settingGroup in $settingsGroups)
                  #set($settingRowIndex = $foreach.index)
                  #set($settingLevel = 0)
                  #foreach($level in [1..4])
                    #set($permissionIndex = $level - 1)
                    #if($configuredGroups.get($permissionIndex).contains($settingGroup))
                      #set($settingLevel = $level)
                    #end
                  #end
                  #set($settingGroupMissing = false)
                  #if($settingGroup != 'XWiki.XWikiGuest')
                    #set($settingGroupDoc = false)
                    #set($settingGroupObject = false)
                    #set($settingGroupDoc = $xwiki.getDocument($services.model.resolveDocument($settingGroup)))
                    #if($settingGroupDoc && !$settingGroupDoc.isNew())
                      #set($settingGroupObject = $settingGroupDoc.getObject('XWiki.XWikiGroups'))
                    #end
                    #if(!$settingGroupObject)
                      #set($settingGroupMissing = true)
                      #set($settingLevel = 0)
                    #end
                  #end
                <tr class="glossary-permission-row" data-group-ref="$escapetool.xml($settingGroup)">
                  <td>
                    <label for="glossaryGroupLevel$settingRowIndex">$escapetool.xml($settingGroup)</label>
                    <input type="hidden" name="group_$settingRowIndex" value="$escapetool.xml($settingGroup)">
                    #if($settingGroup == 'XWiki.XWikiGuest')
                    <span class="text-muted"> — visiteurs non connectés</span>
                    #elseif($settingGroupMissing)
                    <span class="text-warning glossary-missing-group"> — Groupe introuvable</span>
                    #end
                  </td>
                  <td>
                    <select id="glossaryGroupLevel$settingRowIndex" name="level_$settingRowIndex" class="form-control glossary-role-select">
                      #foreach($level in [0..4])
                        #if($settingGroup != 'XWiki.XWikiGuest' || $level <= 1)
                          #set($selectedRoleAttr = '')
                          #if($settingLevel == $level)
                            #set($selectedRoleAttr = ' selected')
                          #end
                      <option value="$level"$selectedRoleAttr>$escapetool.xml($roleNames.get($level))</option>
                        #end
                      #end
                    </select>
                  </td>
                </tr>
                #end
              </tbody>
            </table>
          </div>
          <section class="glossary-migration" aria-labelledby="glossaryMigrationTitle">
            <h5 id="glossaryMigrationTitle">Adresses des fiches existantes</h5>
            <p><span id="glossaryLegacyCount">$legacyCount</span> fiche(s) utilisent encore leur ancienne adresse. La conversion leur attribue une adresse permanente et met à jour les liens internes.</p>
            <button type="button" id="btnMigrateGlossary" class="btn btn-default"$migrationDisabledAttr>Convertir les adresses existantes</button>
          </section>
          <p class="glossary-settings-feedback text-danger is-hidden" role="alert"></p>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-default" data-dismiss="modal">Annuler</button>
          <button type="submit" class="btn btn-primary">Enregistrer les autorisations</button>
        </div>
      </form>
    </div>
  </div>
</div>
#end

#if($canView && $isAuthenticated)
<section class="glossary-own-proposals" aria-labelledby="glossaryOwnProposalsTitle">
  <h2 id="glossaryOwnProposalsTitle">Mes propositions</h2>
  <p id="glossaryOwnProposalsEmpty" class="$escapetool.xml($ownEmptyClass)">Vous n'avez pas encore envoyé de proposition.</p>
  <div id="glossaryOwnProposals">
    #foreach($proposalDoc in $ownProposalDocs)
      #set($proposalObject = $proposalDoc.getObject($proposalClass))
      #set($proposalStatus = $proposalObject.getValue('status'))
      #set($ownExpiresAt = '')
      #if($proposalStatus == 'rejected' || $proposalStatus == 'trashed')
        #set($ownDeletedAt = $proposalObject.getValue('deletedAt'))
        #set($ownExpiresAt = $ownDeletedAt.time + 604800000)
      #end
      #set($proposalStatusLabel = "En attente de validation")
      #if($proposalStatus == 'approved')
        #set($proposalStatusLabel = "Validée et publiée")
      #elseif($proposalStatus == 'rejected')
        #set($proposalStatusLabel = "Refusée — dans la corbeille")
      #elseif($proposalStatus == 'trashed')
        #set($proposalStatusLabel = "Retirée — dans la corbeille")
      #end
    <article class="glossary-proposal-status-card"
             data-proposal-ref="$escapetool.xml($proposalDoc.fullName)"
             data-proposal-status="$escapetool.xml($!proposalStatus)"
             data-expires-at="$ownExpiresAt"
             data-proposal-acronym="$escapetool.xml($!proposalObject.getValue('acronyme'))"
             data-proposal-label="$escapetool.xml($!proposalObject.getValue('libelle'))">
      <h3>$escapetool.xml($!proposalObject.getValue('acronyme')) — $escapetool.xml($!proposalObject.getValue('libelle'))</h3>
      <p class="glossary-proposal-meta text-muted">Envoyée le $escapetool.xml($!proposalObject.getValue('submittedAt'))</p>
      <p><strong>$escapetool.xml($proposalStatusLabel)</strong></p>
      #if("$!proposalObject.getValue('reviewComment')" != "")
      <p class="glossary-proposal-comment">$escapetool.xml($!proposalObject.getValue('reviewComment'))</p>
      #end
    </article>
    #end
  </div>
</section>
#end
  </div>
</div>

<div id="glossaryToast"
     class="glossary-toast"
     role="status"
     aria-live="polite"
     aria-atomic="true"></div>
{{/html}}
{{/velocity}}
