{{velocity}}
{{html}}
#if($isGuest)
  {{warning}}
Vous devez être connecté pour consulter vos liens.
  {{/warning}}
#else


#set($parentPage = 'TestPage.PAGE.Doc.WebHome')  ## Page racine par défaut
#set($csrfToken = $services.csrf.getToken())

<script>
  // Variables globales lues par le JavaScript
  var initialPageRef = "$escapetool.javascript($parentPage)";
  var urlCommande = "$escapetool.javascript($xwiki.getURL("TestPage.PAGE.Doc.COMMANDE", "view"))";
</script>

<div id="notification"></div>
<button class="btn btn-primary" onclick="ajouterFichier()">Ajouter un fichier</button>
<button class="btn btn-primary" onclick="ajouterDocument()">Ajouter un Document</button>

<div id="popup" class="popup">
  <div class="popupContent">
    <span class="close">&times;</span>
    <form id="formulairePopup">
      <input type="hidden" name="form_token" value="$escapetool.xml($csrfToken)"/>
      <div id="popupContent"></div>
      <button type="button" id="btn-popup-valide" class="btn btn-primary" onclick="popupValider()">Valider</button>
    </form>
    <button class="btn btn-primary" onclick="popupAnnuler()">Annuler</button>
  </div>
</div>

<!-- Le conteneur "box" démarre vide et sera alimenté instantanément par LienPerso -->
<div id="box">
  <p style="color: #6b7280; font-size: 14px; padding: 10px;">Chargement de l'explorateur...</p>
</div>

#end
{{/html}}
{{/velocity}}
