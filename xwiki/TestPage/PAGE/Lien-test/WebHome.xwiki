## BEGIN LIENS ADDRESSES — même générateur que le Glossaire.
#macro(liensFindDestination $destinationSpaces $sourcePage)
  #set($candidateReference = false)
  #set($candidateDoc = false)
  #set($destinationRoot = $services.model.createDocumentReference($liensWiki, $destinationSpaces, 'WebHome'))
  #set($destinationSpace = $services.model.serialize($destinationRoot.parent))
  #set($hasStableAddress = false)
  #if($sourcePage && $sourcePage.name.matches('[A-Za-z0-9]{16}'))
    #set($stableMarker = "<!-- liens-id:$sourcePage.name -->")
    #set($hasStableAddress = $sourcePage.content.contains($stableMarker))
  #end
  #foreach($addressAttempt in [1..100])
    #if($hasStableAddress)
      #set($candidateName = $sourcePage.name)
    #else
      #set($candidateName = $xwiki.getUniquePageName($destinationSpace))
    #end
    #if($candidateName.matches('[A-Za-z0-9]{16}'))
      #set($candidate = $services.model.createDocumentReference($liensWiki, $destinationSpaces, $candidateName))
      #set($candidateDoc = $xwiki.getDocument($candidate))
      #if($sourcePage && $candidate.equals($sourcePage.documentReference))
        #set($candidateReference = $candidate)
        #break
      #end
      ## Ne pas entrer en collision avec une fiche terminale ou une page imbriquée.
      #set($nestedSpaces = [])
      #set($discard = $nestedSpaces.addAll($destinationSpaces))
      #set($discard = $nestedSpaces.add($candidateName))
      #set($nestedReference = $services.model.createDocumentReference($liensWiki, $nestedSpaces, 'WebHome'))
      #if($candidateDoc.isNew() && $xwiki.getDocument($nestedReference).isNew())
        #set($candidateReference = $candidate)
        #break
      #end
    #end
    ## Un déplacement d'auteur conserve aussi l'identifiant stable, sans écraser de fiche.
    #if($hasStableAddress) #break #end
  #end
#end
#macro(liensMarkStableAddress $stablePage)
  #set($stableMarker = "<!-- liens-id:$stablePage.name -->")
  #if(!$stablePage.content.contains($stableMarker))
    #set($markerOpen = '{')
    #set($markerClose = '}')
    #set($stableContent = "$!stablePage.content")
    #set($discard = $stablePage.setContent("${stableContent}${markerOpen}${markerOpen}html${markerClose}${markerClose}${stableMarker}${markerOpen}${markerOpen}/html${markerClose}${markerClose}"))
  #end
#end
## END LIENS ADDRESSES
