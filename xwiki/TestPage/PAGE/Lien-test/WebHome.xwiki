  ## --- 5. TABLEAU PRINCIPAL GLOSSAIRE MAISON WITH COLUMN FILTERS & PAGINATION ---
  <div class="table-responsive">
    <!-- On conserve data-csrf et data-class-path sur la table -->
    <table class="table table-striped table-hover table-bordered hide-type-column"
           id="secondaryGlossaryTable"
           data-csrf="$services.csrf.getToken()"
           data-class-path="$!classPath">
      <thead>
        <tr>
          <th style="width: 15%;">Acronyme</th>
          <th style="width: 25%;">Libellé complet</th>
          <th style="width: 25%;">Définition</th>
          <th style="width: 10%;">Créateur</th>
          <th class="col-type" style="width: 10%;">Type</th>
          <th style="width: 15%;">Actions</th>
        </tr>
        <tr class="filter-row">
          <th><input type="text" id="filterAcronym2" placeholder="Filtrer..." oninput="filterSecondaryTableColumns();"></th>
          <th><input type="text" id="filterLabel2" placeholder="Filtrer..." oninput="filterSecondaryTableColumns();"></th>
          <th><input type="text" id="filterDefinition2" placeholder="Filtrer..." oninput="filterSecondaryTableColumns();"></th>
          <th><input type="text" id="filterProprietaire2" placeholder="Filtrer..." oninput="filterSecondaryTableColumns();"></th>
          <th class="col-type" style="background-color: #f9f9f9;"></th>
          <th style="background-color: #f9f9f9;"></th>
        </tr>
      </thead>
      <tbody>
        #set ($userObj = $null)
        #set ($firstName = $null)
        #set ($lastName = $null)
        #set ($displayProprietaire = $null)
        #set ($proprietaireValue = $null)

        #foreach ($fullRef in $documentRefs)
          ## On charge la page
          #set ($targetDoc = $xwiki.getDocument($fullRef))
          #set ($docName = $targetDoc.getName())
          ## On récupère l'objet lié à cette page
          #set ($targetObject = $targetDoc.getObject($classPath))
          #if ($targetObject)
            #set ($acronymeValue = $targetObject.getValue('nom_lien'))
            #set ($libelleValue = $targetObject.getValue('lien'))
            #set ($definitionValue = $targetObject.getValue('definition'))
            #set ($typeValue = $targetObject.getValue('type'))
            #set ($proprietaireValue = $targetObject.getValue('proprietaire'))

            ## 2. Récupération du document sur le wiki central
            #set ($userPageRef = "xwiki:XWiki.${proprietaireValue}")
            #set ($userDoc = $xwiki.getDocument($userPageRef))
            #set ($userObj = $userDoc.getObject('XWiki.XWikiUsers'))
            #if($userObj)
              #set ($firstName = $userObj.getValue('first_name'))
              #set ($lastName = $userObj.getValue('last_name'))
              #set($displayProprietaire = "${firstName} ${lastName}")
            #else
              #set($displayProprietaire = $proprietaireValue)
            #end

            #if ($typeValue == "commun")
            ##if ($definitionValue == "personnel" && $proprietaireValue == "DOE")
              <tr class="secondary-term-row" data-acronym="$!acronymeValue.toUpperCase()" data-doc-name="$!docName" data-full-ref="$!fullRef">
                <td class="secondary-acronym">
                  <span class="view-mode"><strong>$!acronymeValue</strong></span>
                  <input type="text" class="form-control edit-mode edit-acronym" value="$!acronymeValue" style="display:none; width:100%;">
                </td>
                <td class="secondary-label">
                  <span class="view-mode">$escapetool.html($!libelleValue)</span>
                  <input type="text" class="form-control edit-mode edit-label" value="$escapetool.html($!libelleValue)" style="display:none; width:100%;">
                </td>
                <td class="secondary-definition">
                  <span class="view-mode">$escapetool.html($!definitionValue)</span>
                  <textarea class="form-control edit-mode edit-definition" style="display:none; width:100%;" rows="2">$escapetool.html($!definitionValue)</textarea>
                </td>
                <td class="secondary-proprietaire">
                  <span class="view-mode">$escapetool.html($!displayProprietaire)</span>
                  <div class="edit-mode edit-proprietaire" name="monChoix" style="display:none">
                    <select class="xwiki-selectize secondary-proprietaire-value">
                      <option value="$proprietaireValue">$escapetool.html($!displayProprietaire)</option>
                      #foreach($managerRef in $managers)
                        #set($managerDoc = $xwiki.getDocument($managerRef))
                        #set($managerId = $managerDoc.name)
                        #set($managerObj = $managerDoc.getObject('XWiki.XWikiUsers'))
                        #if($managerObj && $proprietaireValue != $managerId)
                          #set($managerFirstName = $managerObj.getValue('first_name'))
                          #set($managerLastName = $managerObj.getValue('last_name'))
                          #set($displayManager = "${managerFirstName} ${managerLastName}")
                        #else
                          #set($displayManager = $managerId)
                        #end
                        #if ($proprietaireValue != $managerId)
                          <option value="$managerId">$escapetool.html($!displayManager)</option>
                        #end
                      #end
                    </select>
                  </div>
                </td>

                <td class="col-type secondary-type">
                  <span class="view-mode">$!typeValue</span>
                  <select id="typeVisibilite" class="form-control edit-mode edit-type-input" style="display:none;" required>
                    <option value="$!typeValue" selected>$!typeValue</option>
                    #if ($!typeValue == "personnel")
                      #set($typeValue = "commun")
                    #else
                      #set($typeValue = "personnel")
                    #end

                    #if ($currentUserIsManager)
                      <option value="$typeValue" name="type">$typeValue</option>
                    #else
                      <option value="$typeValue" name="type" disabled>$typeValue (Réservé aux RIVQ)</option>
                    #end
                  </select>
                </td>

                <td>
                  <div class="view-buttons">
                    <button type="button" class="btn btn-xs btn-primary custom-action-btn" onclick="toggleEditMode2(this, true);">
                      <span class="glyphicon glyphicon-pencil"></span>
                    </button>
                    <button type="button" class="btn btn-xs btn-danger custom-action-btn" onclick="openDeleteModal2(this);">
                      <span class="glyphicon glyphicon-trash"></span>
                    </button>
                  </div>
                  <div class="edit-buttons" style="display:none; gap: 5px;">
                    <button type="button" class="btn btn-xs btn-success" onclick="saveRowEdition2(this);">
                      <span class="glyphicon glyphicon-ok"></span> Sauver
                    </button>
                    <button type="button" class="btn btn-xs btn-default" onclick="toggleEditMode2(this, false);">
                      <span class="glyphicon glyphicon-remove"></span>
                    </button>
                  </div>
                </td>
              </tr>
            #end
          #end
        #end
      </tbody>
    </table>
  </div>
</div>


## --- 4. POPUP UNIQUE POUR LES ACTIONS PERSONNALISÉES (MODALE) ---
<div id="actionFeedbackModal" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-label="Fermer"><span aria-hidden="true">&times;</span></button>
        <h4 class="modal-title" id="feedbackModalTitle">Action Personnalisée</h4>
      </div>
      <div class="modal-body">
        <p id="feedbackModalBodyText">Contenu par défaut...</p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-default" data-dismiss="modal">Fermer</button>
      </div>
    </div>
  </div>
</div>

#set($urlLiensData = $xwiki.getURL("TestPage.PAGE.Liens.DATA.WebHome", "view"))

<script type="text/javascript">
  // Variable globale accessible par votre extension JS
  var urlLienData = "$escapetool.javascript($urlLiensData)";
</script>


## --- MODALE DE CONFIRMATION DE SUPPRESSION ---
<div class="modal fade" id="deleteConfirmModal" tabindex="-1" role="dialog" aria-hidden="true">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header" style="background-color: #d9534f; color: white;">
        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
        <h4 class="modal-title" id="deleteModalTitle">Confirmer la suppression</h4>
      </div>
      <div class="modal-body">
        <p>Êtes-vous sûr de vouloir supprimer définitivement cet élément ainsi que sa page XWiki ?</p>
        <table class="table table-bordered table-condensed" style="background: #f9f9f9;">
          <thead>
            <tr>
              <th>Acronyme</th>
              <th>Libellé complet</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td id="deleteModalAcronym" style="font-weight: bold;"></td>
              <td id="deleteModalLabel"></td>
            </tr>
          </tbody>
        </table>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-default" data-dismiss="modal">Annuler</button>
        <button type="button" class="btn btn-danger" id="btnConfirmDelete" onclick="executeRowDelete();">Supprimer</button>
      </div>
    </div>
  </div>
</div>

## --- MODALE DE CONFIRMATION DE SUPPRESSION ---
<div class="modal fade" id="deleteConfirmModal2" tabindex="-1" role="dialog" aria-hidden="true">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header" style="background-color: #d9534f; color: white;">
        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
        <h4 class="modal-title" id="deleteModalTitle">Confirmer la suppression</h4>
      </div>
      <div class="modal-body">
        <p>Êtes-vous sûr de vouloir supprimer définitivement cet élément ainsi que sa page XWiki ?</p>
        <table class="table table-bordered table-condensed" style="background: #f9f9f9;">
          <thead>
            <tr>
              <th>Acronyme</th>
              <th>Libellé complet</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td id="deleteModalAcronym2" style="font-weight: bold;"></td>
              <td id="deleteModalLabel2"></td>
            </tr>
          </tbody>
        </table>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-default" data-dismiss="modal">Annuler</button>
        <button type="button" class="btn btn-danger" id="btnConfirmDelete" onclick="executeRowDelete2();">Supprimer</button>
      </div>
    </div>
  </div>
</div>


## --- 6. BLOC MODAL DE CRÉATION (VOTRE POPUP D'ORIGINE) ---
<div class="modal fade" id="glossaryModal" tabindex="-1" role="dialog" aria-labelledby="glossaryModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-label="Fermer"><span aria-hidden="true">&times;</span></button>
        <h4 class="modal-title" id="glossaryModalLabel">Nouveau terme du Glossaire</h4>
      </div>

      <form method="post" action="">
        <input type="hidden" name="action" value="checkAndCreate" />

        <div class="modal-body">
          <div class="row">
            ## PARTIE GAUCHE : Formulaire de saisie
            <div class="col-md-5 modal-left-column">
              <h5 class="column-title">Informations du terme</h5>
              <div class="form-group">
                <label>Acronyme / Sigle (ex: API) :</label>
                <input type="text" id="liensNomInputField" name="acronyme" class="form-control" autocomplete="off" required placeholder="Ex: XWiki" oninput="triggerGlobalFilter();">
              </div>
              <div class="form-group">
                <label>Libellé complet :</label>
                <input type="text" id="liensInputField" name="libelle" class="form-control" autocomplete="off" required placeholder="Ex: Wiki d'entreprise open source" oninput="triggerGlobalFilter();">
              </div>
              <div class="form-group">
                <label>Libellé complet :</label>
                <input type="text" id="definitionInputField" name="definition" class="form-control" autocomplete="off" required placeholder="Ex: Wiki d'entreprise open source">
              </div>

              <div class="form-group">
                <label for="typeVisibilite">Type :</label>
                <select id="typeVisibilite" name="type" class="form-control" required>
                  <option value="personnel" selected>Personnel</option>
                  #if ($currentUserIsManager)
                    <option value="commun" name="type">Commun</option>
                  #else
                    <option value="commun" name="type" disabled>Commun (Réservé aux RIVQ)</option>
                  #end
                </select>
              </div>
            </div>

            ## PARTIE DROITE : Tableau HTML natif filtré de vérification
            <div class="col-md-7 modal-right-column">
              <h5 class="column-title warning-title">Vérification des existants</h5>
              <p class="text-muted help-text">Ce tableau affiche les lignes dont l'acronyme ou le libellé correspond à votre saisie.</p>

              <div class="table-scroll-container">
                <table class="table table-striped table-hover" id="popupCheckTable">
                  <thead>
                    <tr>
                      <th style="width: 30%;">Acronyme</th>
                      <th>Libellé complet</th>
                    </tr>
                  </thead>
                  <tbody>
                    ## 2. On cherche TOUS les documents qui possèdent cette classe spécifique
                    #set ($statement = "select distinct doc.fullName from Document doc, doc.object($classPath) obj")
                    #set ($query = $services.query.xwql($statement))
                    #set ($documentNames = $query.execute())
                    ## 3. On boucle sur chaque document trouvé
                    #foreach ($docName in $documentNames)

                      ## On charge la page
                      #set ($targetDoc = $xwiki.getDocument($docName))

                      ## On récupère l'objet lié à cette page
                      #set ($targetObject = $targetDoc.getObject($classPath))

                      #if ($targetObject)
                        #set ($acronyme = $targetObject.getValue('nom_lien'))
                        #set ($libelle = $targetObject.getValue('lien'))
                        #set ($type = $targetObject.getValue('type'))
                        <tr class="term-row" data-full-ref="$docName">
                          <td class="term-acronym">$acronyme</td>
                          <td class="term-label">$libelle</td>
                        </tr>
                      #end
                    #end
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>

        <div class="modal-footer">
          <button type="button" class="btn btn-default" data-dismiss="modal">Annuler</button>
          <button type="submit" class="btn btn-primary">Valider et Vérifier l'existence</button>
        </div>
      </form>
    </div>
  </div>
</div>

{{/html}}
{{/velocity}}
