## --- 1. AFFICHAGE DES NOTIFICATIONS (POST-REDIRECTION) ---
#set($status = $request.session.getAttribute('liens_status'))
#if($status)
  #set($msg = $request.session.getAttribute('liens_msg'))
  #set($url = $request.session.getAttribute('liens_url'))

  #if($status == 'success')
    <div class="alert alert-success" style="margin-bottom: 20px;">
      <strong>Succès !</strong> Le lien <strong>$escapetool.xml($!msg)</strong> a été ajouté à la base de données.
      <a href="$escapetool.xml($!url)" target="_blank" class="btn btn-xs btn-default" style="margin-left: 10px;">Ouvrir la fiche</a>
    </div>
  #elseif($status == 'warning')
    <div class="alert alert-warning" style="margin-bottom: 20px;">
      <strong>Information :</strong> Le lien <strong>$escapetool.xml($!msg)</strong> existait déjà. Une nouvelle fiche distincte a tout de même été créée avec succès.
      <a href="$escapetool.xml($!url)" target="_blank" class="btn btn-xs btn-default" style="margin-left: 10px;">Ouvrir la nouvelle fiche</a>
    </div>
  #end

  $request.session.removeAttribute('liens_status')
  $request.session.removeAttribute('liens_msg')
  $request.session.removeAttribute('liens_url')
#end


<div class="liens-page"
     data-user-id="$escapetool.xml($userId)"
     data-csrf="$escapetool.xml($services.csrf.getToken())"
     data-endpoint-url="$escapetool.xml($urlLiensData)"
     data-can-read-personal="$canReadPersonal" data-can-write-personal="$canWritePersonal"
     data-can-read-common="$canReadCommon" data-can-write-common="$canWriteCommon"
     data-can-configure="$canConfigure">
  <div class="li-shell">
    <header class="li-header">
      <span class="li-header-accent" aria-hidden="true"></span>
      <h1 class="li-title">Bienvenue dans les liens du wiki</h1>
      <p class="li-subtitle">Retrouvez ici vos liens personnels et les liens communs du wiki.</p>
    </header>

#if($canReadPersonal)
<button type="button" class="tablinks btn-primary" data-liens-tab="Tab1" onclick="openTab(event, 'Tab1')">Mes Liens</button>
#end
#if($canReadCommon)
<button type="button" class="tablinks btn-primary" data-liens-tab="Tab2" onclick="openTab(event, 'Tab2')">Liens Communs</button>
#end
#if(!$canReadPersonal && !$canReadCommon)
<p class="alert alert-info liens-no-access">Vous ne disposez d’aucun droit de lecture sur les liens.</p>
#end

<div id="liensToolbar" class="row glossary-toolbar" style="margin-bottom:15px;">
  <div id="liensToolbarLeft" class="col-md-6 glossary-toolbar-left">
    #if($canWritePersonal || $canWriteCommon)
    <button type="button" class="btn btn-success" data-toggle="modal" data-target="#glossaryModal">$services.icon.renderHTML('add') Ajouter un lien</button>
    #end
  </div>
  <div id="liensToolbarRight" class="col-md-6 glossary-toolbar-right">
    <div id="liensImportToolbar" class="glossary-import-toolbar"></div>
    #if($canConfigure)
    <button type="button" id="btnLiensSettings" class="btn btn-default" data-toggle="modal" data-target="#liensSettingsModal">Paramètres</button>
    #end
  </div>
</div>

#if($canWriteCommon)
<select id="liensAuthorOptions" data-author-source="common-write-groups" hidden disabled aria-hidden="true" tabindex="-1">
  #foreach($linkAuthor in $linkAuthors)
  <option value="$escapetool.xml($linkAuthor.id)" data-label="$escapetool.xml($linkAuthor.label)" data-reverse-label="$escapetool.xml($linkAuthor.reverseLabel)" data-reference="$escapetool.xml($linkAuthor.reference)">$escapetool.html($linkAuthor.label) ($escapetool.html($linkAuthor.id))</option>
  #end
</select>
#end

#set($documentRefs = [])
#if($canReadPersonal || $canReadCommon)
  #set($statement = 'select distinct doc.fullName from XWikiDocument doc, BaseObject obj where obj.name = doc.fullName and obj.className = :className')
  #set($documentRefs = $services.query.hql($statement).bindValue('className', $classPath).execute())
#end

## ----- TAB1 ----- ##
#if($canReadPersonal)
<div id="Tab1" class="tabcontent">
  <div id="debug1"></div>

  ## --- BLOC DE NAVIGATION POUR LA PAGINATION ---
  <div class="pagination-container" style="display: flex; justify-content: space-between; align-items: center; margin-top: 15px; padding: 10px; background: #f9f9f9; border: 1px solid #ddd; border-radius: 4px;">
    <!-- Sélecteur de taille de page -->
    <div>
      <label for="pageSizeSelect1" style="margin-right: 5px; font-weight: normal;">Éléments par page :</label>
      <select id="pageSizeSelect1" onchange="changePageSize();" style="padding: 4px 8px; border-radius: 4px; border: 1px solid #ccc;">
        <option value="5">5</option>
        <option value="10" selected>10</option>
        <option value="25">25</option>
        <option value="50">50</option>
        <option value="all">Tout afficher</option>
      </select>
    </div>

    <!-- Flèches et indicateur de page -->
    <div style="display: flex; align-items: center; gap: 15px;">
      <button type="button" id="btnPrevPage1" class="btn btn-default btn-sm" onclick="navigatePage(-1);" style="padding: 5px 10px;">
        $services.icon.renderHTML('left')
      </button>
      <span id="pageIndicator1" style="font-weight: bold; min-width: 80px; text-align: center;">Page 1 / 1</span>
      <button type="button" id="btnNextPage1" class="btn btn-default btn-sm" onclick="navigatePage(1);" style="padding: 5px 10px;">
        $services.icon.renderHTML('right')
      </button>
    </div>
  </div>

  ## --- 5. TABLEAU PRINCIPAL GLOSSAIRE MAISON WITH COLUMN FILTERS & PAGINATION ---
  <div class="table-responsive">
    <!-- On conserve data-csrf et data-class-path sur la table -->
    <table class="table table-striped table-hover table-bordered hide-type-column"
           id="mainGlossaryTable"
           data-csrf="$escapetool.xml($services.csrf.getToken())"
           data-class-path="$escapetool.xml($!classPath)"
           data-current-user="$escapetool.xml($userId)"
           data-icon-right="$escapetool.xml($services.icon.renderHTML('right'))"
           data-icon-pencil="$escapetool.xml($services.icon.renderHTML('pencil'))"
           data-icon-trash="$escapetool.xml($services.icon.renderHTML('trash'))"
           data-icon-check="$escapetool.xml($services.icon.renderHTML('check'))"
           data-icon-cross="$escapetool.xml($services.icon.renderHTML('cross'))"
           data-icon-eye="$escapetool.xml($services.icon.renderHTML('eye'))"
           data-icon-download="$escapetool.xml($services.icon.renderHTML('download'))"
           data-icon-refresh="$escapetool.xml($services.icon.renderHTML('refresh'))">
      <thead>
        <tr>
          <th style="width: 15%;">Liens</th>
          <th style="width: 25%;">Domaine</th>
          <th style="width: 25%;">Définition</th>
          <!-- La colonne Type a désormais sa propre classe pour être masquée -->
          <th class="col-type" style="width: 10%;">Type</th>
          #if($canWritePersonal)<th class="liens-actions" style="width:15%;">Actions</th>#end
        </tr>
        <tr class="filter-row">
          <th><input type="text" id="filterAcronym" placeholder="Filtrer..." oninput="filterMainTableColumns();"></th>
          <th><input type="text" id="filterLabel" placeholder="Filtrer..." oninput="filterMainTableColumns();"></th>
          <th><input type="text" id="filterDefinition" placeholder="Filtrer..." oninput="filterMainTableColumns();"></th>
          <!-- Case vide pour le filtre de la colonne Type lorsqu'elle apparaît -->
          <th class="col-type" style="background-color: #f9f9f9;"></th>
          #if($canWritePersonal)<th class="liens-actions" style="background-color:#f9f9f9;"></th>#end
        </tr>
      </thead>
      <tbody>
        ## 3. On boucle sur chaque document trouvé
        #foreach ($fullRef in $documentRefs)
          ## On charge la page
          #set ($targetDoc = $xwiki.getDocument($fullRef))
          #set ($docName = $targetDoc.getName())
          ## On récupère l'objet lié à cette page
          #set ($targetObject = $targetDoc.getObject($classPath))

          #if ($targetObject && $xwiki.hasAccessLevel('view', $user, $targetDoc.fullName))
            #set ($acronymeValue = $targetObject.getValue('nom_lien'))
            #set ($libelleValue = $targetObject.getValue('lien'))
            #set ($definitionValue = $targetObject.getValue('definition'))
            #set ($typeValue = $targetObject.getValue('type'))
            #set ($proprietaireValue = "$!targetObject.getValue('proprietaire')")
            #liensCheckCurrentOwner($proprietaireValue)
            #if ($typeValue == "personnel" && $isCurrentLinkOwner)
              <tr class="main-term-row" data-acronym="$escapetool.html($!acronymeValue.toUpperCase())" data-doc-name="$escapetool.xml($!docName)" data-full-ref="$escapetool.xml($!fullRef)">
                <td class="main-acronym">
                  <span class="view-mode"><strong>$escapetool.html($!acronymeValue)</strong></span>
                  <input type="text" class="form-control edit-mode edit-acronym" value="$escapetool.html($!acronymeValue)" style="display:none; width:100%;">
                </td>
                <td class="main-label">
                  <span class="view-mode">$escapetool.html($!libelleValue)</span>
                  <input type="text" class="form-control edit-mode edit-label" value="$escapetool.html($!libelleValue)" style="display:none; width:100%;">
                </td>
                <td class="main-definition">
                  <span class="view-mode">$escapetool.html($!definitionValue)</span>
                  <textarea class="form-control edit-mode edit-definition" style="display:none; width:100%;" rows="2">$escapetool.html($!definitionValue)</textarea>
                </td>

                <!-- NOUVELLE COLONNE TYPE : Toujours présente mais masquée par le CSS du tableau -->
                <td class="col-type main-type">
                  <span class="view-mode">$escapetool.xml($!typeValue)</span>

                  <select class="form-control edit-mode edit-type-input" style="display:none;" required>
                    <option value="personnel" selected>Personnel</option>
                    #if ($canWriteCommon)
                      <option value="commun" name="type">Commun</option>
                    #else
                      <option value="commun" name="type" disabled>Commun (écriture non autorisée)</option>
                    #end
                  </select>
                </td>

                #if($canWritePersonal)
                <td class="liens-actions">
                  <div class="view-buttons">
                    <button type="button" class="btn btn-xs btn-primary custom-action-btn" onclick="toggleEditMode(this, true);">
                      $services.icon.renderHTML('pencil')
                    </button>
                    <button type="button" class="btn btn-xs btn-danger custom-action-btn" onclick="openDeleteModal(this);">
                      $services.icon.renderHTML('trash')
                    </button>
                  </div>
                  <div class="edit-buttons" style="display:none; gap: 5px;">
                    <button type="button" class="btn btn-xs btn-success" onclick="saveRowEdition(this);">
                      $services.icon.renderHTML('check') Enregistrer
                    </button>
                    <button type="button" class="btn btn-xs btn-default" onclick="toggleEditMode(this, false);">
                      $services.icon.renderHTML('cross')
                    </button>
                  </div>
                </td>
                #end
              </tr>
            #end
          #end
        #end
      </tbody>
    </table>
  </div>
</div>


#end

## ----- TAB2 ----- ##
#if($canReadCommon)
<div id="Tab2" class="tabcontent">
  <div id="debug2"></div>

  ## --- BLOC DE NAVIGATION POUR LA PAGINATION ---
  <div class="pagination-container" style="display: flex; justify-content: space-between; align-items: center; margin-top: 15px; padding: 10px; background: #f9f9f9; border: 1px solid #ddd; border-radius: 4px;">
    <!-- Sélecteur de taille de page -->
    <div>
      <label for="pageSizeSelect2" style="margin-right: 5px; font-weight: normal;">Éléments par page :</label>
      <select id="pageSizeSelect2" onchange="changePageSize2();" style="padding: 4px 8px; border-radius: 4px; border: 1px solid #ccc;">
        <option value="5">5</option>
        <option value="10" selected>10</option>
        <option value="25">25</option>
        <option value="50">50</option>
        <option value="all">Tout afficher</option>
      </select>
    </div>

    <!-- Flèches et indicateur de page -->
    <div style="display: flex; align-items: center; gap: 15px;">
      <button type="button" id="btnPrevPage2" class="btn btn-default btn-sm" onclick="navigatePage2(-1);" style="padding: 5px 10px;">
        $services.icon.renderHTML('left')
      </button>
      <span id="pageIndicator2" style="font-weight: bold; min-width: 80px; text-align: center;">Page 1 / 1</span>
      <button type="button" id="btnNextPage2" class="btn btn-default btn-sm" onclick="navigatePage2(1);" style="padding: 5px 10px;">
        $services.icon.renderHTML('right')
      </button>
    </div>
  </div>

  ## --- 5. TABLEAU PRINCIPAL GLOSSAIRE MAISON WITH COLUMN FILTERS & PAGINATION ---
  <div class="table-responsive">
    <!-- On conserve data-csrf et data-class-path sur la table -->
    <table class="table table-striped table-hover table-bordered hide-type-column"
           id="secondaryGlossaryTable"
           data-csrf="$escapetool.xml($services.csrf.getToken())"
           data-class-path="$escapetool.xml($!classPath)"
           data-icon-right="$escapetool.xml($services.icon.renderHTML('right'))"
           data-icon-pencil="$escapetool.xml($services.icon.renderHTML('pencil'))"
           data-icon-trash="$escapetool.xml($services.icon.renderHTML('trash'))"
           data-icon-check="$escapetool.xml($services.icon.renderHTML('check'))"
           data-icon-cross="$escapetool.xml($services.icon.renderHTML('cross'))"
           data-icon-eye="$escapetool.xml($services.icon.renderHTML('eye'))"
           data-icon-download="$escapetool.xml($services.icon.renderHTML('download'))"
           data-icon-refresh="$escapetool.xml($services.icon.renderHTML('refresh'))">
      <thead>
        <tr>
          <th style="width: 15%;">Liens</th>
          <th style="width: 25%;">Domaine</th>
          <th style="width: 25%;">Définition</th>
          <th style="width: 10%;">Créateur</th>
          <th class="col-type" style="width: 10%;">Type</th>
          #if($canWriteCommon)<th class="liens-actions" style="width:15%;">Actions</th>#end
        </tr>
        <tr class="filter-row">
          <th><input type="text" id="filterAcronym2" placeholder="Filtrer..." oninput="filterSecondaryTableColumns();"></th>
          <th><input type="text" id="filterLabel2" placeholder="Filtrer..." oninput="filterSecondaryTableColumns();"></th>
          <th><input type="text" id="filterDefinition2" placeholder="Filtrer..." oninput="filterSecondaryTableColumns();"></th>
          <th><input type="text" id="filterProprietaire2" placeholder="Filtrer..." oninput="filterSecondaryTableColumns();"></th>
          <th class="col-type" style="background-color: #f9f9f9;"></th>
          #if($canWriteCommon)<th class="liens-actions" style="background-color:#f9f9f9;"></th>#end
        </tr>
      </thead>
      <tbody>
        #set ($userObj = $null)
        #set ($firstName = $null)
        #set ($lastName = $null)
        #set ($displayProprietaire = $null)
        #set ($proprietaireValue = $null)

        #foreach ($fullRef in $documentRefs)
          ## On charge la page
          #set ($targetDoc = $xwiki.getDocument($fullRef))
          #set ($docName = $targetDoc.getName())
          ## On récupère l'objet lié à cette page
          #set ($targetObject = $targetDoc.getObject($classPath))
          #if ($targetObject && $xwiki.hasAccessLevel('view', $user, $targetDoc.fullName))
            #set ($acronymeValue = $targetObject.getValue('nom_lien'))
            #set ($libelleValue = $targetObject.getValue('lien'))
            #set ($definitionValue = $targetObject.getValue('definition'))
            #set ($typeValue = $targetObject.getValue('type'))
            #set ($proprietaireValue = $targetObject.getValue('proprietaire'))

            ## Le propriétaire peut être une référence qualifiée d'un autre wiki.
            #set($userPageRef = $services.model.createDocumentReference('', ['XWiki'], $proprietaireValue))
            #if($proprietaireValue.contains(':')) #set($userPageRef = $services.model.resolveDocument($proprietaireValue)) #end
            #if($proprietaireValue == $userId) #set($userPageRef = $currentUserReference) #end
            #set($userDoc = false)
            #set($userDoc = $xwiki.getDocument($userPageRef))
            #set($userObj = false)
            #if($userDoc) #set($userObj = $userDoc.getObject('XWiki.XWikiUsers')) #end
            #set($displayProprietaire = $proprietaireValue)
            #if($userObj)
              #set($firstName = "$!userObj.getValue('first_name')")
              #set($lastName = "$!userObj.getValue('last_name')")
              #set($displayProprietaire = "$firstName $lastName")
              #set($displayProprietaire = $displayProprietaire.trim())
              #if($displayProprietaire == '') #set($displayProprietaire = $proprietaireValue) #end
            #end

            #if ($typeValue == "commun")
            ##if ($definitionValue == "personnel" && $proprietaireValue == "DOE")
              <tr class="secondary-term-row" data-acronym="$escapetool.xml($!acronymeValue.toUpperCase())" data-doc-name="$escapetool.xml($!docName)" data-full-ref="$escapetool.xml($!fullRef)">
                <td class="secondary-acronym">
                  <span class="view-mode"><strong>$escapetool.xml($!acronymeValue)</strong></span>
                  <input type="text" class="form-control edit-mode edit-acronym" value="$escapetool.xml($!acronymeValue)" style="display:none; width:100%;">
                </td>
                <td class="secondary-label">
                  <span class="view-mode">$escapetool.html($!libelleValue)</span>
                  <input type="text" class="form-control edit-mode edit-label" value="$escapetool.html($!libelleValue)" style="display:none; width:100%;">
                </td>
                <td class="secondary-definition">
                  <span class="view-mode">$escapetool.html($!definitionValue)</span>
                  <textarea class="form-control edit-mode edit-definition" style="display:none; width:100%;" rows="2">$escapetool.html($!definitionValue)</textarea>
                </td>
                <td class="secondary-proprietaire">
                  <span class="view-mode">$escapetool.html($!displayProprietaire)</span>
                  <div class="edit-mode edit-proprietaire" name="monChoix" style="display:none">
                    <select class="xwiki-selectize secondary-proprietaire-value">
                      #set($editingOwnerId = $proprietaireValue)
                      #set($listedOwner = false)
                      #foreach($linkAuthor in $linkAuthors)
                        #if($proprietaireValue == $linkAuthor.id) #set($listedOwner = true) #end
                      #end
                      #if(!$listedOwner && ($proprietaireValue.startsWith('XWiki.') || $proprietaireValue.contains(':')))
                        #set($editingOwnerReference = $services.model.resolveDocument($proprietaireValue))
