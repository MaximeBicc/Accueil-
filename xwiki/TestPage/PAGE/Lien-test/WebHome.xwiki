#set($currentUserIsManager = false)
#foreach($managerReference in $managers)
  #if("$managerReference" == "$user")
    #set($currentUserIsManager = true)
  #end
#end

<button class="tablinks btn-primary" onclick="openTab(event, 'Tab1')">Mes Liens</button>
<button class="tablinks btn-primary" onclick="openTab(event, 'Tab2')">Liens Communs</button>

## --- 3. BOUTON D'AJOUT ---
<div class="row" style="margin-bottom: 15px;">
  <div class="col-md-6">
    <button type="button" class="btn btn-success" data-toggle="modal" data-target="#glossaryModal">
      + Ajouter un nouvel acronyme
    </button>
  </div>
</div>


## ----- TAB1 ----- ##
<div id="Tab1" class="tabcontent">
  <div id="debug1"></div>

  ## --- BLOC DE NAVIGATION POUR LA PAGINATION ---
  <div class="pagination-container" style="display: flex; justify-content: space-between; align-items: center; margin-top: 15px; padding: 10px; background: #f9f9f9; border: 1px solid #ddd; border-radius: 4px;">
    <!-- Sélecteur de taille de page -->
    <div>
      <label for="pageSizeSelect1" style="margin-right: 5px; font-weight: normal;">Éléments par page :</label>
      <select id="pageSizeSelect1" onchange="changePageSize();" style="padding: 4px 8px; border-radius: 4px; border: 1px solid #ccc;">
        <option value="5">5</option>
        <option value="10" selected>10</option>
        <option value="25">25</option>
        <option value="50">50</option>
        <option value="all">Tout afficher</option>
      </select>
    </div>

    <!-- Flèches et indicateur de page -->
    <div style="display: flex; align-items: center; gap: 15px;">
      <button type="button" id="btnPrevPage1" class="btn btn-default btn-sm" onclick="navigatePage(-1);" style="padding: 5px 10px;">
        <span class="glyphicon glyphicon-chevron-left"></span>
      </button>
      <span id="pageIndicator1" style="font-weight: bold; min-width: 80px; text-align: center;">Page 1 / 1</span>
      <button type="button" id="btnNextPage1" class="btn btn-default btn-sm" onclick="navigatePage(1);" style="padding: 5px 10px;">
        <span class="glyphicon glyphicon-chevron-right"></span>
      </button>
    </div>
  </div>

  ## --- 5. TABLEAU PRINCIPAL GLOSSAIRE MAISON WITH COLUMN FILTERS & PAGINATION ---
  <div class="table-responsive">
    <!-- On conserve data-csrf et data-class-path sur la table -->
    <table class="table table-striped table-hover table-bordered hide-type-column"
           id="mainGlossaryTable"
           data-csrf="$services.csrf.getToken()"
           data-class-path="$!classPath">
      <thead>
        <tr>
          <th style="width: 15%;">Acronyme</th>
          <th style="width: 25%;">Libellé complet</th>
          <th style="width: 25%;">Définition</th>
          <!-- La colonne Type a désormais sa propre classe pour être masquée -->
          <th class="col-type" style="width: 10%;">Type</th>
          <th style="width: 15%;">Actions</th>
        </tr>
        <tr class="filter-row">
          <th><input type="text" id="filterAcronym" placeholder="Filtrer..." oninput="filterMainTableColumns();"></th>
          <th><input type="text" id="filterLabel" placeholder="Filtrer..." oninput="filterMainTableColumns();"></th>
          <th><input type="text" id="filterDefinition" placeholder="Filtrer..." oninput="filterMainTableColumns();"></th>
          <!-- Case vide pour le filtre de la colonne Type lorsqu'elle apparaît -->
          <th class="col-type" style="background-color: #f9f9f9;"></th>
          <th style="background-color: #f9f9f9;"></th>
        </tr>
      </thead>
      <tbody>
        #set ($statement = "select distinct doc.fullName from Document doc, doc.object($classPath) obj")
        #set ($query = $services.query.xwql($statement))
        #set ($documentRefs = $query.execute())
        ## 3. On boucle sur chaque document trouvé
        #foreach ($fullRef in $documentRefs)
          ## On charge la page
          #set ($targetDoc = $xwiki.getDocument($fullRef))
          #set ($docName = $targetDoc.getName())
          ## On récupère l'objet lié à cette page
          #set ($targetObject = $targetDoc.getObject($classPath))

          #if ($targetObject)
            #set ($acronymeValue = $targetObject.getValue('nom_lien'))
            #set ($libelleValue = $targetObject.getValue('lien'))
            #set ($definitionValue = $targetObject.getValue('definition'))
            #set ($typeValue = $targetObject.getValue('type'))
            #set ($proprietaireValue = $targetObject.getValue('proprietaire'))
            #if ($typeValue == "personnel" && $proprietaireValue == $userId)
              <tr class="main-term-row" data-acronym="$escapetool.html($!acronymeValue.toUpperCase())" data-doc-name="$!docName" data-full-ref="$!fullRef">
                <td class="main-acronym">
                  <span class="view-mode"><strong>$escapetool.html($!acronymeValue)</strong></span>
                  <input type="text" class="form-control edit-mode edit-acronym" value="$escapetool.html($!acronymeValue)" style="display:none; width:100%;">
                </td>
                <td class="main-label">
                  <span class="view-mode">$escapetool.html($!libelleValue)</span>
                  <input type="text" class="form-control edit-mode edit-label" value="$escapetool.html($!libelleValue)" style="display:none; width:100%;">
                </td>
                <td class="main-definition">
                  <span class="view-mode">$escapetool.html($!definitionValue)</span>
                  <textarea class="form-control edit-mode edit-definition" style="display:none; width:100%;" rows="2">$escapetool.html($!definitionValue)</textarea>
                </td>

                <!-- NOUVELLE COLONNE TYPE : Toujours présente mais masquée par le CSS du tableau -->
                <td class="col-type main-type">
                  <span class="view-mode">$!typeValue</span>

                  <select id="typeVisibilite" class="form-control edit-mode edit-type-input" style="display:none;" required>
                    <option value="personnel" selected>Personnel</option>
                    #if ($currentUserIsManager)
                      <option value="commun" name="type">Commun</option>
                    #else
                      <option value="commun" name="type" disabled>Commun (Réservé aux RIVQ)</option>
                    #end
                  </select>
                </td>

                <td>
                  <div class="view-buttons">
                    <button type="button" class="btn btn-xs btn-primary custom-action-btn" onclick="toggleEditMode(this, true);">
                      <span class="glyphicon glyphicon-pencil"></span>
                    </button>
                    <button type="button" class="btn btn-xs btn-danger custom-action-btn" onclick="openDeleteModal(this);">
                      <span class="glyphicon glyphicon-trash"></span>
                    </button>
                  </div>
                  <div class="edit-buttons" style="display:none; gap: 5px;">
                    <button type="button" class="btn btn-xs btn-success" onclick="saveRowEdition(this);">
                      <span class="glyphicon glyphicon-ok"></span> Sauver
                    </button>
                    <button type="button" class="btn btn-xs btn-default" onclick="toggleEditMode(this, false);">
                      <span class="glyphicon glyphicon-remove"></span>
                    </button>
                  </div>
                </td>
              </tr>
            #end
          #end
        #end
      </tbody>
    </table>
  </div>
</div>


## ----- TAB2 ----- ##
<div id="Tab2" class="tabcontent">
  <div id="debug2"></div>

  ## --- BLOC DE NAVIGATION POUR LA PAGINATION ---
  <div class="pagination-container" style="display: flex; justify-content: space-between; align-items: center; margin-top: 15px; padding: 10px; background: #f9f9f9; border: 1px solid #ddd; border-radius: 4px;">
