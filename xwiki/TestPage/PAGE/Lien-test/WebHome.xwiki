      </div>
    </div>
  </div>
</div>


## --- 6. BLOC MODAL DE CRÉATION (VOTRE POPUP D'ORIGINE) ---
<div class="modal fade" id="glossaryModal" tabindex="-1" role="dialog" aria-labelledby="glossaryModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-label="Fermer" title="Fermer">$services.icon.renderHTML('cross')</button>
        <h4 class="modal-title" id="glossaryModalLabel">Ajouter un lien</h4>
      </div>

      <form method="post" action="">
        <input type="hidden" name="action" value="checkAndCreate" />
        <input type="hidden" name="form_token" value="$escapetool.xml($services.csrf.getToken())" />

        <div class="modal-body">
          <div class="row">
            ## PARTIE GAUCHE : Formulaire de saisie
            <div class="col-md-5 modal-left-column">
              <h5 class="column-title">Informations du lien</h5>
              <div class="form-group">
                <label>Liens :</label>
                <input type="text" id="liensNomInputField" name="acronyme" class="form-control" autocomplete="off" required placeholder="Ex: XWiki" oninput="triggerGlobalFilter();">
              </div>
              <div class="form-group">
                <label>Domaine :</label>
                <input type="text" id="liensInputField" name="libelle" class="form-control" autocomplete="off" required placeholder="Ex: Informatique" oninput="triggerGlobalFilter();">
              </div>
              <div class="form-group">
                <label for="definitionInputField">Définition :</label>
                <input type="text" id="definitionInputField" name="definition" class="form-control" autocomplete="off" required placeholder="Ex: Documentation et collaboration">
              </div>

              <div class="form-group">
                <label for="typeVisibilite">Type :</label>
                <select id="typeVisibilite" name="type" class="form-control" required>
                  <option value="personnel" selected>Personnel</option>
                  #if ($canWriteCommon)
                    <option value="commun" name="type">Commun</option>
                  #else
                    <option value="commun" name="type" disabled>Commun (écriture non autorisée)</option>
                  #end
                </select>
              </div>
            </div>

            ## PARTIE DROITE : Tableau HTML natif filtré de vérification
            <div class="col-md-7 modal-right-column">
              <h5 class="column-title warning-title">Vérification des existants</h5>
              <p class="text-muted help-text">Ce tableau affiche les lignes dont le lien ou le domaine correspond à votre saisie.</p>

              <div class="table-scroll-container">
                <table class="table table-striped table-hover" id="popupCheckTable">
                  <thead>
                    <tr>
                      <th style="width: 30%;">Liens</th>
                      <th>Domaine</th>
                    </tr>
                  </thead>
                  <tbody>
                    ## Réutiliser la liste liée à la classe de cette racine.
                    #set($documentNames = $documentRefs)
                    ## 3. On boucle sur chaque document trouvé
                    #foreach ($docName in $documentNames)

                      ## On charge la page
                      #set ($targetDoc = $xwiki.getDocument($docName))

                      ## On récupère l'objet lié à cette page
                      #set ($targetObject = $targetDoc.getObject($classPath))

                      #if ($targetObject && $xwiki.hasAccessLevel('view', $user, $targetDoc.fullName))
                        #set ($acronyme = $targetObject.getValue('nom_lien'))
                        #set ($libelle = $targetObject.getValue('lien'))
                        #set ($type = $targetObject.getValue('type'))
                        #set($popupOwner = "$!targetObject.getValue('proprietaire')")
                        #liensCheckCurrentOwner($popupOwner)
                        #if(($canReadCommon && $type == 'commun') || ($canReadPersonal && $type == 'personnel' && $isCurrentLinkOwner))
                        <tr class="term-row" data-full-ref="$escapetool.xml($docName)">
                          <td class="term-acronym">$escapetool.xml($!acronyme)</td>
                          <td class="term-label">$escapetool.xml($!libelle)</td>
                        </tr>
                        #end
                      #end
                    #end
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>

        <div class="modal-footer">
          <button type="button" class="btn btn-default" data-dismiss="modal">Annuler</button>
          <button type="submit" class="btn btn-primary">Valider et Vérifier l'existence</button>
        </div>
      </form>
    </div>
  </div>
</div>

#end


<script type="text/javascript">
  // Variable globale accessible par votre extension JS
  var urlLienData = "$escapetool.javascript($urlLiensData)";
</script>


#if($canConfigure)
#set($settingsGroups = ['XWiki.XWikiGuest'])
#set($allGroup = $services.model.serialize($allGroupReference))
#if(!$settingsGroups.contains($allGroup)) #set($discard = $settingsGroups.add($allGroup)) #end
#foreach($groupName in $services.query.xwql('select distinct doc.fullName from Document doc, doc.object(XWiki.XWikiGroups) as grp order by doc.fullName').execute())
  #set($groupReference = $services.model.resolveDocument($groupName))
  #set($canonicalGroup = $services.model.serialize($groupReference))
  #if(!$settingsGroups.contains($canonicalGroup) && $xwiki.hasAccessLevel('view', $user, $canonicalGroup))
    #set($discard = $settingsGroups.add($canonicalGroup))
  #end
#end
#foreach($field in $permissionFields)
  #foreach($groupRef in $configuredGroups.get($field))
    #if(!$settingsGroups.contains($groupRef)) #set($discard = $settingsGroups.add($groupRef)) #end
  #end
#end
#set($levelLabels = ['Aucun accès', 'Lecture', 'Écriture'])
<div class="modal fade" id="liensSettingsModal" tabindex="-1" role="dialog" aria-labelledby="liensSettingsTitle" aria-hidden="true">
  <div class="modal-dialog modal-lg" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-label="Fermer">$services.icon.renderHTML('cross')</button>
        <h4 class="modal-title" id="liensSettingsTitle">Paramètres des liens</h4>
      </div>
      <form id="liensSettingsForm" method="post" action="$escapetool.xml($urlLiensData)">
        <input type="hidden" name="action" value="settings">
        <input type="hidden" name="xpage" value="plain">
        <input type="hidden" name="form_token" value="$escapetool.xml($services.csrf.getToken())">
        <input type="hidden" name="expectedVersion" value="$escapetool.xml($!configuration.version)">
        <input type="hidden" name="groupCount" value="$settingsGroups.size()">
        <input type="hidden" name="settingsForm" value="true">
        <input type="hidden" name="returnTo" value="$escapetool.xml($doc.fullName)">
        <div class="modal-body">
          <p>Les droits des groupes se cumulent. L’écriture inclut la lecture. Écrire dans Commun permet aussi d’écrire dans Personnel. Sans lecture, l’onglet n’apparaît pas.</p>
          <p>Personnel contient uniquement les liens de l’utilisateur connecté.</p>
          #if(!$configurationObject)
          <p class="alert alert-info">La configuration sera créée au premier enregistrement. Les droits existants sont conservés jusque-là.</p>
          #end
          <div class="table-responsive">
            <table class="table table-striped table-bordered liens-permissions-table">
              <thead><tr><th>Groupe XWiki</th><th>Personnel</th><th>Commun</th></tr></thead>
              <tbody>
              #foreach($settingGroup in $settingsGroups)
                #set($settingIndex = $foreach.index)
                #set($personalLevel = 0)
                #set($commonLevel = 0)
                #if($configuredGroups.get('personalReadGroups').contains($settingGroup)) #set($personalLevel = 1) #end
                #if($configuredGroups.get('personalWriteGroups').contains($settingGroup)) #set($personalLevel = 2) #end
                #if($configuredGroups.get('commonReadGroups').contains($settingGroup)) #set($commonLevel = 1) #end
                #if($configuredGroups.get('commonWriteGroups').contains($settingGroup)) #set($commonLevel = 2) #set($personalLevel = 2) #end
                #set($settingReference = $services.model.resolveDocument($settingGroup))
                #set($settingMissing = false)
                #if(!$settingReference.equals($guestReference) && !$settingReference.equals($allGroupReference))
                  #set($settingDoc = $xwiki.getDocument($settingReference))
                  #if(!$settingDoc || $settingDoc.isNew() || !$settingDoc.getObject('XWiki.XWikiGroups'))
                    #set($settingMissing = true) #set($personalLevel = 0) #set($commonLevel = 0)
                  #end
                #end
                <tr class="liens-permission-row">
                  <th scope="row">$escapetool.xml($settingGroup)
                    <input type="hidden" name="group_$settingIndex" value="$escapetool.xml($settingGroup)">
                    #if($settingMissing)<span class="text-warning"> (groupe introuvable)</span>#end
                  </th>
                  #foreach($kind in ['personal', 'common'])
                    #set($selectedLevel = $personalLevel)
                    #set($kindLabel = 'Personnel')
                    #if($kind == 'common') #set($selectedLevel = $commonLevel) #set($kindLabel = 'Commun') #end
                    <td><select class="form-control liens-permission-level" name="${kind}_$settingIndex" data-kind="$kind" aria-label="$kindLabel : $escapetool.xml($settingGroup)">
                    #foreach($level in [0..2])
                      #if(!$settingReference.equals($guestReference) || ($kind == 'common' && $level < 2) || $level == 0)
                        #set($selectedAttr = '')
                        #if($level == $selectedLevel) #set($selectedAttr = ' selected') #end
                        <option value="$level"$selectedAttr>$levelLabels.get($level)</option>
                      #end
                    #end
                    </select></td>
                  #end
                </tr>
              #end
              </tbody>
            </table>
          </div>
          <p class="liens-settings-feedback text-danger" role="alert" aria-live="polite"></p>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-default" data-dismiss="modal">Annuler</button>
          <button type="submit" class="btn btn-primary">Enregistrer les autorisations</button>
        </div>
      </form>
    </div>
  </div>
</div>
