      <span id="pageIndicator2" style="font-weight: bold; min-width: 80px; text-align: center;">Page 1 / 1</span>
      <button type="button" id="btnNextPage2" class="btn btn-default btn-sm" onclick="navigatePage2(1);" style="padding: 5px 10px;">
