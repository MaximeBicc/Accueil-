                          #if($editingOwnerReference.equals($linkAuthor.documentReference))
                            #set($editingOwnerId = $linkAuthor.id) #set($listedOwner = true)
                          #end
                        #end
                      #end
                      #if(!$listedOwner)
                      <option value="$escapetool.xml($!proprietaireValue)" data-author-invalid="true" selected>$escapetool.html($!displayProprietaire) (auteur non autorisé)</option>
                      #end
                      #foreach($linkAuthor in $linkAuthors)
                        #set($authorSelected = '')
                        #if($editingOwnerId == $linkAuthor.id) #set($authorSelected = ' selected') #end
                        <option value="$escapetool.xml($linkAuthor.id)"$authorSelected>$escapetool.html($linkAuthor.label) ($escapetool.html($linkAuthor.id))</option>
                      #end
                    </select>
                  </div>
                </td>

                <td class="col-type secondary-type">
                  <span class="view-mode">$escapetool.xml($!typeValue)</span>
                  <select class="form-control edit-mode edit-type-input" style="display:none;" required>
                    <option value="$escapetool.xml($!typeValue)" selected>$escapetool.xml($!typeValue)</option>
                    #if ($!typeValue == "personnel")
                      #set($typeValue = "commun")
                    #else
                      #set($typeValue = "personnel")
                    #end

                    #if ($canWriteCommon)
                      <option value="$typeValue" name="type">$typeValue</option>
                    #else
                      <option value="$typeValue" name="type" disabled>$typeValue (écriture non autorisée)</option>
                    #end
                  </select>
                </td>

                #if($canWriteCommon)
                <td class="liens-actions">
                  <div class="view-buttons">
                    <button type="button" class="btn btn-xs btn-primary custom-action-btn" onclick="toggleEditMode2(this, true);">
                      $services.icon.renderHTML('pencil')
                    </button>
                    <button type="button" class="btn btn-xs btn-danger custom-action-btn" onclick="openDeleteModal2(this);">
                      $services.icon.renderHTML('trash')
                    </button>
                  </div>
                  <div class="edit-buttons" style="display:none; gap: 5px;">
                    <button type="button" class="btn btn-xs btn-success" onclick="saveRowEdition2(this);">
                      $services.icon.renderHTML('check') Enregistrer
                    </button>
                    <button type="button" class="btn btn-xs btn-default" onclick="toggleEditMode2(this, false);">
                      $services.icon.renderHTML('cross')
                    </button>
                  </div>
                </td>
                #end
              </tr>
            #end
          #end
        #end
      </tbody>
    </table>
  </div>
</div>

#end
  </div>
</div>

