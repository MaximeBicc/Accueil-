{{html}}
#set($classPath = 'TestPage.PAGE.Liens.CODE.lienClass.WebHome')
#set($dataSpace = 'TestPage.PAGE.Liens.DATA.LIENDATA')

## Appel des extensions de peau (Skin Extensions) JavaScript et CSS
$xwiki.jsx.use("TestPage.PAGE.Liens.CODE.GlossaireExtension")
$xwiki.ssx.use("TestPage.PAGE.Liens.CODE.GlossaireExtension")

#set($discard = $xwiki.jsx.use('uicomponents/suggest/xwiki-selectize.js'))

#set($user = $xcontext.user)
#set($userDoc = $xwiki.getDocument($user))
#set($userId = $userDoc.name)

#if("$!request.action" == "checkAndCreate" && $request.acronyme && $request.libelle && $request.type && $request.definition)
  #set($acronymeInput = $request.acronyme.trim())
  #set($libelleInput = $request.libelle.trim())
  #set($definitionInput = $request.definition.trim())
  #set($typeInput = $request.type.trim())

  ## 1. Génération du nom technique de base
  #set($cleanName = $xwiki.clearName($acronymeInput))
  #set($newPageRef = "${dataSpace}.${userId}.${cleanName}")
  #set($newPage = $xwiki.getDocument($newPageRef))

  ## 2. Détection de doublon à des fins d'information (sans bloquer)
  #set($alreadyExists = false)
  #if(!$newPage.isNew())
    #set($alreadyExists = true)
  #end

  ## 3. Boucle de sécurité pour trouver un nom de page disponible (ex: API_1, API_2)
  #set($counter = 1)
  #set($basePageRef = $newPageRef)
  #foreach($i in [1..100])
    #if(!$newPage.isNew())
      #set($newPageRef = "${basePageRef}_${counter}")
      #set($newPage = $xwiki.getDocument($newPageRef))
      #set($counter = $counter + 1)
    #else
      #break
    #end
  #end

  ## 4. Création et population de l'objet
  #set($newObj = $newPage.newObject($classPath))
  #set($discard = $newObj.set('nom_lien', $acronymeInput))
  #set($discard = $newObj.set('lien', $libelleInput))
  #set($discard = $newObj.set('definition', $definitionInput))
  #set($discard = $newObj.set('type', $typeInput))
  #set($discard = $newObj.set('proprietaire', $userId))
  #set($discard = $newPage.save("Ajout via interface Glossaire", true))

  ## 5. Stockage du statut en session pour l'affichage après redirection
  #if($alreadyExists)
    $request.session.setAttribute('liens_status', 'warning')
  #else
    $request.session.setAttribute('liens_status', 'success')
  #end
  $request.session.setAttribute('liens_msg', $acronymeInput)
  $request.session.setAttribute('liens_url', $newPage.getURL())

  ## Redirection et arrêt immédiat du script courant pour forcer le rafraîchissement propre
  $response.sendRedirect($doc.getURL())
  #stop
#end


## --- 1. AFFICHAGE DES NOTIFICATIONS (POST-REDIRECTION) ---
#set($status = $request.session.getAttribute('liens_status'))
#if($status)
  #set($msg = $request.session.getAttribute('liens_msg'))
  #set($url = $request.session.getAttribute('liens_url'))

  #if($status == 'success')
    <div class="alert alert-success" style="margin-bottom: 20px;">
      <strong>Succès !</strong> Le terme <strong>$msg</strong> a été ajouté à la base de données.
      <a href="$url" target="_blank" class="btn btn-xs btn-default" style="margin-left: 10px;">Ouvrir la fiche</a>
    </div>
  #elseif($status == 'warning')
    <div class="alert alert-warning" style="margin-bottom: 20px;">
      <strong>Information :</strong> L'acronyme <strong>$msg</strong> existait déjà. Une nouvelle fiche distincte a tout de même été créée avec succès.
      <a href="$url" target="_blank" class="btn btn-xs btn-default" style="margin-left: 10px;">Ouvrir la nouvelle fiche</a>
    </div>
  #end

  $request.session.removeAttribute('liens_status')
  $request.session.removeAttribute('liens_msg')
  $request.session.removeAttribute('liens_url')
#end


## --- CODE VELOCITY INITIAL ---
## Remplacez 'XWiki.MonGroupeAutorise' par le nom technique exact de votre groupe XWiki
